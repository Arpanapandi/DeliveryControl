@model DeliveryControl.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-pencil-square"></i> Edit User</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">User</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> Form Edit User</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Masukkan username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Masukkan nama lengkap" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i>
                        <strong>Password:</strong> Kosongkan jika tidak ingin mengubah password. Isi jika ingin mengubah password.
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password Baru (Opsional)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Kosongkan jika tidak ingin mengubah" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Konfirmasi Password Baru</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Konfirmasi password baru" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <select asp-for="Role" class="form-select" asp-items="ViewBag.Roles">
                                <option value="">-- Pilih Role --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">
                                Status Aktif
                            </label>
                        </div>
                    </div>

                    <div class="card bg-dark bg-opacity-10 border-info border-opacity-25 mt-4">
                        <div class="card-header bg-info bg-opacity-10 border-info border-opacity-25">
                            <h6 class="mb-0 text-info fw-bold"><i class="bi bi-key-fill me-2"></i> Akses Dock (Preparation Workflow)</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Tentukan dock mana saja yang dapat diakses/dilihat oleh user ini di halaman Preparation.</p>
                            <div class="mb-3">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                                    <input type="text" id="dockSearch" class="form-control bg-dark text-white border-secondary" placeholder="Cari Dock, Customer, atau Cycle...">
                                </div>
                            </div>
                            
                            <div class="border rounded border-secondary bg-dark bg-opacity-25" id="dockContainer" style="max-height: 350px; overflow-y: auto;">
                                <div class="list-group list-group-flush">
                                    @foreach (var dock in (IEnumerable<DeliveryControl.Models.Dock>)ViewBag.AllDocks)
                                    {
                                        var isChecked = ((IEnumerable<int>)ViewBag.UserDockIds).Contains(dock.DockId);
                                        <label class="list-group-item list-group-item-action bg-transparent border-secondary py-1 dock-item" style="cursor: pointer;">
                                            <div class="form-check d-flex align-items-center gap-2 mb-0">
                                                <input class="form-check-input mt-0" type="checkbox" name="selectedDockIds" value="@dock.DockId" id="dock_@dock.DockId" @(isChecked ? "checked" : "")>
                                                <div class="d-flex align-items-center flex-grow-1">
                                                    <div>
                                                        <span class="fw-bold text-info" style="font-size: 0.85rem;">@dock.DockCode</span>
                                                        <span class="text-white-50 ms-2" style="font-size: 0.7rem;">@dock.Customer?.CustomerName</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(dock.Customer?.Cycle))
                                                    {
                                                        <span class="badge bg-warning text-dark ms-auto" style="font-size: 0.65rem;">@dock.Customer.Cycle</span>
                                                    }
                                                </div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Batal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informasi</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Perhatian:</strong> Password hanya akan diupdate jika diisi.
                </div>
                <p class="small text-muted">
                    Jika tidak ingin mengubah password, biarkan field password kosong.
                </p>
                <hr class="my-3" />
                <a asp-action="Index" class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-arrow-left"></i> Kembali ke Daftar
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            $('#dockSearch').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#dockContainer .dock-item").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}

