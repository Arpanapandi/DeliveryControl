@model DeliveryControl.Models.ItemMapping

@{
    ViewData["Title"] = "Tambah Mapping Baru";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-plus-circle"></i> Tambah Mapping Baru</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Item Mapping</a></li>
                <li class="breadcrumb-item active">Tambah</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Form Mapping</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Customer" class="form-label fw-bold">Kode Customer</label>
                        <input asp-for="Customer" class="form-control" placeholder="Contoh: TOYOTA" />
                        <span asp-validation-for="Customer" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerPartNumber" class="form-label fw-bold">Part No (External)</label>
                        <input asp-for="CustomerPartNumber" class="form-control" placeholder="Contoh: PART-12345" />
                        <span asp-validation-for="CustomerPartNumber" class="text-danger"></span>
                        <div class="form-text">Kode part yang digunakan oleh Customer di dalam Excel Jadwal.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VIN" class="form-label fw-bold">VIN (Internal)</label>
                        <input asp-for="VIN" class="form-control" placeholder="Contoh: VIN-009988" />
                        <span asp-validation-for="VIN" class="text-danger"></span>
                        <div class="form-text">Kode internal sistem (Tag) yang akan digunakan saat proses picking/packing.</div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill">Batal</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Simpan Mapping</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card bg-light border-0">
            <div class="card-body">
                <h5><i class="bi bi-info-circle"></i> Mengapa Mapping ini Penting?</h5>
                <p class="text-muted">
                    Sistem menggunakan tabel ini sebagai kamus untuk menerjemahkan data dari Excel Jadwal Luar (Customer) ke dalam bahasa sistem internal kita.
                </p>
                <ul class="text-muted">
                    <li><strong>Part No:</strong> Harus sama dengan yang tertulis di Excel Jadwal.</li>
                    <li><strong>VIN:</strong> Harus sesuai dengan Tag fisik barang yang ada di gudang.</li>
                    <li><strong>Customer:</strong> Sebagai filter agar kode yang sama antar customer tidak tertukar.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
