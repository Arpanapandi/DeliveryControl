@model IEnumerable<DeliveryControl.Models.DeliverySchedule>

@foreach (var item in Model)
{
    // Calculate actual range
    var actualRange = "";
    if (item.ActualStartTime.HasValue && item.ActualEndTime.HasValue)
    {
        var duration = item.ActualEndTime.Value - item.ActualStartTime.Value;
        actualRange = duration.TotalHours >= 1 
            ? $"{(int)duration.TotalHours}j {duration.Minutes}m"
            : $"{(int)duration.TotalMinutes}m";
    }

    // Check if late for enter dock
    var isEnterDockLate = false;
    var enterDockDelayMinutes = 0;
    var isEnterDockEarly = false;
    var enterDockEarlyMinutes = 0;
    var estimatedDockTime = item.EnterDockTime?.AddMinutes(15);
    var actualEstimatedDockTime = item.ActualEnterDockTime?.AddMinutes(15);
    if (item.ActualEnterDockTime.HasValue && item.EnterDockTime.HasValue)
    {
        var delay = item.ActualEnterDockTime.Value - item.EnterDockTime.Value;
        if (delay.TotalMinutes > 0)
        {
            isEnterDockLate = true;
            enterDockDelayMinutes = (int)delay.TotalMinutes;
        }
        else if (delay.TotalMinutes < 0)
        {
            isEnterDockEarly = true;
            enterDockEarlyMinutes = (int)Math.Abs(delay.TotalMinutes);
        }
    }

    // Check if late for pickup
    var isPickupLate = false;
    var pickupDelayMinutes = 0;
    if (item.ActualStartTime.HasValue && item.PickupTime.HasValue)
    {
        var delay = item.ActualStartTime.Value - item.PickupTime.Value;
        if (delay.TotalMinutes > 0)
        {
            isPickupLate = true;
            pickupDelayMinutes = (int)delay.TotalMinutes;
        }
    }

    // Check if late for delivery (ETD)
    var isDeliveryLate = false;
    var deliveryDelayMinutes = 0;
    if (item.ActualEndTime.HasValue && item.ETD.HasValue)
    {
        var delay = item.ActualEndTime.Value - item.ETD.Value;
        if (delay.TotalMinutes > 0)
        {
            isDeliveryLate = true;
            deliveryDelayMinutes = (int)delay.TotalMinutes;
        }
    }

    <tr>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <td class="text-center align-middle">
                <input type="checkbox" class="form-check-input row-checkbox" value="@item.ScheduleId">
            </td>
        }
        <td class="text-center align-middle">
            <small><strong>@item.ScheduleNumber</strong></small>
        </td>
        <td class="text-center align-middle">
            <div class="fw-bold">@item.Customer.CustomerCode</div>
        </td>
        <td class="text-center align-middle">
            <small>@(item.Route ?? "-")</small>
        </td>
        <td class="text-center align-middle">
            <small>@(item.Cycle ?? "-")</small>
        </td>
        <td class="text-center align-middle">
            @{
                double kbnTarget = 0;
                double kbnActual = 0;
                if (item.DeliveryItems != null)
                {
                    foreach(var di in item.DeliveryItems)
                    {
                        var qpc = di.Item?.QtyLot ?? 1;
                        if (qpc > 0)
                        {
                            kbnTarget += Math.Ceiling((double)di.Quantity / qpc);
                            kbnActual += (double)(di.ActualQuantity ?? 0) / qpc;
                        }
                    }
                }
            }
            <div class="@(item.TotalActualQuantity >= item.TotalTargetQuantity && item.TotalTargetQuantity > 0 ? "text-success" : (item.TotalActualQuantity > 0 ? "text-warning" : "")) fw-bold">
                @kbnActual.ToString("0.##")/@kbnTarget.ToString("0.##")
            </div>
        </td>
        <td class="text-center align-middle">
            @if (item.EnterDockTime.HasValue)
            {
                <strong>@item.EnterDockTime.Value.ToString("HH:mm")</strong>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (estimatedDockTime.HasValue)
            {
                <strong>@estimatedDockTime.Value.ToString("HH:mm")</strong>
                <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
            }
            else if (item.EnterDockTime.HasValue)
            {
                <div>
                    <strong>@item.EnterDockTime.Value.AddMinutes(15).ToString("HH:mm")</strong>
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (item.ActualEnterDockTime.HasValue)
            {
                <div>
                    <strong class="@(isEnterDockLate ? "text-danger" : (isEnterDockEarly ? "text-success" : "text-success"))">
                        @item.ActualEnterDockTime.Value.ToString("HH:mm")
                    </strong>
                </div>
                @if (isEnterDockLate)
                {
                    <small class="text-danger d-block">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Terlambat +@enterDockDelayMinutes m</strong>
                    </small>
                }
                else if (isEnterDockEarly)
                {
                    <small class="text-success d-block">
                        <i class="bi bi-check-circle-fill"></i> On Time -@enterDockEarlyMinutes m
                    </small>
                }
                else
                {
                    <small class="text-success d-block">
                        <i class="bi bi-check-circle-fill"></i> On Time
                    </small>
                }
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (actualEstimatedDockTime.HasValue)
            {
                <strong>@actualEstimatedDockTime.Value.ToString("HH:mm")</strong>
                <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
            }
            else if (item.ActualEnterDockTime.HasValue)
            {
                <div>
                    <strong>@item.ActualEnterDockTime.Value.AddMinutes(15).ToString("HH:mm")</strong>
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (item.PickupTime.HasValue)
            {
                <strong>@item.PickupTime.Value.ToString("HH:mm")</strong>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (item.ActualStartTime.HasValue)
            {
                <div>
                    <strong class="@(isPickupLate ? "text-danger" : "text-success")">
                        @item.ActualStartTime.Value.ToString("HH:mm")
                    </strong>
                </div>
                @if (isPickupLate)
                {
                    <small class="text-danger d-block">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Terlambat +@pickupDelayMinutes m</strong>
                    </small>
                }
                else
                {
                    <small class="text-success d-block">
                        <i class="bi bi-check-circle-fill"></i> On Time
                    </small>
                }
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (item.ETD.HasValue)
            {
                <strong>@item.ETD.Value.ToString("HH:mm")</strong>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            @if (item.ActualEndTime.HasValue)
            {
                <div>
                    <strong class="@(isDeliveryLate ? "text-danger" : "text-success")">
                        @item.ActualEndTime.Value.ToString("HH:mm")
                    </strong>
                </div>
                @if (isDeliveryLate)
                {
                    <small class="text-danger d-block">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Terlambat +@deliveryDelayMinutes m</strong>
                    </small>
                }
                else
                {
                    <small class="text-success d-block">
                        <i class="bi bi-check-circle-fill"></i> On Time
                    </small>
                }
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            <small>@(item.Range ?? "-")</small>
        </td>
        <td class="text-center align-middle">
            @if (!string.IsNullOrWhiteSpace(actualRange))
            {
                <strong class="text-primary">@actualRange</strong>
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
        <td class="text-center align-middle">
            <div class="btn-group-vertical btn-group-sm" role="group">
                <a asp-action="Details" asp-route-id="@item.ScheduleId" class="btn btn-info btn-sm px-2 py-1" title="Detail" style="font-size: 0.75rem;">
                    <i class="bi bi-eye"></i>
                </a>
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="btn btn-warning btn-sm px-2 py-1" title="Edit" style="font-size: 0.75rem;">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="btn btn-danger btn-sm px-2 py-1" title="Hapus" style="font-size: 0.75rem;">
                        <i class="bi bi-trash"></i>
                    </a>
                }
            </div>
        </td>
    </tr>
}
