@model DeliveryControl.Models.DeliverySchedule

@{
    ViewData["Title"] = "Detail Jadwal Delivery";
    var statusClass = Model.Status switch
    {
        "Scheduled" => "badge bg-secondary",
        "In Progress" => "badge bg-warning text-dark",
        "Completed" => "badge bg-success",
        "Cancelled" => "badge bg-danger",
        "Delayed" => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="bi bi-calendar-check"></i> Detail Jadwal Delivery</h2>
    </div>
    <div class="col-md-4 text-end">
        @if (Model.Status == "Scheduled")
        {
            <a asp-action="Edit" asp-route-id="@Model.ScheduleId" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="StartDelivery" asp-route-id="@Model.ScheduleId" class="btn btn-success"
               onclick="return confirm('Mulai delivery sekarang?')">
                <i class="bi bi-play-fill"></i> Mulai Delivery
            </a>
        }
        @if (Model.Status == "In Progress")
        {
            <a asp-action="CompleteDelivery" asp-route-id="@Model.ScheduleId" class="btn btn-primary"
               onclick="return confirm('Tandai delivery sebagai selesai?')">
                <i class="bi bi-check-circle"></i> Selesaikan Delivery
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Kembali
        </a>
    </div>
</div>

<!-- Schedule Information -->
<div class="row mb-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Informasi Schedule</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-4"><strong>No. Schedule:</strong></div>
                    <div class="col-md-8">@Model.ScheduleNumber</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Customer:</strong></div>
                    <div class="col-md-8">@Model.Customer.CustomerName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Tanggal:</strong></div>
                    <div class="col-md-8">@Model.ScheduledDate.ToString("dddd, dd MMMM yyyy")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Pickup Time:</strong></div>
                    <div class="col-md-8">
                        @if (Model.PickupTime.HasValue)
                        {
                            @Model.PickupTime.Value.ToString("HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>ETD:</strong></div>
                    <div class="col-md-8">
                        @if (Model.ETD.HasValue)
                        {
                            @Model.ETD.Value.ToString("HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Route:</strong></div>
                    <div class="col-md-8">@(Model.Route ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Cycle:</strong></div>
                    <div class="col-md-8">@(Model.Cycle ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Range:</strong></div>
                    <div class="col-md-8">@(Model.Range ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>SKID:</strong></div>
                    <div class="col-md-8">@(Model.SKID?.ToString() ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Area:</strong></div>
                    <div class="col-md-8">@(Model.Area ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Waktu Actual:</strong></div>
                    <div class="col-md-8">
                        @if (Model.ActualStartTime.HasValue)
                        {
                            <span>@Model.ActualStartTime.Value.ToString("HH:mm")</span>
                            @if (Model.ActualEndTime.HasValue)
                            {
                                <span> - @Model.ActualEndTime.Value.ToString("HH:mm")</span>
                            }
                            @if (Model.DelayStatus == "Late" && Model.DelayDuration.HasValue)
                            {
                                <br />
                                <span class="badge bg-danger">
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    Terlambat @Model.DelayDuration.Value.TotalMinutes.ToString("0") menit
                                </span>
                            }
                            else if (Model.DelayStatus == "On Time")
                            {
                                <br />
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> On Time
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Belum dimulai</span>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Status:</strong></div>
                    <div class="col-md-8"><span class="@statusClass">@Model.Status</span></div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Nomor Kendaraan:</strong></div>
                    <div class="col-md-8">@(Model.VehicleNumber ?? "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Driver:</strong></div>
                    <div class="col-md-8">
                        @(Model.DriverName ?? "-")
                        @if (!string.IsNullOrEmpty(Model.DriverPhone))
                        {
                            <br /><small class="text-muted">Telp: @Model.DriverPhone</small>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Catatan:</strong></div>
                        <div class="col-md-8">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Informasi Tambahan</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <strong>Dibuat:</strong><br />
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")<br />
                    <small class="text-muted">oleh: @(Model.CreatedBy ?? "System")</small>
                </div>
                @if (Model.UpdatedDate.HasValue)
                {
                    <div class="mb-2">
                        <strong>Diupdate:</strong><br />
                        @Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")<br />
                        <small class="text-muted">oleh: @(Model.UpdatedBy ?? "System")</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delivery Items -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-box"></i> Item Delivery</h5>
                <a asp-controller="DeliveryItems" asp-action="Create" asp-route-scheduleId="@Model.ScheduleId" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Tambah Item
                </a>
            </div>
            <div class="card-body">
                @if (Model.DeliveryItems != null && Model.DeliveryItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Quantity Plan</th>
                                    <th>Quantity Actual</th>
                                    <th>Variance</th>
                                    <th>Unit</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DeliveryItems)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Item.ItemName</strong><br />
                                            <small class="text-muted">@item.Item.ItemCode</small>
                                        </td>
                                        <td>@item.Quantity.ToString("N2")</td>
                                        <td>@(item.ActualQuantity?.ToString("N2") ?? "-")</td>
                                        <td>
                                            @if (item.VarianceQuantity.HasValue)
                                            {
                                                var varianceClass = item.VarianceQuantity.Value >= 0 ? "text-success" : "text-danger";
                                                <span class="@varianceClass">@item.VarianceQuantity.Value.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@item.Unit</td>
                                        <td>
                                            @if (item.IsCompleted)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="DeliveryItems" asp-action="Edit" asp-route-id="@item.DeliveryItemId" 
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Belum ada item delivery yang ditambahkan.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

