@model DeliveryControl.Models.ViewModels.GanttChartViewModel

@{
    ViewData["Title"] = "Gantt Chart - Jadwal Delivery";
    var startDate = ViewData["StartDate"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var endDate = ViewData["EndDate"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="mb-1"><i class="bi bi-bar-chart-line"></i> Visualisasi Jadwal Shipping Delivery</h2>
        <p class="text-muted mb-0">Timeline visual untuk monitoring jadwal delivery</p>
    </div>
    <div class="col-md-4 text-end d-flex gap-2 justify-content-end align-items-center mt-2 mt-md-0">
        <div id="signalr-status-gantt" class="realtime-status-badge status-connecting">
            <div class="status-pulse"></div>
            <i class="bi bi-circle-fill status-icon"></i>
            <span class="status-text">Connecting...</span>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-table"></i> Tampilan Tabel
        </a>
    </div>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="GanttChart" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-calendar"></i> Tanggal Mulai</label>
                <input type="date" class="form-control" name="startDate" value="@startDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-calendar"></i> Tanggal Selesai</label>
                <input type="date" class="form-control" name="endDate" value="@endDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-building"></i> Customer</label>
                <select class="form-select" name="customerId">
                    <option value="">-- Semua Customer --</option>
                    @foreach (var item in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewData["CustomerId"]?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Filter Reset Button -->
<div class="row mb-3" id="filterResetRow" style="display: none;">
    <div class="col-12 text-end">
        <button class="btn btn-outline-light btn-sm" onclick="resetDockFilter()">
            <i class="bi bi-arrow-clockwise"></i> Reset Filter
        </button>
    </div>
</div>

<!-- Gantt Chart Container -->
@if (!Model.Rows.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Tidak ada customer aktif yang ditemukan. Tambahkan customer terlebih dahulu.
    </div>
}
else
{
    <div class="cyber-card gantt-main-card" id="ganttContainer">
        <div class="card-header gantt-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-line-fill" style="color: #60a5fa;"></i>
                <span style="color: #60a5fa; font-weight: 700;">Timeline Shipping Delivery</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-dark border border-primary text-light" style="font-size:0.8rem;">
                    <i class="bi bi-calendar-event"></i>
                    <span class="ms-1">
                        @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
                    </span>
                </span>
                <span class="badge bg-primary border border-primary text-light" style="font-size:0.85rem;">
                    <i class="bi bi-clock-fill"></i>
                    <span class="ms-1" id="ganttCurrentTime">00:00:00</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-light" id="ganttAutoScrollToggle" title="Toggle Auto Scroll">
                    <i class="bi bi-arrow-down-up" id="ganttAutoScrollIcon"></i>
                    <span id="ganttAutoScrollText">Auto Scroll: ON</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" id="ganttDockFilterBtn" title="Filter Dock" data-bs-toggle="modal" data-bs-target="#dockFilterModal">
                    <i class="bi bi-funnel-fill"></i> Filter Dock
                </button>
                <button type="button" class="btn btn-sm btn-outline-light gantt-fullscreen-btn ms-lg-2" id="ganttFullscreenToggle">
                    <i class="bi bi-arrows-fullscreen" id="ganttFullscreenIcon"></i> Full Screen
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @{
                // =====================================================================
                // LAYOUT TIMELINE:
                //   H-1   : kemarin 18:00–24:00 → col 0–5   (6 jam)   — hanya untuk data delay
                //   H     : hari ini  00:00–24:00 → col 6–29 (24 jam)  — UTAMA
                //   H+1   : besok    00:00–12:00 → col 30–41 (12 jam)
                // Total 42 jam × 40px = 1680px
                // =====================================================================
                const int colPx = 40;
                const int totalCols = 42;
                const int timelineMinPx = colPx * totalCols; // 1680px
                const int custColPx = 150;
                const int remColPx  = 90;
            }
            <div id="ganttChart" style="display: flex; flex-direction: column; max-height: 82vh; overflow-y: auto; overflow-x: auto;">
                <!-- Timeline Header (Fixed) -->
                <div style="display: flex; border-bottom: 3px solid #3b82f6; position: sticky; top: 0; z-index: 100; min-width: @(custColPx + remColPx + timelineMinPx)px;">
                    <div style="width: @(custColPx)px; min-width: @(custColPx)px; background: #0f172a; padding: 8px 6px; font-weight: 700; color: #60a5fa; text-transform: uppercase; font-size: 0.75rem; border-right: 2px solid #3b82f6; box-sizing: border-box; flex-shrink: 0; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4); position: sticky; left: 0; z-index: 101;">
                        Customer / Schedule
                    </div>
                    <div style="width: @(remColPx)px; min-width: @(remColPx)px; background: #0f172a; padding: 8px 6px; font-weight: 700; color: #fbbf24; text-transform: uppercase; font-size: 0.72rem; border-right: 3px solid #3b82f6; box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; justify-content: center; text-align: center; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4); position: sticky; left: @(custColPx)px; z-index: 101;">
                        Remark Order
                    </div>
                    <div style="width: @(timelineMinPx)px; min-width: @(timelineMinPx)px; background: #0f172a; position: relative; flex-shrink: 0;">
                        @{
                            // Pixel positions berdasarkan colPx per jam (exact, tidak pakai %)
                            int h1Cols    = 6;   // H-1: col 0-5
                            int todayCols = 24;  // Today: col 6-29
                            // H+1: col 30-41
                            int h1PxStart    = 0;
                            int todayPxStart = h1Cols * colPx;
                            int h1PlusPxStart = (h1Cols + todayCols) * colPx;
                            int h1PxWidth    = h1Cols * colPx;
                            int todayPxWidth = todayCols * colPx;
                            int h1PlusPxWidth = (totalCols - h1Cols - todayCols) * colPx;
                        }
                        <!-- H-1 Header (18:00-24:00) - Gray -->
                        <div style="position: absolute; top: 0; left: @(h1PxStart)px; width: @(h1PxWidth)px; height: 20px; background: rgba(100, 116, 139, 0.3); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(148, 163, 184, 0.3);">
                            <span style="font-size: 0.7rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">H-1 (18:00-24:00)</span>
                        </div>
                        <!-- HARI INI Header (00:00-24:00) - Blue -->
                        <div style="position: absolute; top: 0; left: @(todayPxStart)px; width: @(todayPxWidth)px; height: 20px; background: rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(59, 130, 246, 0.4); border-left: 2px solid #60a5fa;">
                            <span style="font-size: 0.7rem; font-weight: 600; color: #60a5fa; text-transform: uppercase; letter-spacing: 0.5px;">HARI INI (00:00-24:00)</span>
                        </div>
                        <!-- H+1 Header (00:00-12:00) - Purple -->
                        <div style="position: absolute; top: 0; left: @(h1PlusPxStart)px; width: @(h1PlusPxWidth)px; height: 20px; background: rgba(168, 85, 247, 0.2); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(168, 85, 247, 0.4); border-left: 2px solid #a855f7;">
                            <span style="font-size: 0.7rem; font-weight: 600; color: #c084fc; text-transform: uppercase; letter-spacing: 0.5px;">H+1 (00:00-12:00)</span>
                        </div>

                        <!-- Hour labels grid — setiap jam ditampilkan -->
                        <div style="display: grid; grid-template-columns: repeat(@totalCols, @(colPx)px); height: 45px; width: @(timelineMinPx)px; padding-top: 20px;">
                            @for (int i = 0; i < totalCols; i++)
                            {
                                int actualHour;
                                string zone;
                                if (i < 6) { actualHour = i + 18; zone = "h1"; }
                                else if (i < 30) { actualHour = i - 6; zone = "today"; }
                                else { actualHour = i - 30; zone = "h1plus"; }

                                var isMidnightToday  = zone == "today"  && actualHour == 0;
                                var isMidnightH1plus = zone == "h1plus" && actualHour == 0;
                                var isMainHour = actualHour % 6 == 0;
                                string borderColor, borderWidth, textColor;

                                if (isMidnightToday)       { borderColor = "#60a5fa"; borderWidth = "3px"; }
                                else if (isMidnightH1plus) { borderColor = "#a855f7"; borderWidth = "3px"; }
                                else if (isMainHour && zone == "h1plus") { borderColor = "#c084fc"; borderWidth = "2px"; }
                                else if (isMainHour)       { borderColor = "#60a5fa"; borderWidth = "2px"; }
                                else                       { borderColor = "rgba(148, 163, 184, 0.25)"; borderWidth = "1px"; }

                                textColor = zone == "h1plus" ? "#c084fc" : (zone == "today" ? "#60a5fa" : "#94a3b8");

                                <div style="border-right: @borderWidth solid @borderColor;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            position: relative;
                                            overflow: visible;">
                                    <!-- Setiap jam ditampilkan — kolom cukup lebar (@(colPx)px) -->
                                    <span style="font-size: 0.62rem;
                                                 font-weight: @(isMainHour || isMidnightToday || isMidnightH1plus ? "700" : "500");
                                                 color: @textColor;
                                                 white-space: nowrap;
                                                 text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                                        @actualHour.ToString("D2"):00
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Scrollable Content -->
                <div id="ganttBody">
                    <div style="display: flex; flex-direction: column; min-width: @(custColPx + remColPx + timelineMinPx)px;">
                    <table class="table mb-0" style="table-layout: fixed; width: @(custColPx + remColPx + timelineMinPx)px; border-collapse: separate; border-spacing: 0;">
                        <tbody>
        @{
            // =====================================================================
            // Helper: konversi DateTime ke posisi pixel di timeline 42 jam
            //
            // PENTING — aturan penempatan:
            //   • Data "planned" (prepare, enterDock, pickup, ETD) selalu di hari selectedDate (H)
            //     karena startPrepMins / docking / pickup adalah jam di HARI INI bukan kemarin.
            //   • H-1 (kiri, 6 kolom) dipakai HANYA untuk data AKTUAL yang terjadi kemarin
            //     (mis. actualStartTime.Date == selectedDate-1)
            //
            // FORMULA pixel dari kiri:
            //   H-1 zone  : dt adalah kemarin & jam 18-24 → offset = (hour-18)*colPx
            //   H zone    : dt adalah hari ini             → offset = (6 + hour)*colPx  + minutes/60*colPx
            //   H+1 zone  : dt adalah besok & jam 0-12    → offset = (30 + hour)*colPx + minutes/60*colPx
            // =====================================================================
            double DateTimeToPx(DateTime dt, DateTime selDate) {
                double px;
                if (dt.Date == selDate.Date.AddDays(-1)) {
                    // Kemarin — muncul di H-1 zone (hanya jam 18-24 yang visible)
                    double h = dt.Hour + dt.Minute / 60.0;
                    double col = h - 18.0; // col 0-6
                    if (col < 0) col = 0;
                    px = col * colPx;
                } else if (dt.Date == selDate.Date) {
                    // Hari ini (H) — zone utama col 6-29
                    double h = dt.Hour + dt.Minute / 60.0;
                    px = (6.0 + h) * colPx;
                } else if (dt.Date == selDate.Date.AddDays(1)) {
                    // Besok (H+1) — zone col 30-41
                    double h = dt.Hour + dt.Minute / 60.0;
                    double col = 30.0 + h;
                    if (col > 42.0) col = 42.0;
                    px = col * colPx;
                } else if (dt < selDate.Date) {
                    // Lebih dari 1 hari lalu → clamp ke px 0
                    px = 0;
                } else {
                    // Lebih dari 1 hari ke depan → clamp ke px max
                    px = 42.0 * colPx;
                }
                return px;
            }
            double WidthInPercent42(double durationHours) {
                return durationHours * colPx; // jam → pixels
            }

            // Snap bar ke batas kolom jam jika lebar bar < 1 kolom (colPx).
            // Mengembalikan (snappedLeft, snappedWidth) agar bar mengisi kolom jam penuh.
            // Label tetap menampilkan waktu asli — hanya visual bar yang diperlebar.
            (double left, double width) SnapBarToCol(double leftPx, double widthPx) {
                if (widthPx >= colPx) return (leftPx, widthPx); // sudah ≥ 1 kolom, tidak perlu snap
                // Snap left ke batas kolom jam terdekat ke kiri
                double snappedLeft = Math.Floor(leftPx / colPx) * colPx;
                return (snappedLeft, colPx);
            }
        }

        @foreach (var row in Model.Rows)
        {
            var customer = row.Customer;
            var schedules = row.Schedules;
            int schCount = schedules.Count;
            var selectedDate = Model.SelectedDate;

            // ========================
            // Timing: prioritize from schedules, fallback to Customer master
            // ========================

            // PickupTime
            DateTime? pickupTime = null;
            DateTime? etdTime = null;
            DateTime? enterDockTime = null;
            DateTime? actualEnterDockTime = null;
            DateTime? actualStartTime = null;
            DateTime? actualEndTime = null;
            int startPrepMins = 0;
            int stdPrepMins = 0;

            if (schedules.Any())
            {
                pickupTime = schedules.Where(s => s.PickupTime.HasValue).Select(s => s.PickupTime).Min();
                etdTime = schedules.Where(s => s.ETD.HasValue).Select(s => s.ETD).Max();
                enterDockTime = schedules.Where(s => s.EnterDockTime.HasValue).Select(s => s.EnterDockTime).Min();
                actualEnterDockTime = schedules.Where(s => s.ActualEnterDockTime.HasValue).Select(s => s.ActualEnterDockTime).Min();
                actualStartTime = schedules.Where(s => s.ActualStartTime.HasValue).Select(s => s.ActualStartTime).Min();
                actualEndTime = schedules.Where(s => s.ActualEndTime.HasValue).Select(s => s.ActualEndTime).Max();
                startPrepMins = schedules.Where(s => s.StartPrepareTime > 0).Select(s => s.StartPrepareTime).DefaultIfEmpty(0).Min();
                stdPrepMins = schedules.Where(s => s.StdPrepareTime > 0).Select(s => s.StdPrepareTime).DefaultIfEmpty(0).Min();
                if (startPrepMins == 0) startPrepMins = customer.StartPrepareTime;
                if (stdPrepMins == 0) stdPrepMins = customer.StdPrepareTime;
            }
            else
            {
                // Use Customer master data — parse string times relative to selectedDate
                startPrepMins = customer.StartPrepareTime;
                stdPrepMins = customer.StdPrepareTime;
                if (!string.IsNullOrWhiteSpace(customer.Docking) && TimeSpan.TryParse(customer.Docking, out var dockTs))
                    enterDockTime = selectedDate.Date.Add(dockTs);
                if (!string.IsNullOrWhiteSpace(customer.Pickup) && TimeSpan.TryParse(customer.Pickup, out var pickupTs))
                    pickupTime = selectedDate.Date.Add(pickupTs);
                if (!string.IsNullOrWhiteSpace(customer.ETD) && TimeSpan.TryParse(customer.ETD, out var etdTs))
                    etdTime = selectedDate.Date.Add(etdTs);
            }

            var estimatedDockTime = enterDockTime?.AddMinutes(15);
            var actualEstimatedDockTime = actualEnterDockTime?.AddMinutes(15);

            // ========================
            // Status
            // ========================
            string displayStatus = "No Schedule";
            bool isLateSchedule = false;

            if (schedules.Any())
            {
                var repSchedule = schedules.First();
                displayStatus = (repSchedule.DriverStatus ?? repSchedule.Status) ?? "Scheduled";
                isLateSchedule = actualStartTime.HasValue && pickupTime.HasValue && actualStartTime.Value > pickupTime.Value;
            }
            var statusFilter = displayStatus.ToLower().Replace(" ", "");

            // ========================
            // Prepare Bar (orange)
            // ========================
            var prepareStartPercent = 0.0;
            var prepareEndPercent   = 0.0;
            DateTime? prepareStartTime = null;
            DateTime? prepareEndTime   = null;
            if (startPrepMins > 0 && stdPrepMins > 0)
            {
                // startPrepMins = menit dari 00:00 hari ini → selalu di selectedDate (H)
                // stdPrepMins   = menit dari 00:00 → END time prepare, juga di selectedDate (H)
                // Contoh: start=420 (07:00 H), end=600 (10:00 H) → bar 07:00-10:00 di H ✅
                // Contoh: start=1380 (23:00 H), end=120 (02:00 H+1) → bar 23:00 H – 02:00 H+1 ✅
                prepareStartTime = selectedDate.Date.AddMinutes(startPrepMins);

                // End time: stdPrepMins menit dari 00:00 hari ini
                // Jika end <= start → lintas tengah malam → end ada di H+1 (besok)
                prepareEndTime = selectedDate.Date.AddMinutes(stdPrepMins);
                if (prepareEndTime.Value <= prepareStartTime.Value)
                    prepareEndTime = selectedDate.Date.AddDays(1).AddMinutes(stdPrepMins);

                prepareStartPercent = DateTimeToPx(prepareStartTime.Value, selectedDate);
                prepareEndPercent   = DateTimeToPx(prepareEndTime.Value,   selectedDate);
            }

            // ========================
            // Enter Dock Bar (cyan) - Baris 2
            // ========================
            var enterDockPercent = 0.0;
            var enterDockEndPercent = 0.0;
            if (enterDockTime.HasValue && estimatedDockTime.HasValue)
            {
                enterDockPercent    = DateTimeToPx(enterDockTime.Value,    selectedDate);
                enterDockEndPercent = DateTimeToPx(estimatedDockTime.Value, selectedDate);
                if (enterDockEndPercent <= enterDockPercent)
                    enterDockEndPercent = enterDockPercent + WidthInPercent42(0.25); // min 15 menit
            }

            // ========================
            // Actual Enter Dock Bar (green/red) - Baris 3
            // ========================
            var actualEnterDockPercent = 0.0;
            var actualEnterDockEndPercent = 0.0;
            var isDockDelay = false;
            var isDockEarly = false;
            var dockDiffMinutes = 0;
            var isDockOutOfRange = false; // true jika terjadi sebelum H-1 18:00 (tidak visible di timeline)
            if (actualEnterDockTime.HasValue)
            {
                if (enterDockTime.HasValue)
                {
                    var dockDiff = actualEnterDockTime.Value - enterDockTime.Value;
                    if (dockDiff.TotalMinutes > 0) { isDockDelay = true; dockDiffMinutes = (int)dockDiff.TotalMinutes; }
                    else if (dockDiff.TotalMinutes < 0) { isDockEarly = true; dockDiffMinutes = (int)Math.Abs(dockDiff.TotalMinutes); }
                }
                // Cek apakah waktu aktual berada di luar range timeline (sebelum H-1 18:00)
                var h1StartBoundary = selectedDate.Date.AddDays(-1).AddHours(18);
                if (actualEnterDockTime.Value < h1StartBoundary)
                {
                    isDockOutOfRange = true;
                    // Clamp ke awal timeline agar bar tetap bisa dirender sebagai indikator
                    actualEnterDockPercent    = 0;
                    actualEnterDockEndPercent = colPx; // 1 kolom sebagai indikator
                }
                else
                {
                    actualEnterDockPercent = DateTimeToPx(actualEnterDockTime.Value, selectedDate);
                    if (actualEstimatedDockTime.HasValue)
                    {
                        actualEnterDockEndPercent = DateTimeToPx(actualEstimatedDockTime.Value, selectedDate);
                        if (actualEnterDockEndPercent <= actualEnterDockPercent)
                            actualEnterDockEndPercent = actualEnterDockPercent + WidthInPercent42(0.25);
                    }
                    else
                    {
                        actualEnterDockEndPercent = actualEnterDockPercent + WidthInPercent42(0.25);
                    }
                }
            }

            // ========================
            // Schedule Pickup-ETD Bar (blue) - Baris 4
            // ========================
            var pickupPercent = 0.0;
            var pickupEndPercent = 0.0;
            if (pickupTime.HasValue && etdTime.HasValue && (pickupTime.Value.Hour > 0 || pickupTime.Value.Minute > 0 || etdTime.Value.Hour > 0 || etdTime.Value.Minute > 0))
            {
                pickupPercent    = DateTimeToPx(pickupTime.Value, selectedDate);
                pickupEndPercent = DateTimeToPx(etdTime.Value,    selectedDate);
                if (pickupEndPercent <= pickupPercent)
                    pickupEndPercent = pickupPercent + WidthInPercent42(0.5); // minimal 30 menit width
            }

            // ========================
            // Actual Pickup Bar (green/red) - Baris 5
            // ========================
            var actualStartPercent = 0.0;
            var actualEndPercent = 0.0;
            if (actualStartTime.HasValue && actualEndTime.HasValue)
            {
                actualStartPercent = DateTimeToPx(actualStartTime.Value, selectedDate);
                actualEndPercent   = DateTimeToPx(actualEndTime.Value,   selectedDate);
                if (actualEndPercent <= actualStartPercent)
                    actualEndPercent = actualStartPercent + WidthInPercent42(0.5);
            }

            // ========================
            // Remark Order from Customer
            // ========================
            var remarkOrder = customer.RemarkOrder ?? "";
            var cycleStr = customer.Cycle ?? (schedules.Any() ? schedules.First().Cycle ?? "" : "");

            var dockCycleKey = customer.CustomerName + (string.IsNullOrEmpty(cycleStr) ? "" : " - " + cycleStr);

            <tr class="gantt-row" 
                data-status="@statusFilter" 
                data-late="@(isLateSchedule ? "true" : "false")"
                data-has-schedule="@(row.HasSchedule ? "true" : "false")"
                data-dock-name="@customer.CustomerName"
                data-dock-cycle="@dockCycleKey"
                data-dock-id="@customer.CustomerId"
                style="display: flex; border-bottom: 1px solid rgba(59, 130, 246, 0.2);">
                <!-- Customer Info Cell (left panel) -->
                <td class="gantt-customer-cell" style="width: @(custColPx)px; min-width: @(custColPx)px; flex-shrink: 0; background: linear-gradient(135deg, #1e293b 0%, #334155 100%); box-shadow: 3px 0 15px rgba(0,0,0,0.3); border-right: 2px solid @(row.HasSchedule ? "#3b82f6" : "#475569"); padding: 6px 8px; box-sizing: border-box; border-bottom: none; position: sticky; left: 0; z-index: 3;">
                    <div class="customer-info-gantt d-flex flex-column justify-content-center" style="height: 100%;">
                        <!-- Row 1: Dock Name + Customer Code -->
                        <div class="d-flex align-items-center mb-1">
                            <div class="flex-grow-1" style="min-width: 0; overflow: hidden;">
                                <div style="font-weight: 700; color: @(row.HasSchedule ? "#60a5fa" : "#94a3b8"); font-size: 0.78rem; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@customer.CustomerName">
                                    @customer.CustomerName
                                </div>
                                <div style="font-size: 0.65rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @customer.CustomerCode
                                </div>
                            </div>
                        </div>
                        <!-- Row 2: Cycle + Schedules count + Pickup time -->
                        <div class="d-flex align-items-center justify-content-between">
                            <small style="color: #94a3b8; font-size: 0.65rem;">
                                @if (!string.IsNullOrEmpty(cycleStr)) {
                                    <span><i class="bi bi-arrow-repeat" style="font-size: 0.55rem;"></i> @cycleStr</span>
                                }
                                @if (schCount > 0) {
                                    <span class="badge bg-primary ms-1" style="font-size: 0.55rem;">@schCount</span>
                                }
                            </small>
                            @if (pickupTime.HasValue && (pickupTime.Value.Hour > 0 || pickupTime.Value.Minute > 0))
                            {
                                <small style="color: #fbbf24; font-size: 0.65rem; font-weight: 600;">
                                    <i class="bi bi-clock-fill" style="font-size: 0.55rem;"></i> @pickupTime.Value.ToString("HH:mm")
                                </small>
                            }
                        </div>
                    </div>
                </td>

                <!-- Remark Order Column -->
                <td style="width: @(remColPx)px; min-width: @(remColPx)px; flex-shrink: 0; background: @(row.HasSchedule ? "#1a2636" : "#151e2d"); border-right: 3px solid @(row.HasSchedule ? "#3b82f6" : "#475569"); padding: 6px 5px; box-sizing: border-box; border-bottom: none; display: flex; align-items: center; justify-content: center; position: sticky; left: @(custColPx)px; z-index: 3;">
                    @if (row.HasSchedule)
                    {
                        @if (!string.IsNullOrWhiteSpace(remarkOrder))
                        {
                            <div style="font-size: 0.65rem; color: #34d399; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.25); border-radius: 4px; padding: 3px 6px; text-align: center; word-break: break-word; line-height: 1.3;" title="@remarkOrder">
                                @remarkOrder
                            </div>
                        }
                        else
                        {
                            <!-- Jadwal diupload, tidak ada remark → kosong -->
                            <div style="font-size: 0.6rem; color: #475569; font-style: italic; text-align: center;">—</div>
                        }
                    }
                    else
                    {
                        <div style="font-size: 0.63rem; color: #f87171; font-weight: 600; text-align: center; background: rgba(248, 113, 113, 0.08); border: 1px solid rgba(248, 113, 113, 0.2); border-radius: 4px; padding: 3px 6px; line-height: 1.3;">
                            Not Yet Release
                        </div>
                    }
                </td>

                <!-- Timeline Cell -->
                <td class="gantt-timeline-cell" style="width: @(timelineMinPx)px; min-width: @(timelineMinPx)px; flex-shrink: 0; position: relative; height: 148px; padding: 0; background: @(row.HasSchedule ? "#1e293b" : "#172032"); border-bottom: none;">
                    <!-- Background grid (42 fixed-width columns) -->
                    <div style="position: absolute; top: 0; left: 0; width: @(timelineMinPx)px; height: 100%; display: grid; grid-template-columns: repeat(@totalCols, @(colPx)px); z-index: 0; pointer-events: none;">
                        @for (int i = 0; i < totalCols; i++)
                        {
                            int gh;
                            string gz;
                            if (i < 6) { gh = i + 18; gz = "h1"; }
                            else if (i < 30) { gh = i - 6; gz = "today"; }
                            else { gh = i - 30; gz = "h1plus"; }

                            bool gMidToday  = gz == "today"  && gh == 0;
                            bool gMidH1plus = gz == "h1plus" && gh == 0;
                            bool gMain = gh % 6 == 0;
                            bool g2h   = gh % 2 == 0;
                            bool gWork = gz == "today" && gh >= 8 && gh <= 17;

                            string gBg    = gWork ? "rgba(59, 130, 246, 0.06)" : (gz == "h1plus" ? "rgba(168,85,247,0.04)" : "transparent");
                            string gBord, gBordW;
                            if (gMidToday)       { gBord = "#60a5fa"; gBordW = "3px"; }
                            else if (gMidH1plus) { gBord = "#a855f7"; gBordW = "3px"; }
                            else if (gMain && gz == "h1plus") { gBord = "rgba(168,85,247,0.5)"; gBordW = "2px"; }
                            else if (gMain)      { gBord = "#60a5fa"; gBordW = "2px"; }
                            else if (g2h)        { gBord = "rgba(96,165,250,0.25)"; gBordW = "1px"; }
                            else                 { gBord = "rgba(148,163,184,0.15)"; gBordW = "1px"; }

                            <div style="border-right: @gBordW solid @gBord; background: @gBg; height: 100%;"></div>
                        }
                    </div>

                    @if (!row.HasSchedule)
                    {
                        <!-- No-schedule subtle grid overlay (no text — already shown in customer panel) -->
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
                                    background: repeating-linear-gradient(45deg, transparent, transparent 8px, rgba(71,85,105,0.04) 8px, rgba(71,85,105,0.04) 9px);
                                    z-index: 0; pointer-events: none;">
                        </div>
                    }

                    <!-- Baris 1: Planned Prepare Bar (orange) -->
                    @if (prepareStartTime.HasValue && prepareEndPercent > prepareStartPercent)
                    {
                        var bar1W = prepareEndPercent - prepareStartPercent;
                        var bar1Label = $"{prepareStartTime.Value:HH:mm} - {prepareEndTime!.Value:HH:mm}";
                        var (bar1Left, bar1WSnap) = SnapBarToCol(prepareStartPercent, bar1W);
                        @* Bar visual — lebar di-snap ke kolom jam jika durasi pendek *@
                        <div style="position: absolute; top: 3px;
                                    left: @bar1Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: @bar1WSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    height: 20px;
                                    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
                                    border-radius: 4px; border: 2px solid #f97316;
                                    box-shadow: 0 2px 8px rgba(249,115,22,0.5);
                                    opacity: 0.9; z-index: 1; cursor: default;"
                             title="Prepare: @bar1Label"></div>
                        @* Label overlay — posisi mengikuti bar visual yang sudah di-snap *@
                        <div style="position: absolute; top: 3px;
                                    left: @bar1Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: max-content; height: 20px;
                                    display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                    z-index: 5; pointer-events: none;">
                            <i class="bi bi-boxes" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                            <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@bar1Label</span>
                        </div>
                    }

                    <!-- Baris 2: Enter Dock Bar (cyan) -->
                    @if (enterDockTime.HasValue && estimatedDockTime.HasValue && enterDockEndPercent > enterDockPercent)
                    {
                        var bar2W = enterDockEndPercent - enterDockPercent;
                        var bar2Label = $"{enterDockTime.Value:HH:mm} - {estimatedDockTime.Value:HH:mm}";
                        var (bar2Left, bar2WSnap) = SnapBarToCol(enterDockPercent, bar2W);
                        <div style="position: absolute; top: 27px;
                                    left: @bar2Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: @bar2WSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    height: 20px;
                                    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
                                    border-radius: 4px; border: 2px solid #0ea5e9;
                                    box-shadow: 0 2px 8px rgba(14,165,233,0.5);
                                    opacity: 0.9; z-index: 1; cursor: default;"
                             title="Enter Dock: @bar2Label"></div>
                        <div style="position: absolute; top: 27px;
                                    left: @bar2Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: max-content; height: 20px;
                                    display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                    z-index: 5; pointer-events: none;">
                            <i class="bi bi-door-open" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                            <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@bar2Label</span>
                        </div>
                    }

                    <!-- Baris 3: Actual Enter Dock Bar (green/red) -->
                    @if (actualEnterDockTime.HasValue && actualEnterDockEndPercent > actualEnterDockPercent)
                    {
                        var dockBarColor  = isDockDelay ? "linear-gradient(135deg, #ef4444 0%, #b91c1c 100%)" : "linear-gradient(135deg, #22c55e 0%, #15803d 100%)";
                        var dockBarBorder = isDockDelay ? "#ef4444" : "#22c55e";
                        var dockIcon      = isDockDelay ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";
                        var bar3W = actualEnterDockEndPercent - actualEnterDockPercent;
                        var bar3Label = $"{actualEnterDockTime.Value:HH:mm} - {actualEstimatedDockTime?.ToString("HH:mm") ?? "?"}";
                        var dockStatusStr = isDockDelay ? $"Delay +{dockDiffMinutes}m" : (isDockEarly ? $"Early -{dockDiffMinutes}m" : "On Time");
                        var (bar3Left, bar3WSnap) = isDockOutOfRange ? (0.0, (double)colPx) : SnapBarToCol(actualEnterDockPercent, bar3W);

                        @if (isDockOutOfRange)
                        {
                            @* Bar out-of-range: indikator di tepi kiri dengan tanda panah kiri *@
                            <div style="position: absolute; top: 51px;
                                        left: 0px; width: @(colPx)px; height: 20px;
                                        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
                                        border-radius: 0 4px 4px 0; border: 2px solid #ef4444; border-left: 3px solid #fca5a5;
                                        opacity: 0.9; z-index: 2; cursor: default;"
                                 title="Actual Enter Dock (di luar range H-1): @bar3Label — gunakan filter tanggal untuk melihat detail"></div>
                            <div style="position: absolute; top: 51px;
                                        left: 0px; width: max-content; height: 20px;
                                        display: flex; align-items: center; padding: 0 6px;
                                        z-index: 5; pointer-events: none;">
                                <i class="bi bi-chevron-double-left" style="font-size: 0.62rem; color: #fca5a5; margin-right: 3px; flex-shrink: 0;"></i>
                                <i class="bi bi-exclamation-triangle-fill" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                                <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@actualEnterDockTime.Value.ToString("dd/MM HH:mm") — filter tanggal</span>
                            </div>
                        }
                        else
                        {
                            <div style="position: absolute; top: 51px;
                                        left: @bar3Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                        width: @bar3WSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                        height: 20px;
                                        background: @dockBarColor;
                                        border-radius: 4px; border: 2px solid @dockBarBorder;
                                        opacity: 0.9; z-index: 2; cursor: default;"
                                 title="Actual Enter Dock: @bar3Label (@dockStatusStr)"></div>
                            <div style="position: absolute; top: 51px;
                                        left: @bar3Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                        width: max-content; height: 20px;
                                        display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                        z-index: 5; pointer-events: none;">
                                <i class="bi @dockIcon" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                                <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@bar3Label</span>
                            </div>
                        }
                    }

                    <!-- Baris 4: Schedule Pickup-ETD Bar (blue) -->
                    @if (pickupTime.HasValue && etdTime.HasValue && pickupEndPercent > pickupPercent)
                    {
                        var bar4W = pickupEndPercent - pickupPercent;
                        var bar4Label = $"{pickupTime.Value:HH:mm} - {etdTime.Value:HH:mm}";
                        var (bar4Left, bar4WSnap) = SnapBarToCol(pickupPercent, bar4W);
                        <div style="position: absolute; top: 75px;
                                    left: @bar4Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: @bar4WSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    height: 22px;
                                    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
                                    border-radius: 5px; border: 2px solid #0d6efd;
                                    box-shadow: 0 3px 10px rgba(13,110,253,0.6);
                                    z-index: 1; opacity: @(row.HasSchedule ? "0.95" : "0.55"); cursor: default;"
                             title="Pickup-ETD: @bar4Label"></div>
                        <div style="position: absolute; top: 75px;
                                    left: @bar4Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: max-content; height: 22px;
                                    display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                    z-index: 5; pointer-events: none; opacity: @(row.HasSchedule ? "1" : "0.6");">
                            <i class="bi bi-calendar-check" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                            <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@bar4Label</span>
                        </div>
                    }

                    <!-- Baris 5: Actual Bar (green/red/yellow) -->
                    @if (actualStartTime.HasValue && actualEndTime.HasValue && actualEndPercent > actualStartPercent)
                    {
                        var isLate = actualStartTime.Value > (pickupTime ?? actualStartTime.Value) || actualEndTime.Value > (etdTime ?? actualEndTime.Value);
                        var actGrad   = isLate ? "linear-gradient(135deg, #dc3545 0%, #b02a37 100%)" : "linear-gradient(135deg, #198754 0%, #146c43 100%)";
                        var actBorder = isLate ? "#dc3545" : "#198754";
                        var actClass  = isLate ? "gantt-bar-danger" : "gantt-bar-success";
                        var bar5W = actualEndPercent - actualStartPercent;
                        var bar5Label = $"{actualStartTime.Value:HH:mm} - {actualEndTime.Value:HH:mm}";
                        var (bar5Left, bar5WSnap) = SnapBarToCol(actualStartPercent, bar5W);
                        <div style="position: absolute; top: 101px;
                                    left: @bar5Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: @bar5WSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    height: 22px;
                                    background: @actGrad;
                                    border-radius: 5px; border: 2px solid @actBorder;
                                    z-index: 2; opacity: 0.95; cursor: default;"
                             class="gantt-bar gantt-actual @actClass"
                             title="Actual: @bar5Label"></div>
                        <div style="position: absolute; top: 101px;
                                    left: @bar5Left.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: max-content; height: 22px;
                                    display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                    z-index: 5; pointer-events: none;">
                            <i class="bi @(isLate ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" style="font-size: 0.62rem; color: white; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.7);"></i>
                            <span style="font-size: 0.62rem; color: white; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.7);">@bar5Label</span>
                        </div>
                    }
                    else if (actualStartTime.HasValue)
                    {
                        var actPct2 = DateTimeToPx(actualStartTime.Value, selectedDate);
                        var runEndTime = etdTime ?? actualStartTime.Value.AddHours(2);
                        var runEndPct = DateTimeToPx(runEndTime, selectedDate);
                        var bar5bW = runEndPct - actPct2;
                        if (bar5bW < WidthInPercent42(0.25)) bar5bW = WidthInPercent42(0.25);
                        var bar5bLabel = $"{actualStartTime.Value:HH:mm} - ...";
                        var (bar5bLeft, bar5bWSnap) = SnapBarToCol(actPct2, bar5bW);
                        <div style="position: absolute; top: 101px;
                                    left: @bar5bLeft.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: @bar5bWSnap.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    height: 22px;
                                    background: linear-gradient(135deg, #ffc107 0%, #d39e00 100%);
                                    border-radius: 5px; border: 2px solid #ffc107;
                                    z-index: 2; opacity: 0.95;
                                    animation: pulse-warning 2s ease-in-out infinite; cursor: default;"
                             class="gantt-bar gantt-inprogress"
                             title="In Progress: @bar5bLabel"></div>
                        <div style="position: absolute; top: 101px;
                                    left: @bar5bLeft.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)px;
                                    width: max-content; height: 22px;
                                    display: flex; align-items: center; justify-content: center; padding: 0 6px;
                                    z-index: 5; pointer-events: none;">
                            <i class="bi bi-arrow-right-circle-fill" style="font-size: 0.62rem; color: #212529; margin-right: 3px; flex-shrink: 0; text-shadow: 0 1px 3px rgba(255,255,255,0.5);"></i>
                            <span style="font-size: 0.62rem; color: #212529; font-weight: 700; white-space: nowrap; text-shadow: 0 1px 3px rgba(255,255,255,0.5);">@bar5bLabel</span>
                        </div>
                    }
                </td>
            </tr>
        }
                    </tbody>
                </table>
                    </div>
                </div>
            </div>
            
            <!-- Legend -->
            <div class="legend-container">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="legend-title-inline"><i class="bi bi-info-circle-fill"></i> Ket:</span>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:10px;background:#64748b;border-radius:2px;margin-right:3px;"></span>H-1 (18-24)</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:10px;background:#3b82f6;border-radius:2px;margin-right:3px;"></span>Hari Ini</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:10px;background:#a855f7;border-radius:2px;margin-right:3px;"></span>H+1</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#f97316,#ea580c);border-radius:2px;margin-right:3px;"></span>Planned Prepare</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:2px;margin-right:3px;"></span>Enter Dock</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#0d6efd,#0a58ca);border-radius:2px;margin-right:3px;"></span>Pickup-ETD</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#198754,#146c43);border-radius:2px;margin-right:3px;"></span>Actual On Time</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#dc3545,#b02a37);border-radius:2px;margin-right:3px;"></span>Late/Delay</div>
                    <div class="legend-item-simple"><span style="display:inline-block;width:10px;height:5px;background:linear-gradient(135deg,#ffc107,#d39e00);border-radius:2px;margin-right:3px;"></span>In Progress</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dock Filter Modal -->
    <div class="modal fade" id="dockFilterModal" tabindex="-1" aria-labelledby="dockFilterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="background: #1e293b; border: 1px solid #334155; color: #e2e8f0;">
                <div class="modal-header" style="border-bottom: 1px solid #334155;">
                    <h5 class="modal-title" id="dockFilterModalLabel">
                        <i class="bi bi-funnel-fill" style="color: #60a5fa;"></i> Filter Dock — Pilih Dock Yang Ditampilkan
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Search + Select All -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <input type="text" class="form-control form-control-sm" id="dockFilterSearch" placeholder="Cari dock..." 
                               style="background: #0f172a; border-color: #334155; color: #e2e8f0; max-width: 250px;">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="dockSelectAll">
                            <i class="bi bi-check-all"></i> Pilih Semua
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="dockDeselectAll">
                            <i class="bi bi-x-lg"></i> Hapus Semua
                        </button>
                        <span class="ms-auto badge bg-primary" id="dockSelectedCount">0 dipilih</span>
                    </div>
                    <!-- Dock Grid -->
                    <div id="dockFilterGrid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-height: 400px; overflow-y: auto;">
                        @foreach (var row in Model.Rows)
                        {
                            var dkName = row.Customer.CustomerName;
                            var dkCode = row.Customer.CustomerCode;
                            var dkId = row.Customer.CustomerId;
                            var dkHasSch = row.HasSchedule;
                            var dkCycle = row.Customer.Cycle ?? (row.Schedules.Any() ? row.Schedules.First().Cycle ?? "" : "");
                            var dkCycleKey = dkName + (string.IsNullOrEmpty(dkCycle) ? "" : " - " + dkCycle);
                            <label class="dock-filter-item d-flex align-items-center gap-2 p-2" 
                                   style="background: #0f172a; border: 1px solid @(dkHasSch ? "#334155" : "#1e293b"); border-radius: 6px; cursor: pointer; transition: all 0.15s;"
                                   data-dock-name="@dkCycleKey">
                                <input type="checkbox" class="form-check-input dock-filter-cb" value="@dkId" data-dock-name="@dkCycleKey" checked 
                                       style="margin: 0; flex-shrink: 0;">
                                <div style="min-width: 0; overflow: hidden;">
                                    <div style="font-size: 0.78rem; font-weight: 600; color: @(dkHasSch ? "#60a5fa" : "#94a3b8"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @dkName
                                        @if (!string.IsNullOrEmpty(dkCycle))
                                        {
                                            <span style="color: #fbbf24; font-size: 0.68rem; font-weight: 500;"> — @dkCycle</span>
                                        }
                                    </div>
                                    <div style="font-size: 0.63rem; color: #64748b;">@dkCode @(dkHasSch ? "✓" : "")</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #334155;">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-primary btn-sm" id="dockFilterApply">
                        <i class="bi bi-check-lg"></i> Terapkan Filter
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ================== JAM BERJALAN DI HEADER GANTT ==================
        (function () {
            function updateGanttTime() {
                const el = document.getElementById('ganttCurrentTime');
                if (!el) return;
                const now = new Date();
                const h = now.getHours().toString().padStart(2, '0');
                const m = now.getMinutes().toString().padStart(2, '0');
                const s = now.getSeconds().toString().padStart(2, '0');
                el.textContent = `${h}:${m}:${s}`;
            }
            updateGanttTime();
            setInterval(updateGanttTime, 1000);
        })();

        // Global filter state
        let currentGanttFilter = 'all';

        // Reset dock filter (show all)
        function resetDockFilter() {
            $('.dock-filter-cb').prop('checked', true);
            localStorage.removeItem('gantt_dock_filter');
            $('.gantt-row').show();
            $('#filterResetRow').fadeOut();
            const btn = $('#ganttDockFilterBtn');
            btn.removeClass('btn-info').addClass('btn-outline-info');
            btn.html('<i class="bi bi-funnel-fill"></i> Filter Dock');
        }

        // ============================================
        // AUTO-SCROLL VERTICAL GANTT CHART
        // ============================================
        let ganttAutoScrollInterval = null;
        let isGanttScrollingDown = true;
        let isGanttPaused = false;
        let isGanttAutoScrollEnabled = true; // Default enabled
        const ganttScrollSpeed = 1; // pixels per frame
        const ganttScrollDelay = 20; // milliseconds between scrolls
        const GANTT_STORAGE_KEY = 'gantt_autoscroll_enabled';

        // Load state from localStorage
        function loadGanttAutoScrollState() {
            const saved = localStorage.getItem(GANTT_STORAGE_KEY);
            if (saved !== null) {
                isGanttAutoScrollEnabled = saved === 'true';
            }
            updateGanttAutoScrollToggleUI();
        }

        // Update toggle button UI
        function updateGanttAutoScrollToggleUI() {
            const toggleBtn = document.getElementById('ganttAutoScrollToggle');
            const toggleIcon = document.getElementById('ganttAutoScrollIcon');
            const toggleText = document.getElementById('ganttAutoScrollText');
            
            if (toggleBtn && toggleIcon && toggleText) {
                if (isGanttAutoScrollEnabled) {
                    toggleBtn.classList.remove('btn-outline-secondary');
                    toggleBtn.classList.add('btn-outline-success');
                    toggleIcon.classList.remove('bi-pause-circle', 'bi-arrow-down-up');
                    toggleIcon.classList.add('bi-arrow-down-up');
                    toggleText.textContent = 'Auto Scroll: ON';
                } else {
                    toggleBtn.classList.remove('btn-outline-success');
                    toggleBtn.classList.add('btn-outline-secondary');
                    toggleIcon.classList.remove('bi-arrow-down-up');
                    toggleIcon.classList.add('bi-pause-circle');
                    toggleText.textContent = 'Auto Scroll: OFF';
                }
            }
        }

        // Toggle auto-scroll on/off
        function toggleGanttAutoScroll() {
            isGanttAutoScrollEnabled = !isGanttAutoScrollEnabled;
            localStorage.setItem(GANTT_STORAGE_KEY, isGanttAutoScrollEnabled.toString());
            updateGanttAutoScrollToggleUI();
            
            if (isGanttAutoScrollEnabled) {
                startGanttAutoScroll();
            } else {
                stopGanttAutoScroll();
            }
        }

        function startGanttAutoScroll() {
            if (!isGanttAutoScrollEnabled) return; // Don't start if disabled
            
            const ganttChart = document.getElementById('ganttChart');
            if (!ganttChart) return;

            // Hanya jalankan jika konten lebih tinggi dari container
            if (ganttChart.scrollHeight <= ganttChart.clientHeight) {
                return; // Tidak perlu scroll jika konten tidak overflow
            }

            // Hapus interval yang sudah ada jika ada
            if (ganttAutoScrollInterval) {
                clearInterval(ganttAutoScrollInterval);
            }

            ganttAutoScrollInterval = setInterval(function() {
                if (isGanttPaused || !isGanttAutoScrollEnabled) return;

                const maxScroll = ganttChart.scrollHeight - ganttChart.clientHeight;
                const currentScroll = ganttChart.scrollTop;

                if (isGanttScrollingDown) {
                    // Scroll ke bawah
                    if (currentScroll < maxScroll) {
                        ganttChart.scrollTop += ganttScrollSpeed;
                    } else {
                        // Sudah sampai bawah, mulai scroll ke atas
                        isGanttScrollingDown = false;
                    }
                } else {
                    // Scroll ke atas
                    if (currentScroll > 0) {
                        ganttChart.scrollTop -= ganttScrollSpeed;
                    } else {
                        // Sudah sampai atas, mulai scroll ke bawah
                        isGanttScrollingDown = true;
                    }
                }
            }, ganttScrollDelay);
        }

        function stopGanttAutoScroll() {
            if (ganttAutoScrollInterval) {
                clearInterval(ganttAutoScrollInterval);
                ganttAutoScrollInterval = null;
            }
        }

        // Filter function for Gantt Chart rows (dock filter)
        function filterGanttRows(filter) {
            if (filter === 'all') {
                resetDockFilter();
            }
        }

        $(document).ready(function() {
            // ========== DOCK FILTER LOGIC ==========
            const DOCK_FILTER_KEY = 'gantt_dock_filter';

            function updateDockSelectedCount() {
                const total = $('.dock-filter-cb').length;
                const checked = $('.dock-filter-cb:checked').length;
                $('#dockSelectedCount').text(checked + ' / ' + total + ' dipilih');
                // Update button badge
                if (checked < total) {
                    $('#ganttDockFilterBtn').removeClass('btn-outline-info').addClass('btn-info');
                    $('#ganttDockFilterBtn').html('<i class="bi bi-funnel-fill"></i> Filter Dock (' + checked + ')');
                } else {
                    $('#ganttDockFilterBtn').removeClass('btn-info').addClass('btn-outline-info');
                    $('#ganttDockFilterBtn').html('<i class="bi bi-funnel-fill"></i> Filter Dock');
                }
            }

            function applyDockFilter() {
                const checkedNames = [];
                $('.dock-filter-cb:checked').each(function() {
                    checkedNames.push($(this).data('dock-name'));
                });
                // Save to localStorage
                localStorage.setItem(DOCK_FILTER_KEY, JSON.stringify(checkedNames));
                // Show/hide rows
                $('.gantt-row').each(function() {
                    const rowDockCycle = $(this).data('dock-cycle');
                    if (checkedNames.includes(rowDockCycle)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
                updateDockSelectedCount();
            }

            // Load saved filter
            function loadDockFilter() {
                const saved = localStorage.getItem(DOCK_FILTER_KEY);
                if (saved) {
                    try {
                        const names = JSON.parse(saved);
                        if (Array.isArray(names) && names.length > 0) {
                            $('.dock-filter-cb').each(function() {
                                const dockName = $(this).data('dock-name');
                                $(this).prop('checked', names.includes(dockName));
                            });
                            applyDockFilter();
                            return;
                        }
                    } catch(e) {}
                }
                updateDockSelectedCount();
            }

            // Search filter
            $('#dockFilterSearch').on('input', function() {
                const q = $(this).val().toLowerCase();
                $('.dock-filter-item').each(function() {
                    const name = $(this).data('dock-name').toLowerCase();
                    $(this).toggle(name.indexOf(q) > -1);
                });
            });

            // Select all / deselect all
            $('#dockSelectAll').on('click', function() {
                $('.dock-filter-cb:visible').prop('checked', true);
                updateDockSelectedCount();
            });
            $('#dockDeselectAll').on('click', function() {
                $('.dock-filter-cb:visible').prop('checked', false);
                updateDockSelectedCount();
            });

            // Checkbox change
            $(document).on('change', '.dock-filter-cb', function() {
                updateDockSelectedCount();
            });

            // Apply button
            $('#dockFilterApply').on('click', function() {
                applyDockFilter();
                // Close modal
                var modal = bootstrap.Modal.getInstance(document.getElementById('dockFilterModal'));
                if (modal) modal.hide();
            });

            // Load saved dock filter
            loadDockFilter();

            // ========== END DOCK FILTER LOGIC ==========
            // Add hover effect to gantt bars
            $('.gantt-bar').hover(
                function() {
                    $(this).css('opacity', '0.8');
                },
                function() {
                    $(this).css('opacity', '1');
                }
            );

            // Add tooltip functionality
            $('.gantt-bar').attr('title', function() {
                return $(this).find('strong').text();
            });
            
            // Initialize
            loadDockFilter();
            
            // Load saved auto-scroll state
            loadGanttAutoScrollState();
            
            // Setup toggle button
            const ganttToggleBtn = document.getElementById('ganttAutoScrollToggle');
            if (ganttToggleBtn) {
                ganttToggleBtn.addEventListener('click', toggleGanttAutoScroll);
            }
            
            // Initialize auto-scroll setelah Gantt Chart ter-render
            setTimeout(function() {
                if (isGanttAutoScrollEnabled) {
                    startGanttAutoScroll();
                }
            }, 1000);

            // Pause saat hover, resume saat tidak hover
            const ganttChart = document.getElementById('ganttChart');
            if (ganttChart) {
                ganttChart.addEventListener('mouseenter', function() {
                    isGanttPaused = true;
                });

                ganttChart.addEventListener('mouseleave', function() {
                    isGanttPaused = false;
                });
            }
        });

        // ================= FULLSCREEN HANDLING =================
        const ganttContainer = document.getElementById('ganttContainer');
        const ganttFsToggle = document.getElementById('ganttFullscreenToggle');
        const ganttFsIcon = document.getElementById('ganttFullscreenIcon');

        function isFullscreen() {
            return document.fullscreenElement === ganttContainer;
        }

        function updateFullscreenButton() {
            if (isFullscreen()) {
                ganttFsIcon.classList.remove('bi-arrows-fullscreen');
                ganttFsIcon.classList.add('bi-fullscreen-exit');
                ganttFsToggle.innerHTML = '<i class=\"bi bi-fullscreen-exit\" id=\"ganttFullscreenIcon\"></i> Exit Full Screen';
            } else {
                ganttFsIcon.classList.remove('bi-fullscreen-exit');
                ganttFsIcon.classList.add('bi-arrows-fullscreen');
                ganttFsToggle.innerHTML = '<i class=\"bi bi-arrows-fullscreen\" id=\"ganttFullscreenIcon\"></i> Full Screen';
            }
        }

        if (ganttFsToggle && ganttContainer) {
            ganttFsToggle.addEventListener('click', async () => {
                try {
                    if (!isFullscreen()) {
                        await ganttContainer.requestFullscreen();
                    } else {
                        await document.exitFullscreen();
                    }
                } catch (e) {
                    console.error('Fullscreen error:', e);
                }
            });

            document.addEventListener('fullscreenchange', updateFullscreenButton);
        }

        // ============================================
        // SIGNALR REAL-TIME UPDATE FOR GANTT CHART
        // ============================================
        
        console.log("🚀 Initializing SignalR connection for Gantt Chart...");
        
        // Build SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/deliveryHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Information)
            .build();

        // Connection state management
        let isConnected = false;
        let reconnectAttempts = 0;
        const maxReconnectAttempts = 10;

        // Helper function to update status badge
        function updateStatusBadge(status, text) {
            const badge = $('#signalr-status-gantt');
            badge.removeClass('status-connecting status-live status-reconnecting status-disconnected');
            badge.addClass(`status-${status}`);
            badge.find('.status-text').text(text);
        }

        // Toast notification function
        function showToast(message, type = 'info') {
            const toastHtml = `
                <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999;">
                    <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : type === 'danger' ? 'danger' : 'info'} border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="bi bi-${type === 'success' ? 'check-circle-fill' : type === 'danger' ? 'exclamation-triangle-fill' : 'info-circle-fill'}"></i> ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            `;
            $('body').append(toastHtml);
            setTimeout(() => {
                $('.toast').fadeOut(300, function() { $(this).parent().remove(); });
            }, 5000);
        }

        // Refresh Gantt Chart data
        function refreshGanttChart() {
            console.log("🔄 Refreshing Gantt Chart data...");
            
            // Get current filter values
            const startDate = $('input[name="startDate"]').val();
            const endDate = $('input[name="endDate"]').val();
            const customerId = $('select[name="customerId"]').val();
            
            // Build query string
            let queryString = `?startDate=${startDate}&endDate=${endDate}`;
            if (customerId) {
                queryString += `&customerId=${customerId}`;
            }
            
            // Reload page with fade effect
            $('#ganttChart').fadeOut(200, function() {
                window.location.href = '@Url.Action("GanttChart", "DeliverySchedules")' + queryString;
            });
        }

        // SignalR event handlers
        connection.on("connected", function(connectionId) {
            console.log("✅ SignalR Connected! Connection ID:", connectionId);
            isConnected = true;
            reconnectAttempts = 0;
            updateStatusBadge('live', 'Live');
        });

        connection.on("deliveryUpdated", function(data) {
            console.log("🔔 Delivery Update Received:", data);
            
            // Use camelCase for data properties
            const action = data.action || data.Action;
            const message = data.message || data.Message;
            
            // Show notification
            const icon = action === 'arrival' ? '🚚' : '✅';
            showToast(`${icon} ${message}`, 'success');
            
            // Refresh Gantt Chart after a short delay (allow animation)
            setTimeout(() => {
                refreshGanttChart();
            }, 1000);
        });

        // Connection lifecycle events
        connection.onreconnecting((error) => {
            console.warn("⚠️ SignalR reconnecting...", error);
            isConnected = false;
            updateStatusBadge('reconnecting', 'Reconnecting...');
        });

        connection.onreconnected((connectionId) => {
            console.log("✅ SignalR reconnected! Connection ID:", connectionId);
            isConnected = true;
            reconnectAttempts = 0;
            updateStatusBadge('live', 'Live');
            
            // Refresh data after reconnection
            refreshGanttChart();
        });

        connection.onclose((error) => {
            console.error("❌ SignalR connection closed:", error);
            isConnected = false;
            updateStatusBadge('disconnected', 'Disconnected');
            
            // Auto reconnect
            if (reconnectAttempts < maxReconnectAttempts) {
                reconnectAttempts++;
                console.log(`🔄 Attempting to reconnect... (${reconnectAttempts}/${maxReconnectAttempts})`);
                setTimeout(() => startConnection(), 5000);
            } else {
                console.error("❌ Max reconnect attempts reached. Please refresh the page.");
                showToast('Koneksi terputus. Silakan refresh halaman.', 'danger');
            }
        });

        // Start connection function
        async function startConnection() {
            try {
                await connection.start();
                console.log("✅ SignalR connection started successfully!");
            } catch (err) {
                console.error("❌ SignalR connection failed:", err);
                setTimeout(() => startConnection(), 5000);
            }
        }

        // Initialize connection on page load
        startConnection();

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            if (connection && isConnected) {
                connection.stop();
            }
        });

        console.log("✅ SignalR initialization complete for Gantt Chart!");
    </script>
}

