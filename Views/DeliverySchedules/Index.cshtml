@model IEnumerable<DeliveryControl.Models.DeliverySchedule>

@{
    ViewData["Title"] = "Jadwal Delivery";
}

@* Hidden form for anti-forgery token *@
<form id="hiddenTokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="row mb-3">
    <div class="col-md-6">
        <h2><i class="bi bi-calendar-check"></i> History Shipping Delivery</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="DelayPickupTrend" class="btn btn-outline-warning me-2">
            <i class="bi bi-graph-up-arrow"></i> Tren Delay Pickup
        </a>
        <a asp-action="DelayChart" class="btn btn-outline-primary me-2">
            <i class="bi bi-bar-chart"></i> History Delay Chart
        </a>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <button type="button" class="btn btn-danger me-2" id="bulkDeleteBtn" style="display:none;" onclick="confirmBulkDelete()">
                <i class="bi bi-trash"></i> Hapus Terpilih (<span id="selectedCount">0</span>)
            </button>
            <a asp-action="BulkCreate" class="btn btn-success me-2">
                <i class="bi bi-calendar-check"></i> Buat Schedule (Bulk)
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tambah Schedule
            </a>
        }
    </div>

<!-- Filter Form -->
<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Tanggal Mulai</label>
                <input type="date" class="form-control" name="startDate" value="@ViewData["StartDate"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tanggal Selesai</label>
                <input type="date" class="form-control" name="endDate" value="@ViewData["EndDate"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select class="form-select" name="customerId">
                    <option value="">-- Semua Customer --</option>
                    @foreach (var item in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewData["CustomerId"]?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="">-- Semua --</option>
                    @foreach (var status in (IEnumerable<string>)ViewData["Statuses"]!)
                    {
                        <option value="@status" selected="@(status == ViewData["Status"]?.ToString())">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Schedule Table with Scroll -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div style="max-height: 600px; overflow-y: auto; overflow-x: hidden;">
                <table class="table table-hover table-bordered mb-0 table-sm" style="table-layout: fixed; width: 100%;">
                    <thead class="table-dark" style="position: sticky; top: 0; z-index: 100; background-color: #212529;">
                        <tr style="font-size: 0.85rem;">
                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <th class="text-center align-middle" style="width: 3%; background-color: #212529;">
                                    <input type="checkbox" id="selectAll" class="form-check-input" title="Pilih Semua">
                                </th>
                            }
                            <th class="text-center align-middle" style="width: 10%; background-color: #212529;">No Schedule</th>
                            <th class="text-center align-middle" style="width: 13%; background-color: #212529;">CUST</th>
                            <th class="text-center align-middle" style="width: 7%; background-color: #212529;">ROUTE</th>
                            <th class="text-center align-middle" style="width: 6%; background-color: #212529;">CYCLE</th>
                            <th class="text-center align-middle" style="width: 6%; background-color: #212529;">ENTER DOCK</th>
                            <th class="text-center align-middle" style="width: 9%; background-color: #212529;">EST SELESAI</th>
                            <th class="text-center align-middle" style="width: 10%; background-color: #212529;">ACT ENTER DOCK</th>
                            <th class="text-center align-middle" style="width: 9%; background-color: #212529;">EST ACT SELESAI</th>
                            <th class="text-center align-middle" style="width: 6%; background-color: #212529;">PICKUP</th>
                            <th class="text-center align-middle" style="width: 12%; background-color: #212529;">ACT PICKUP</th>
                            <th class="text-center align-middle" style="width: 6%; background-color: #212529;">ETD</th>
                            <th class="text-center align-middle" style="width: 12%; background-color: #212529;">ACT DELIVERY</th>
                            <th class="text-center align-middle" style="width: 7%; background-color: #212529;">RANGE</th>
                            <th class="text-center align-middle" style="width: 9%; background-color: #212529;">RANGE ACT</th>
                            <th class="text-center align-middle" style="width: 9%; background-color: #212529;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.85rem;">
                        @foreach (var item in Model)
                        {
                            // Calculate actual range
                            var actualRange = "";
                            if (item.ActualStartTime.HasValue && item.ActualEndTime.HasValue)
                            {
                                var duration = item.ActualEndTime.Value - item.ActualStartTime.Value;
                                actualRange = duration.TotalHours >= 1 
                                    ? $"{(int)duration.TotalHours}j {duration.Minutes}m"
                                    : $"{(int)duration.TotalMinutes}m";
                            }

                            // Check if late for enter dock
                            var isEnterDockLate = false;
                            var enterDockDelayMinutes = 0;
                            var isEnterDockEarly = false;
                            var enterDockEarlyMinutes = 0;
                            var estimatedDockTime = item.EnterDockTime?.AddMinutes(15);
                            var actualEstimatedDockTime = item.ActualEnterDockTime?.AddMinutes(15);
                            if (item.ActualEnterDockTime.HasValue && item.EnterDockTime.HasValue)
                            {
                                var delay = item.ActualEnterDockTime.Value - item.EnterDockTime.Value;
                                if (delay.TotalMinutes > 0)
                                {
                                    isEnterDockLate = true;
                                    enterDockDelayMinutes = (int)delay.TotalMinutes;
                                }
                                else if (delay.TotalMinutes < 0)
                                {
                                    isEnterDockEarly = true;
                                    enterDockEarlyMinutes = (int)Math.Abs(delay.TotalMinutes);
                                }
                            }

                            // Check if late for pickup
                            var isPickupLate = false;
                            var pickupDelayMinutes = 0;
                            if (item.ActualStartTime.HasValue && item.PickupTime.HasValue)
                            {
                                var delay = item.ActualStartTime.Value - item.PickupTime.Value;
                                if (delay.TotalMinutes > 0)
                                {
                                    isPickupLate = true;
                                    pickupDelayMinutes = (int)delay.TotalMinutes;
                                }
                            }

                            // Check if late for delivery (ETD)
                            var isDeliveryLate = false;
                            var deliveryDelayMinutes = 0;
                            if (item.ActualEndTime.HasValue && item.ETD.HasValue)
                            {
                                var delay = item.ActualEndTime.Value - item.ETD.Value;
                                if (delay.TotalMinutes > 0)
                                {
                                    isDeliveryLate = true;
                                    deliveryDelayMinutes = (int)delay.TotalMinutes;
                                }
                            }

                            <tr>
                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <td class="text-center align-middle">
                                        <input type="checkbox" class="form-check-input row-checkbox" value="@item.ScheduleId">
                                    </td>
                                }
                                <td class="text-center align-middle">
                                    <small><strong>@item.ScheduleNumber</strong></small>
                                </td>
                                <td class="align-middle">
                                    <div><strong>@item.Customer.CustomerCode</strong></div>
                                    <small class="text-muted">@item.Customer.CustomerName</small>
                                </td>
                                <td class="text-center align-middle">
                                    <small>@(item.Route ?? "-")</small>
                                </td>
                                <td class="text-center align-middle">
                                    <small>@(item.Cycle ?? "-")</small>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.EnterDockTime.HasValue)
                                    {
                                        <strong>@item.EnterDockTime.Value.ToString("HH:mm")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (estimatedDockTime.HasValue)
                                    {
                                        <strong>@estimatedDockTime.Value.ToString("HH:mm")</strong>
                                        <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
                                    }
                                    else if (item.EnterDockTime.HasValue)
                                    {
                                        <div>
                                            <strong>@item.EnterDockTime.Value.AddMinutes(15).ToString("HH:mm")</strong>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.ActualEnterDockTime.HasValue)
                                    {
                                        <div>
                                            <strong class="@(isEnterDockLate ? "text-danger" : (isEnterDockEarly ? "text-success" : "text-success"))">
                                                @item.ActualEnterDockTime.Value.ToString("HH:mm")
                                            </strong>
                                        </div>
                                        @if (isEnterDockLate)
                                        {
                                            <small class="text-danger d-block">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <strong>Terlambat +@enterDockDelayMinutes m</strong>
                                            </small>
                                        }
                                        else if (isEnterDockEarly)
                                        {
                                            <small class="text-success d-block">
                                                <i class="bi bi-check-circle-fill"></i> On Time -@enterDockEarlyMinutes m
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-success d-block">
                                                <i class="bi bi-check-circle-fill"></i> On Time
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (actualEstimatedDockTime.HasValue)
                                    {
                                        <strong>@actualEstimatedDockTime.Value.ToString("HH:mm")</strong>
                                        <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
                                    }
                                    else if (item.ActualEnterDockTime.HasValue)
                                    {
                                        <div>
                                            <strong>@item.ActualEnterDockTime.Value.AddMinutes(15).ToString("HH:mm")</strong>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">(+15m)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.PickupTime.HasValue)
                                    {
                                        <strong>@item.PickupTime.Value.ToString("HH:mm")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.ActualStartTime.HasValue)
                                    {
                                        <div>
                                            <strong class="@(isPickupLate ? "text-danger" : "text-success")">
                                                @item.ActualStartTime.Value.ToString("HH:mm")
                                            </strong>
                                        </div>
                                        @if (isPickupLate)
                                        {
                                            <small class="text-danger d-block">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <strong>Terlambat +@pickupDelayMinutes m</strong>
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-success d-block">
                                                <i class="bi bi-check-circle-fill"></i> On Time
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.ETD.HasValue)
                                    {
                                        <strong>@item.ETD.Value.ToString("HH:mm")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.ActualEndTime.HasValue)
                                    {
                                        <div>
                                            <strong class="@(isDeliveryLate ? "text-danger" : "text-success")">
                                                @item.ActualEndTime.Value.ToString("HH:mm")
                                            </strong>
                                        </div>
                                        @if (isDeliveryLate)
                                        {
                                            <small class="text-danger d-block">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <strong>Terlambat +@deliveryDelayMinutes m</strong>
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-success d-block">
                                                <i class="bi bi-check-circle-fill"></i> On Time
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <small>@(item.Range ?? "-")</small>
                                </td>
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrWhiteSpace(actualRange))
                                    {
                                        <strong class="text-primary">@actualRange</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="btn-group-vertical btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ScheduleId" class="btn btn-info btn-sm px-2 py-1" title="Detail" style="font-size: 0.75rem;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (Context.Session.GetString("Role") == "Admin")
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="btn btn-warning btn-sm px-2 py-1" title="Edit" style="font-size: 0.75rem;">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="btn btn-danger btn-sm px-2 py-1" title="Hapus" style="font-size: 0.75rem;">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info m-3">
                <i class="bi bi-info-circle"></i> Tidak ada data jadwal delivery untuk filter yang dipilih.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select All functionality
            $('#selectAll').change(function() {
                $('.row-checkbox').prop('checked', this.checked);
                updateBulkDeleteButton();
            });

            // Row checkbox functionality
            $('.row-checkbox').change(function() {
                updateBulkDeleteButton();
                $('#selectAll').prop('checked', $('.row-checkbox:checked').length === $('.row-checkbox').length);
            });

            function updateBulkDeleteButton() {
                var checkedCount = $('.row-checkbox:checked').length;
                $('#selectedCount').text(checkedCount);
                if (checkedCount > 0) {
                    $('#bulkDeleteBtn').show();
                } else {
                    $('#bulkDeleteBtn').hide();
                }
            }
        });

        function confirmBulkDelete() {
            var checkedBoxes = $('.row-checkbox:checked');
            var checkedCount = checkedBoxes.length;
            
            if (checkedCount === 0) {
                alert('Tidak ada schedule yang dipilih!');
                return false;
            }
            
            var selectedIds = checkedBoxes.map(function() {
                return this.value;
            }).get().join(',');
            
            if (confirm('Apakah Anda yakin ingin menghapus ' + checkedCount + ' schedule yang dipilih?\n\nData yang memiliki relasi (Delivery Items) akan ikut terhapus.')) {
                // Get token from hidden form
                var tokenElement = document.querySelector('#hiddenTokenForm input[name="__RequestVerificationToken"]');
                if (!tokenElement) {
                    alert('Error: Anti-forgery token tidak ditemukan!');
                    return false;
                }
                
                var token = tokenElement.value;
                
                // Create form for submission
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("BulkDelete", "DeliverySchedules")';
                
                // Add token
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                form.appendChild(tokenInput);
                
                // Add selected IDs
                var idsInput = document.createElement('input');
                idsInput.type = 'hidden';
                idsInput.name = 'selectedIds';
                idsInput.value = selectedIds;
                form.appendChild(idsInput);
                
                // Submit form
                document.body.appendChild(form);
                form.submit();
            }
            
            return false;
        }
    </script>
}

