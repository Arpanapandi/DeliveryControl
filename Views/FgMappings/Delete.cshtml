@model DeliveryControl.Models.FgMapping

@{
    ViewData["Title"] = "Hapus Mapping FG";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="cyber-card p-4 border-danger border-opacity-25 shadow-lg">
            <div class="text-center mb-4">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h2 class="fw-bold">Hapus Mapping?</h2>
                <p class="text-muted">Apakah Anda yakin ingin menghapus pemetaan rak untuk item ini?</p>
            </div>

            <div class="bg-dark bg-opacity-50 rounded p-4 mb-4">
                <div class="row mb-2">
                    <div class="col-4 text-white-50 small text-uppercase fw-bold">Part Number</div>
                    <div class="col-8 fw-bold text-primary">@Model.Item?.ItemCode</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-white-50 small text-uppercase fw-bold">Item Name</div>
                    <div class="col-8">@Model.Item?.ItemName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-white-50 small text-uppercase fw-bold">Lokasi</div>
                    <div class="col-8">@Model.Plant - Rak @Model.Rack (No @Model.NoRack)</div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="FgMappingId" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger py-3 fw-bold">
                        <i class="bi bi-trash me-2"></i> YA, HAPUS MAPPING
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary py-2">
                        BATAL
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
