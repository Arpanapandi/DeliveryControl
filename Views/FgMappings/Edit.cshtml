@model DeliveryControl.Models.FgMapping

@{
    ViewData["Title"] = "Edit Mapping FG";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold mb-0"><i class="bi bi-pencil-square text-warning"></i> Edit Mapping FG</h2>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Kembali
            </a>
        </div>

        <div class="cyber-card p-4 shadow-lg border-0">
            <form asp-action="Edit" id="mappingForm">
                <input type="hidden" asp-for="FgMappingId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Part Number Row (Read Only in Edit) -->
                <div class="mb-4">
                    <label class="form-label text-white-50 small fw-bold text-uppercase">Part Number</label>
                    <div class="input-group custom-input-group opacity-75">
                        <span class="input-group-text bg-dark border-0 text-white-50"><i class="bi bi-lock-fill"></i></span>
                        <input type="text" class="form-control cyber-form-control" value="@ViewBag.PartNumber" readonly />
                    </div>
                    <div id="itemNameDisplay" class="mt-2 small text-info fw-bold">
                        <i class="bi bi-info-circle me-1"></i> <span id="itemNameSpan">@Model.Item?.ItemName</span>
                    </div>
                </div>

                <!-- Plant Row -->
                <div class="mb-4">
                    <label class="form-label text-white-50 small fw-bold text-uppercase">Plant <span class="text-danger">*</span></label>
                    <select asp-for="Plant" class="form-select cyber-form-control py-2" required>
                        <option value="">-- Pilih Plant --</option>
                        @foreach (var plant in ViewBag.Plants)
                        {
                            <option value="@plant">@plant</option>
                        }
                    </select>
                </div>

                <!-- Rak Selector (Segmented A-I) -->
                <div class="mb-4">
                    <label class="form-label text-white-50 small fw-bold text-uppercase">Rak (A - I) <span class="text-danger">*</span></label>
                    <input type="hidden" asp-for="Rack" id="rakHiddenInput" />
                    <div class="rak-button-grid">
                        @foreach (var r in "ABCDEFGHI")
                        {
                            <button type="button" class="btn btn-rak-option @(Model.Rack == r.ToString() ? "active" : "")" data-rak="@r">@r</button>
                        }
                    </div>
                    <span asp-validation-for="Rack" class="text-danger small"></span>
                </div>

                <!-- No Rak Dropdown -->
                <div class="mb-4" id="noRakContainer">
                    <label class="form-label text-white-50 small fw-bold text-uppercase">No Rak (1 - 33) <span class="text-danger">*</span></label>
                    <select asp-for="NoRack" class="form-select cyber-form-control py-2" id="noRakSelect" required>
                        <option value="">-- Pilih No Rak --</option>
                        @for (int i = 1; i <= 33; i++)
                        {
                            <option value="@i">Nomor @i</option>
                        }
                    </select>
                </div>

                <div class="row mb-4">
                    <!-- Qty Lot -->
                    <div class="col-md-4">
                        <label class="form-label text-white-50 small fw-bold text-uppercase">Qty Lot <span class="text-danger">*</span></label>
                        <input asp-for="QtyLot" type="number" class="form-control cyber-form-control" placeholder="Lot Size" required />
                    </div>
                    <!-- Min Stock -->
                    <div class="col-md-4">
                        <label class="form-label text-danger small fw-bold text-uppercase">Min Stock (Shortage) <span class="text-danger">*</span></label>
                        <input asp-for="MinStock" type="number" class="form-control cyber-form-control border-danger border-opacity-25" placeholder="Min" required />
                    </div>
                    <!-- Max Stock -->
                    <div class="col-md-4">
                        <label class="form-label text-success small fw-bold text-uppercase">Max Stock (Over) <span class="text-danger">*</span></label>
                        <input asp-for="MaxStock" type="number" class="form-control cyber-form-control border-success border-opacity-25" placeholder="Max" required />
                    </div>
                </div>

                <div class="mt-5">
                    <button type="submit" class="btn btn-warning w-100 py-3 fw-bold text-dark">
                        <i class="bi bi-save-fill me-2"></i> UPDATE MAPPING
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Rak selection
            $('.btn-rak-option').click(function() {
                $('.btn-rak-option').removeClass('active');
                $(this).addClass('active');
                
                const rak = $(this).data('rak');
                $('#rakHiddenInput').val(rak);
            });
        });
    </script>
}

<style>
    .rak-button-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
    }
    
    .btn-rak-option {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        padding: 12px 0;
        font-weight: 700;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .btn-rak-option:hover {
        background: rgba(59, 130, 246, 0.1);
        border-color: var(--primary-blue);
        color: white;
    }

    .btn-rak-option.active {
        background: var(--primary-blue);
        color: white;
        border-color: var(--primary-blue);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
    }

    .cyber-form-control {
        background: rgba(15, 23, 42, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: white !important;
    }

    .cyber-form-control:focus {
        border-color: var(--primary-blue) !important;
        box-shadow: 0 0 8px rgba(59, 130, 246, 0.2) !important;
    }
</style>
