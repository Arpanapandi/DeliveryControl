@model DeliveryControl.Models.Dock

@{
    ViewData["Title"] = "Detail Dock";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h4><i class="bi bi-eye"></i> Detail Dock</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Kode Dock</dt>
                    <dd class="col-sm-8"><strong class="text-primary">@Model.DockCode</strong></dd>

                    <dt class="col-sm-4">Nama Dock</dt>
                    <dd class="col-sm-8">@Model.DockName</dd>

                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Customer.CustomerName</span>
                    </dd>

                    <dt class="col-sm-4">Lokasi</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "-")</dd>

                    <dt class="col-sm-4">Deskripsi</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "-")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Tidak Aktif</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Tanggal Dibuat</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

                    @if (Model.UpdatedDate.HasValue)
                    {
                        <dt class="col-sm-4">Terakhir Diupdate</dt>
                        <dd class="col-sm-8">@Model.UpdatedDate.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                </dl>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Kembali
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.DockId" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.DockId" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Hapus
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

