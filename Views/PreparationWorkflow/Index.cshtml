@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Workflow Scanner";
    bool isUserRolePrep = ViewData["IsUser"] is bool uPrep && uPrep;
}

<!-- Custom Styles -->
<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .scanner-top-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 2rem;
    }

    .custom-cyber-input-group {
        display: flex;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 10px;
        overflow: hidden;
        min-height: 54px; /* Touch-friendly height */
    }
    
    .input-icon-left {
        display: flex;
        align-items: center;
        padding: 0 16px;
        color: rgba(255, 255, 255, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 1.2rem;
    }
    
    .cyber-field {
        background: transparent !important;
        border: none !important;
        color: white !important;
        padding: 12px 16px !important;
        width: 100%;
        font-size: 1.1rem; /* Larger font */
    }
    
    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        padding: 0 16px;
        font-size: 1.2rem;
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
        padding: 14px !important;
        font-size: 1.1rem !important;
    }

    /* Progress Table Styles */
    .progress-table-container {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        overflow-x: auto; /* Tablet scroll fix */
        margin-top: 1.5rem;
    }

    .cyber-table {
        width: 100%;
        margin-bottom: 0;
        color: white;
        border-collapse: separate;
        border-spacing: 0;
    }

    .cyber-table th {
        background: rgba(0,0,0,0.3);
        color: var(--cyber-yellow);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem; /* Larger font */
        padding: 16px 15px;
        border-bottom: 2px solid var(--cyber-border);
    }

    .cyber-table td {
        padding: 16px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle;
        font-size: 0.95rem; /* Larger font */
    }

    .item-row.highlight-row {
        background: rgba(250, 204, 21, 0.1) !important;
        border-left: 4px solid var(--cyber-yellow);
        animation: row-glow 1s infinite alternate;
    }

    @@keyframes row-glow {
        from { background: rgba(250, 204, 21, 0.05); }
        to { background: rgba(250, 204, 21, 0.2); }
    }

    @@keyframes slideInRight {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    .progress-mini {
        height: 8px; /* Slightly thicker */
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        margin-top: 6px;
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 700;
    }

    /* Floating Progress Area (Success Dialog) */
    .progress-detail-container {
        display: none;
        background: #0f172a;
        border: 2px solid var(--cyber-yellow);
        border-radius: 8px;
        padding: 24px;
        margin-top: 20px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    /* Scanner Video Fix */
    #reader video {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important; /* Fix alignment */
    }

    /* Scanner Overlay & Bounding Box */
    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }

    .bounding-box {
        width: 250px;
        height: 250px;
        position: relative;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.4);
        border: 2px solid var(--cyber-yellow);
        border-radius: 4px;
    }
    
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2.5s ease-in-out infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 100%; opacity: 0; }
    }

    .scanner-tip {
        color: white;
        font-size: 0.85rem;
        margin-top: 15px;
        background: rgba(0,0,0,0.6);
        padding: 6px 16px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .active-scan {
        background: rgba(250, 204, 21, 0.2) !important;
        border-color: var(--cyber-yellow) !important;
    }

    #scannerToast {
        backdrop-filter: blur(8px);
        background: rgba(15, 23, 42, 0.9);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .selected-glow {
        border-color: var(--cyber-yellow) !important;
        box-shadow: 0 0 15px rgba(250, 204, 21, 0.5) !important;
        background: rgba(30, 41, 59, 0.9) !important;
    }
    .modal-cyber {
        background: var(--cyber-bg) !important;
        border: 2px solid var(--cyber-border) !important;
        box-shadow: 0 0 30px rgba(250, 204, 21, 0.2);
    }
    
    .modal-cyber .modal-header {
        background: rgba(15, 23, 42, 0.95);
        border-bottom: 2px solid var(--cyber-yellow) !important;
        padding: 0.8rem 1.25rem !important;
        align-items: center;
    }

    .modal-cyber .modal-title {
        color: var(--cyber-yellow);
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-weight: 700 !important;
        font-size: 1.1rem !important;
        margin-bottom: 0;
        line-height: 1.2;
    }

    .table-dark {
        background: transparent !important;
    }

    #tableScheduleList thead th {
        background: #1e293b !important;
        color: var(--cyber-yellow) !important;
        z-index: 1000;
        padding: 6px 8px !important;
        font-size: 0.7rem !important;
        border-bottom: 2px solid var(--cyber-border);
        position: sticky;
        top: 0;
    }
    
    #tableScheduleList tbody td {
        padding: 5px 8px !important;
        font-size: 0.75rem !important;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    #scheduleModal .modal-body {
        max-height: 420px;
        overflow-y: auto;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="text-white fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-warning"></i> Input Progress Preparation</h2>
        </div>
    </div>

    <!-- Scanner Section (Refactored to match Pulling UI) -->
    <div class="row justify-content-center">
        <div class="col-12">
            @if (isUserRolePrep)
            {
                <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-eye me-2 fs-5"></i>
                    <span>Anda login sebagai <strong>User</strong> — halaman ini hanya dapat dilihat, tidak dapat melakukan input preparation.</span>
                </div>
            }
            <div class="cyber-card p-4" style="background: #1e293b; border-radius: 12px; border: 1px solid #334155;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
                    <h5 class="mb-0 fw-bold text-white"><i class="bi bi-pencil-square me-2"></i> Form Input Preparation</h5>
                    <div class="d-flex align-items-center gap-3 flex-wrap justify-content-end">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input bg-warning border-warning" type="checkbox" id="fastScanMode" checked>
                            <label class="form-check-label text-warning small fw-bold" for="fastScanMode">MODE SCAN CEPAT (EXT)</label>
                        </div>
                        @if (ViewData["IsAdmin"] is bool isAdminView && isAdminView)
                        {
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="manualInputMode" style="background-color:#ef4444;border-color:#ef4444;">
                                <label class="form-check-label small fw-bold" style="color:#ef4444;" for="manualInputMode"><i class="bi bi-keyboard me-1"></i>MODE KETIK MANUAL</label>
                            </div>
                        }
                        @if (ViewData["IsAdmin"] is bool isAdminSkipView && isAdminSkipView)
                        {
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="skipStockMode" style="background-color:#f97316;border-color:#f97316;">
                                <label class="form-check-label small fw-bold" style="color:#f97316;" for="skipStockMode"><i class="bi bi-box-seam me-1"></i>SKIP VALIDASI STOCK</label>
                            </div>
                        }
                    </div>
                </div>

                @if (ViewData["TargetVin"] != null && !string.IsNullOrEmpty(ViewData["TargetVin"].ToString()))
                {
                    <div class="alert bg-info bg-opacity-10 border-info border-opacity-50 text-info mb-4 d-flex align-items-center">
                        <i class="bi bi-bullseye fs-4 me-3"></i>
                        <div>
                            <div class="small text-uppercase opacity-75 fw-bold">Manifest Sedang Diproses:</div>
                            <div class="fs-5 fw-bold text-white">@ViewData["TargetVin"]</div>
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-info ms-auto">
                            <i class="bi bi-x-circle me-1"></i> Batal Fokus
                        </a>
                    </div>
                }
                
                <div class="mx-auto">
                    <!-- Manual Mode Indicator (Admin Only) -->
                    @if (ViewData["IsAdmin"] is bool isAdminIndicator && isAdminIndicator)
                    {
                    <div id="manualModeIndicator" style="display:none;" class="mb-3 py-2 px-3 d-flex align-items-center gap-2" style="background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.5);border-radius:8px;">
                        <span style="background:rgba(239,68,68,0.2);border:1px solid rgba(239,68,68,0.5);border-radius:8px;padding:6px 14px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-keyboard" style="color:#ef4444;font-size:1.1rem;"></i>
                            <span style="color:#ef4444;font-weight:700;font-size:0.85rem;">MODE KETIK MANUAL AKTIF</span>
                            <span style="color:#94a3b8;font-size:0.8rem;">— Validasi suffix X dinonaktifkan (Admin Only)</span>
                        </span>
                    </div>
                    }

                    <!-- Skip Stock Validation Indicator (Admin only — Preparation tidak perlu tahu) -->
                    @{
                        bool skipStockActive = ViewData["SkipStockActive"] is bool ssa && ssa;
                        bool isAdminForIndicator = ViewData["IsAdmin"] is bool iai && iai;
                    }
                    @if (isAdminForIndicator)
                    {
                    <div id="skipStockIndicator" style="display:@(skipStockActive ? "block" : "none");" class="mb-3 py-2 px-3 d-flex align-items-center gap-2">
                        <span style="background:rgba(249,115,22,0.15);border:1px solid rgba(249,115,22,0.5);border-radius:8px;padding:6px 14px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-box-seam" style="color:#f97316;font-size:1.1rem;"></i>
                            <span style="color:#f97316;font-weight:700;font-size:0.85rem;">SKIP VALIDASI STOCK AKTIF</span>
                            <span style="color:#94a3b8;font-size:0.8rem;">— Preparation bisa scan meski stock habis/kosong.</span>
                        </span>
                    </div>
                    }

                    <!-- Status Identification (Moved here for better flow) -->
                    <div id="idStatusSection" style="display: none;" class="mb-4 p-3 border border-primary border-opacity-50 rounded bg-dark bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="spinner-grow spinner-grow-sm text-yellow me-2" role="status"></div>
                                <span id="idStatusText" class="text-white small fw-bold">Mencocokkan data...</span>
                            </div>
                            <span id="idTargetInfo" class="badge bg-primary px-3">---</span>
                        </div>
                    </div>

                    <!-- 1. VIN (Tag) -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Rak <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-tag-fill"></i></div>
                            <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Scan Barcode Rak..." readonly autofocus>
                            <button type="button" class="btn-scan-trigger" data-target="tagInput"><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 2. Label Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Label <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-upc-scan"></i></div>
                            <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Scan Barcode Label..." disabled readonly>
                            <button type="button" class="btn-scan-trigger" data-target="labelInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 3. Kanban Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Scan Barcode Kanban <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-clipboard-check"></i></div>
                            <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Scan Barcode Kanban..." disabled readonly>
                            <button type="button" class="btn-scan-trigger" data-target="kanbanInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- Hidden Button & Indicator -->
                    <div class="mt-4 text-center">
                        <button type="button" class="btn btn-neon-success w-100 py-2 shadow-lg fs-5" id="btnSavePreparation" style="display:none;">
                            <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA
                        </button>
                        <div id="prepLoadingIndicator" style="display:none;" class="text-info">
                            <span class="spinner-border spinner-border-sm me-2"></span>Menyimpan otomatis...
                        </div>
                    </div>

                    <!-- Pending Save Notification (fixed bottom-right layar, tidak menumpuk tombol) -->
                    <div id="pendingSaveNotif" style="
                        display:none;
                        position:fixed;
                        bottom:28px;
                        right:24px;
                        z-index:1200;
                        min-width:280px;
                        max-width:360px;
                        background:linear-gradient(135deg,#14532d,#166534);
                        border:1px solid #22c55e;
                        border-radius:10px;
                        padding:12px 16px;
                        box-shadow:0 4px 24px rgba(34,197,94,0.30);
                        animation: slideInRight 0.35s ease;
                    ">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1" style="font-size:1.1rem;flex-shrink:0;"></i>
                            <div>
                                <div style="color:#bbf7d0;font-weight:700;font-size:0.85rem;line-height:1.3;">Part tersimpan sebagai <span style="color:#4ade80;">PENDING</span></div>
                                <div style="color:#86efac;font-size:0.75rem;margin-top:2px;">Akan tersinkronisasi otomatis saat jadwal tersedia.</div>
                            </div>
                            <button onclick="document.getElementById('pendingSaveNotif').style.display='none';" 
                                style="background:none;border:none;color:#86efac;font-size:1rem;cursor:pointer;padding:0;margin-left:4px;line-height:1;">&times;</button>
                        </div>
                    </div>

                    <!-- Toast Notification (untuk sukses/info) -->
                    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
                        <div id="scannerToast" class="toast hide align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body" id="scannerToastBody">Message here</div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <!-- Success Progress Popup -->
    <div id="progressDetailArea" class="progress-detail-container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="text-yellow mb-0"><i class="bi bi-check-circle me-2"></i> BERHASIL DI-SCAN: <span id="progressTargetName" class="text-white">---</span></h6>
            <span id="progressPercentTotal" class="badge bg-success">0%</span>
        </div>
    </div>

</div>

<!-- Modal Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h6 class="modal-title text-white" id="scannerModalLabel">Scanning...</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 position-relative overflow-hidden" style="height: 400px; background: #000;">
                <div id="reader" style="width: 100%; height: 100%;"></div>
                <div class="scanner-overlay">
                    <div class="bounding-box">
                        <div class="scan-line"></div>
                    </div>
                    <div class="scanner-tip" id="scanner-status">Mencari Barcode / QR...</div>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<button type="button" class="floating-fab" id="btnShowSchedule" title="Lihat Jadwal Preparation">
    <i class="bi bi-calendar3"></i>
</button>

<!-- Modal Jadwal Preparation -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content modal-cyber text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-yellow">
                    <i class="bi bi-list-check me-2"></i> JADWAL PREPARATION
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Filter Bar (Fixed) -->
            <div class="p-3 bg-dark bg-opacity-50 border-bottom border-secondary d-flex flex-wrap gap-2 align-items-center">
                 <div class="input-group input-group-sm flex-grow-1" style="min-width: 150px; max-width: 250px;">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-calendar3"></i></span>
                    <input type="date" id="filterSchedDate" class="form-control bg-dark text-white border-secondary" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
                 <div class="input-group input-group-sm flex-grow-1" style="min-width: 200px;">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" id="filterSchedVin" class="form-control bg-dark text-white border-secondary" placeholder="Cari VIN / Part No...">
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" id="tableScheduleList">
                        <thead class="sticky-top">
                            <tr class="text-uppercase text-secondary small" style="background: #1e293b;">
                                <th class="p-2">Manifest</th>
                                <th class="p-2">Customer</th>
                                <th class="p-2">Part No / VIN</th>
                                <th class="p-2 text-center">QPC</th>
                                <th class="p-2 text-center">Kbn Prep</th>
                                <th class="p-2 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="scheduleListBody">
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border text-yellow" role="status"></div>
                                    <div class="mt-2">Memuat data...</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        $(document).ready(function () {
            // SignalR Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deliveryHub")
                .withAutomaticReconnect()
                .build();

            connection.on("deliveryUpdated", function (data) {
                console.log("Update received from SignalR:", data);
                // Refresh the schedule list if the modal is open, 
                // or just refresh to be safe if specific data matches
                if ($('#scheduleModal').hasClass('show')) {
                    loadScheduleList();
                }
            });

            connection.start()
                .then(() => console.log("SignalR Connected to Delivery Hub"))
                .catch(err => console.error("SignalR Connection Error: ", err.toString()));

            let html5QrCode = null;
            const scannerModalEl = document.getElementById('scannerModal');
            const scannerModal = new bootstrap.Modal(scannerModalEl);
            let activeInputId = null;
            let currentScheduleId = null;
            let isSubmitting = false; // Flag to prevent duplicate requests (legacy, masih dipakai untuk manual mode)
            let manualMode = false; // Admin-only: Manual typing mode (bypasses scan validation)
            let skipStockMode = false; // Admin+Preparation: Skip stock habis validation
            const isReadOnly = @(isUserRolePrep ? "true" : "false"); // Role User: view only — no scan/save

            // ================================================================
            // SCAN QUEUE SYSTEM
            // Scan ke-2, 3, 4... langsung masuk antrian tanpa menunggu response
            // server dari scan sebelumnya. Form di-reset SEGERA agar operator
            // bisa scan item berikutnya tanpa delay.
            // 
            // NOTE: Tidak ada duplicate check karena:
            // - 1 item bisa butuh 10+ kanban = scan 3-point check yang SAMA 10x
            // - Semua scan identik VALID dan harus tersimpan sebagai qty
            // - Validasi kanban terhadap database dilakukan di server
            // ================================================================
            const ScanQueue = (() => {
                const _q = [];
                let _running = false;
                let _badgeEl = null;
                let _scanCount = 0; // Counter untuk tracking jumlah scan dalam session

                // Tambahkan 1 scan ke antrian (non-blocking, no duplicate check)
                function push(payload) {
                    _scanCount++;
                    payload._scanId = _scanCount; // Unique ID untuk tracking
                    _q.push(payload);
                    _refreshBadge();
                    if (!_running) _next();
                }

                async function _next() {
                    if (_q.length === 0) {
                        _running = false;
                        _refreshBadge();
                        return;
                    }
                    _running = true;
                    const item = _q.shift();
                    _refreshBadge();

                    try {
                        await _execute(item);
                    } catch (e) {
                        logNGScan('Preparation', item.Tag || '', item.Label || '', item.Kanban || '', "Koneksi Error (Queue): " + e.message);
                        _toast('danger', '🔌 Koneksi error: ' + e.message);
                    }

                    // Jeda 80ms antar request agar SQLite tidak konflik
                    await _sleep(80);
                    _next();
                }

                async function _execute(payload) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    let attempt = 0;
                    const maxAttempts = 3;

                    while (attempt < maxAttempts) {
                        attempt++;
                        try {
                            const res = await fetch('/PreparationWorkflow/Save', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                },
                                body: JSON.stringify(payload)
                            });

                            const data = await res.json();

                            if (data.success) {
                                if (data.isPending) {
                                    // Tampilkan notifikasi PENDING (scan tersimpan tapi belum match schedule)
                                    const notif = document.getElementById('pendingSaveNotif');
                                    if (notif) {
                                        notif.style.display = 'block';
                                        clearTimeout(notif._t);
                                        notif._t = setTimeout(() => notif.style.display = 'none', 5000);
                                    }
                                } else {
                                    _toast('success', data.message || '✅ Berhasil tersimpan!');
                                    // Update progress detail
                                    if (data.scheduleDetails) {
                                        $('#progressTargetName').text(data.scheduleDetails.customerName);
                                        const pct = Math.round(data.scheduleDetails.totalPercent);
                                        $('#progressPercentTotal').text(pct + '%');
                                        $('#progressDetailArea').fadeIn();
                                        setTimeout(() => $('#progressDetailArea').fadeOut(), 3000);
                                    }
                                }
                            } else {
                                // Jika server retryable (SQLite busy) → coba lagi
                                if (data.retryable && attempt < maxAttempts) {
                                    await _sleep(150 * attempt);
                                    continue;
                                }
                                _toast('danger', data.message || '❌ Scan gagal!');
                                // Catat ke NG Log — form sudah di-reset, gunakan data dari payload
                                logNGScan('Preparation', payload.Tag || '', payload.Label || '', payload.Kanban || '', data.message || 'Scan gagal (queue)');
                                // CATATAN: Di mode queue, form sudah di-reset dan user mungkin sudah scan item berikutnya.
                                // JANGAN panggil resetKanbanOnly/resetInputs di sini karena akan mengganggu scan yang sedang berjalan.
                                // Cukup tampilkan error toast saja — user akan tahu item mana yang gagal.
                            }
                            break; // keluar dari retry loop

                        } catch (fetchErr) {
                            if (attempt >= maxAttempts) throw fetchErr;
                            await _sleep(200 * attempt);
                        }
                    }
                }

                function _refreshBadge() {
                    if (!_badgeEl) {
                        _badgeEl = document.createElement('div');
                        _badgeEl.id = '_sqBadge';
                        _badgeEl.style.cssText = [
                            'position:fixed', 'bottom:80px', 'right:20px', 'z-index:9999',
                            'background:#f59e0b', 'color:#1a1a2e', 'font-weight:700',
                            'font-size:13px', 'border-radius:20px', 'padding:7px 16px',
                            'box-shadow:0 4px 12px rgba(0,0,0,.5)', 'display:none',
                            'pointer-events:none'
                        ].join(';');
                        document.body.appendChild(_badgeEl);
                    }
                    if (_q.length > 0 || _running) {
                        _badgeEl.textContent = _running
                            ? '⚡ Menyimpan... (' + _q.length + ' antrian)'
                            : '⏳ Antrian: ' + _q.length + ' scan';
                        _badgeEl.style.display = 'block';
                    } else {
                        _badgeEl.style.display = 'none';
                    }
                }

                function _toast(type, msg) {
                    showScannerToast(msg, type);
                }

                function _sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

                return { push, get busy() { return _running; }, get size() { return _q.length; } };
            })();

            // --- TOGGLE PERSISTENCE: Simpan & restore state toggle via localStorage ---
            const LS_FAST   = 'prep_fastScanMode';
            const LS_MANUAL = 'prep_manualInputMode';
            const LS_SKIP   = 'prep_skipStockMode';

            // --- GLOBAL SCANNER HANDLER (ANTI-MANUAL & READONLY SUPPORT) ---
            let scanBuffer = "";
            let lastKeyTime = Date.now();
            const SCAN_INTERVAL = 100; // Dinaikkan dari 50ms → 120ms agar seluruh karakter barcode terbaca sebelum buffer di-reset

            window.addEventListener('keydown', function (e) {
                const currentTime = Date.now();

                // In manual mode, let individual input fields handle their own key events
                if (manualMode) return;
                
                // Ignore keydown events if the target is not a cyber-field input, or is a textarea/select
                if (e.target.tagName === "INPUT" && !$(e.target).hasClass('cyber-field')) return;
                if (e.target.tagName === "TEXTAREA" || e.target.tagName === "SELECT") return;
                // Ignore keydown events if any modal is currently open
                if ($('.modal.show').length > 0) return;

                if (currentTime - lastKeyTime > SCAN_INTERVAL) {
                    scanBuffer = "";
                }
                lastKeyTime = currentTime;

                if (e.keyCode === 13) { // Enter key
                    if (scanBuffer.length > 0) {
                        processScanResult(scanBuffer);
                        scanBuffer = "";
                    }
                    e.preventDefault(); // Prevent form submission or other default behavior
                    return;
                }

                // Only append printable characters
                if (e.key.length === 1) {
                    scanBuffer += e.key;
                    // Prevent karakter scanner masuk langsung ke input field
                    // Semua field scan bersifat readonly — karakter hanya boleh masuk via processScanResult
                    e.preventDefault();
                }
            });

            function processScanResult(code) {
                code = code.trim();
                const codeUpper = code.toUpperCase();
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                // Target logic: VIN -> Label -> Kanban
                if (!tag) {
                    // --- VIN VALIDATION (Must have X) — dilewati di manual mode ---
                    if (!codeUpper.endsWith('X')) {
                        logNGScan('Preparation', code, '', '', 'KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)');
                        showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                        return;
                    }
                    $('#tagInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#tagInput').removeClass('active-scan'), 500);
                    performLookup();
                } else if (!label) {
                    // --- LABEL VALIDATION (Must NOT have X) — dilewati di manual mode ---
                    if (codeUpper.endsWith('X')) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), code, '', 'KODE TIDAK VALID: Label tidak boleh mengandung suffix X');
                        showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                        resetLabelAndKanban();
                        return;
                    }
                    // --- VALIDASI VIN-IN-LABEL: Label harus mengandung kode VIN ---
                    const currentTagRaw = $('#tagInput').val().trim().toUpperCase();
                    const vinNormalized = currentTagRaw.replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                    if (vinNormalized && vinNormalized.length >= 4 && !codeUpper.includes(vinNormalized)) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), code, '', `Label tidak mengandung VIN: ${vinNormalized}`);
                        showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${vinNormalized}". Scan ulang label yang benar.`, "danger");
                        resetLabelAndKanban();
                        return;
                    }
                    $('#labelInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#labelInput').removeClass('active-scan'), 500);
                    performLookup();
                } else if (!kanban) {
                    // --- KANBAN VALIDATION (Must NOT have X) — dilewati di manual mode ---
                    if (codeUpper.endsWith('X')) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), code, 'KODE TIDAK VALID: Kanban tidak boleh mengandung suffix X');
                        showScannerToast("KODE TIDAK VALID: Kanban tidak boleh mengandung suffix X", "danger");
                        resetKanbanOnly();
                        return;
                    }
                    $('#kanbanInput').val(code).addClass('active-scan');
                    setTimeout(() => $('#kanbanInput').removeClass('active-scan'), 500);
                    checkAndAdvance();
                }
            }

            // --- SCANNER HANDLERS ---
            $('.btn-scan-trigger').click(function() {
                if (isReadOnly) return; // Role User: tidak bisa scan
                activeInputId = $(this).data('target');
                $('#scannerModalLabel').text("MEMINDAI: " + (activeInputId || "ITEM").toUpperCase());
                scannerModal.show();
            });

            $(scannerModalEl).on('shown.bs.modal', function () {
                initScanner();
            });

            $(scannerModalEl).on('hidden.bs.modal', function () {
                stopScanner();
                // Ensure focus is definitely not on the modal trigger if possible, though we handled it in onDetected
            });

            async function initScanner() {
                try {
                    const config = { 
                        fps: 25, 
                        aspectRatio: 1.0, 
                        qrbox: { width: 250, height: 250 },
                        showTorchButtonIfSupported: true,
                        videoConstraints: {
                            facingMode: "environment",
                            focusMode: "continuous",
                            width: { min: 640, ideal: 1280, max: 1920 },
                            height: { min: 480, ideal: 720, max: 1080 }
                        }
                    };
                    
                    if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
                    if (html5QrCode.isScanning) await html5QrCode.stop();

                    $('#scanner-status').text("Mengakses Kamera...");
                    await html5QrCode.start({ facingMode: "environment" }, config, onDetected);
                    $('#scanner-status').text("Scanner Aktif");
                } catch (err) {
                    $('#scanner-status').text("Gagal: " + err);
                    try {
                         if (html5QrCode) await html5QrCode.start({ facingMode: "user" }, { fps: 20, qrbox: { width: 250, height: 250 } }, onDetected);
                    } catch (e2) {
                         showScannerToast("Tidak dapat mengakses kamera: " + e2, "danger");
                    }
                }
            }

            function onDetected(decodedText) {
                // Validation for tagInput (VIN) must have 'X' suffix
                if (activeInputId === 'tagInput') {
                    if (!decodedText.trim().toUpperCase().endsWith('X')) {
                        showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                        $('#tagInput').val('');
                        scannerModal.hide();
                        return;
                    }
                    // Validation successful, keep X for visual
                    decodedText = decodedText.trim();
                }
                
                // Validation for Label/Kanban must NOT have 'X' suffix
                if (activeInputId === 'labelInput' || activeInputId === 'kanbanInput') {
                    if (decodedText.trim().toUpperCase().endsWith('X')) {
                        if (activeInputId === 'kanbanInput') {
                            showScannerToast("KODE TIDAK VALID: Kanban tidak boleh mengandung suffix X", "danger");
                            scannerModal.hide();
                            resetKanbanOnly();
                        } else {
                            showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                            scannerModal.hide();
                            resetLabelAndKanban();
                        }
                        return;
                    }
                }

                // Validasi VIN-in-Label saat scan kamera pada field Label
                if (activeInputId === 'labelInput') {
                    const scannedLabel = decodedText.trim().toUpperCase();
                    const tagValForCam = $('#tagInput').val().trim().toUpperCase().replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                    if (tagValForCam && tagValForCam.length >= 4 && !scannedLabel.includes(tagValForCam)) {
                        logNGScan('Preparation', $('#tagInput').val().trim(), decodedText.trim(), '', `Label tidak mengandung VIN: ${tagValForCam}`);
                        showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${tagValForCam}". Scan ulang label yang benar.`, "danger");
                        scannerModal.hide();
                        resetLabelAndKanban();
                        return;
                    }
                }

                // FIX ARIA HIDDEN: Focus OUT of the modal immediately.
                if (activeInputId) {
                    const $input = $(`#${activeInputId}`);
                    $input.val(decodedText).addClass('active-scan');
                    $input.prop('disabled', false).focus(); // Ensure it's enabled before focusing
                } else {
                    $('#tagInput').focus();
                }
                
                // Delay hiding to let the focus event propagate
                setTimeout(() => {
                    scannerModal.hide();
                    performLookup();
                }, 150);
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) await html5QrCode.stop();
            }

            // --- INPUT LOGIC ---

            function checkAndAdvance() {
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) { $('#tagInput').focus(); return; }
                if (!label && !$('#labelInput').prop('disabled')) { $('#labelInput').focus(); return; }
                if (!kanban && !$('#kanbanInput').prop('disabled')) { $('#kanbanInput').focus(); return; }

                if (tag && label && kanban) {
                    // Validasi kanban via server (performLookup) sebelum auto-save
                    // performLookup akan panggil triggerPrepAutoSave() jika kanban valid
                    // atau resetKanbanOnly() jika kanban tidak sesuai
                    performLookup();
                }
            }

            // ── CORE SAVE FUNCTION ──────────────────────────────────────────────────
            // Dipanggil langsung oleh performLookup/checkAndAdvance (mode scan)
            // atau oleh klik tombol (mode manual). Tidak bergantung pada state tombol.
            function doSave() {
                if (isReadOnly) return;

                const data = {
                    Tag: $('#tagInput').val().trim(),
                    Label: $('#labelInput').val().trim(),
                    Kanban: $('#kanbanInput').val().trim(),
                    SkipStockValidation: skipStockMode
                };

                if (!data.Tag || !data.Label || !data.Kanban) return;

                // Validasi client-side label: label harus mengandung kode VIN
                const tagNormDs = data.Tag.toUpperCase().replace(/X$/, '').replace(/LB$/, '').replace(/^LB/, '');
                if (tagNormDs && tagNormDs.length >= 4 && !data.Label.toUpperCase().includes(tagNormDs)) {
                    logNGScan('Preparation', data.Tag, data.Label, data.Kanban, `Label tidak mengandung VIN: ${tagNormDs}`);
                    showScannerToast(`❌ LABEL TIDAK VALID! Label harus mengandung kode VIN: "${tagNormDs}". Scan ulang label yang benar.`, "danger");
                    resetLabelAndKanban();
                    return;
                }

                if (manualMode) {
                    // ── Mode manual: blocking ajax (user klik tombol manual) ──
                    if (isSubmitting) return;
                    isSubmitting = true;
                    const $btn = $('#btnSavePreparation');
                    $btn.prop('disabled', true);
                    $('#prepLoadingIndicator').show();

                    $.ajax({
                        url: '/PreparationWorkflow/Save',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(data),
                        success: function (res) {
                            isSubmitting = false;
                            $btn.prop('disabled', false);
                            $('#prepLoadingIndicator').hide();
                            if (res.success) {
                                if (res.isPending) {
                                    var notif = document.getElementById('pendingSaveNotif');
                                    notif.style.display = 'block';
                                    clearTimeout(notif._autoHide);
                                    notif._autoHide = setTimeout(function() { notif.style.display = 'none'; }, 5000);
                                } else {
                                    showScannerToast(res.message, "success");
                                    if (res.scheduleDetails) {
                                        $('#progressTargetName').text(res.scheduleDetails.customerName);
                                        $('#progressPercentTotal').text(Math.round(res.scheduleDetails.totalPercent) + '%');
                                        $('#progressDetailArea').fadeIn();
                                        setTimeout(() => $('#progressDetailArea').fadeOut(), 3000);
                                    }
                                }
                                resetInputs();
                            } else {
                                logNGScan('Preparation', data.Tag, data.Label, data.Kanban, res.message || 'Server error (Manual Mode)');
                                showScannerToast(res.message, "danger");
                                if (res.message) {
                                    if (res.message.includes('KANBAN') || res.message.includes('Kanban')) resetKanbanOnly();
                                    else if (res.message.includes('LABEL') || res.message.includes('Label')) resetLabelAndKanban();
                                    else resetInputs();
                                } else resetInputs();
                            }
                        },
                        error: function() {
                            isSubmitting = false;
                            $btn.prop('disabled', false);
                            $('#prepLoadingIndicator').hide();
                            logNGScan('Preparation', data.Tag, data.Label, data.Kanban, "Connection Error (Manual Save)");
                            showScannerToast("Connection Error", "danger");
                        }
                    });
                } else {
                    // ── Mode scan: masukkan ke queue, RESET FORM LANGSUNG ──
                    // Operator bisa langsung scan item berikutnya tanpa menunggu response server
                    ScanQueue.push(data);
                    resetInputs(); // Reset segera → siap scan item berikutnya
                }
            }

            function triggerPrepAutoSave() {
                doSave();
            }

            $('#tagInput, #labelInput, #kanbanInput').on('change keypress', function(e) {
                // Prevent duplicate trigger if Enter is pressed (Internal Scanner)
                if(e.type === 'change' && $(this).data('last-event') === 'keypress') {
                    $(this).data('last-event', '');
                    return;
                }
                if(e.type === 'keypress') {
                    $(this).data('last-event', 'keypress');
                    if(e.which !== 13) return;
                }
                
                const id = $(this).attr('id');
                if (id === 'kanbanInput') {
                    checkAndAdvance();
                } else {
                    performLookup();
                }
            });

            function resetInputs() {
                const isFastMode = $('#fastScanMode').is(':checked');
                $('#idStatusSection').slideUp();
                $('#tagInput, #labelInput, #kanbanInput').val('').removeClass('active-scan');

                if (manualMode) {
                    // Manual mode: semua field tetap editable & enabled
                    $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                    $('.btn-scan-trigger').prop('disabled', false);
                    $('#btnSavePreparation').text('SIMPAN DATA').show();
                    currentScheduleId = null;
                    $('#tagInput').focus();
                    return;
                }

                // Mode scan: restore readonly & sembunyikan tombol save
                $('#tagInput, #labelInput, #kanbanInput').prop('readonly', true);
                $('#btnSavePreparation').hide().text('SIMPAN DATA');
                if (!isFastMode) {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', true);
                } else {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                }
                
                currentScheduleId = null;
                $('#tagInput').focus();
            }

            // Reset hanya kanban (untuk error kanban saja)
            // Berlaku untuk SEMUA mode: scan cepat, scan biasa, manual, semua role
            function resetKanbanOnly() {
                $('#kanbanInput').val('').removeClass('active-scan');
                // Enable field agar scanner bisa input, tapi TETAP readonly di scan mode (cegah ketik manual)
                $('#kanbanInput').prop('disabled', false);
                if (manualMode) {
                    $('#kanbanInput').prop('readonly', false);
                }
                // Focus kembali untuk scan kanban berikutnya
                setTimeout(() => $('#kanbanInput').focus(), 100);
            }

            // Reset label dan kanban (untuk error label)
            // Berlaku untuk SEMUA mode: scan cepat, scan biasa, manual, semua role
            function resetLabelAndKanban() {
                $('#labelInput, #kanbanInput').val('').removeClass('active-scan');
                // Enable field agar scanner bisa input, tapi TETAP readonly di scan mode (cegah ketik manual)
                $('#labelInput, #kanbanInput').prop('disabled', false);
                $('.btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                if (manualMode) {
                    $('#labelInput, #kanbanInput').prop('readonly', false);
                }
                setTimeout(() => $('#labelInput').focus(), 100);
            }

            function performLookup() {
                const isFastMode = $('#fastScanMode').is(':checked');
                let tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) return;

                // Validation for External Scanner: Must end with 'X' — dilewati di manual mode
                if (!manualMode && tag && !label && !kanban) {
                    if (!tag.toUpperCase().endsWith('X') && tag.length > 5) {
                         showScannerToast("KODE TIDAK VALID: Wajib scan dari Label asli (Missing X)", "danger");
                         $('#tagInput').val('').focus();
                         return;
                    }
                }
                
                // Validation for Label/Kanban: Must NOT end with 'X' — dilewati di manual mode
                if (!manualMode && label && label.toUpperCase().endsWith('X')) {
                    showScannerToast("KODE TIDAK VALID: Label tidak boleh mengandung suffix X", "danger");
                    resetLabelAndKanban();
                    return;
                }
                if (!manualMode && kanban && kanban.toUpperCase().endsWith('X')) {
                    showScannerToast("KODE TIDAK VALID: Kanban tidak boleh mengandung suffix X", "danger");
                    resetKanbanOnly();
                    return;
                }

                $.ajax({
                    url: '/PreparationWorkflow/LookupSchedule',
                    type: 'GET',
                    data: { tag: tag, label: label, kanban: kanban, skipStockValidation: skipStockMode },
                    success: function(res) {
                        if (res.success) {
                            if (res.found) {
                                currentScheduleId = res.schedule.scheduleId;
                                $('#idStatusSection').slideDown();
                                let foundHtml = `Ditemukan: ${res.schedule.customerName} <br><small class='text-warning fw-bold'>STOCK: ${res.item.currentStock || 0} BOX</small>`;
                                if (res.item.externalPartNos && res.item.externalPartNos.length > 0) {
                                    foundHtml += `<br><small class='text-info'>Kanban Ext: ${res.item.externalPartNos.map(p => `<span class='badge bg-info text-dark me-1'>${p}</span>`).join('')}</small>`;
                                }
                                $('#idStatusText').html(foundHtml);
                                $('#idTargetInfo').text(res.schedule.scheduleNumber);
                                
                                // Enable All
                                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);

                                // Auto Advance: Focus next field for External Scanner
                                const delay = isFastMode ? 50 : 300;
                                if (tag && label && kanban) {
                                    triggerPrepAutoSave();
                                } else if (tag && label) {
                                    setTimeout(() => $('#kanbanInput').focus(), delay);
                                } else if (tag) {
                                    setTimeout(() => $('#labelInput').focus(), delay);
                                }

                            } else if (res.item) {
                                // Partial Match / Step
                                
                                // Handle Specific Validation Failures (Kanban mismatch) — tetap blokir
                                if (res.message && (res.message.includes("tidak sesuai") || res.message.includes("tidak cocok") || res.message.includes("TIDAK VALID") || res.message.includes("KANBAN"))) {
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    showScannerToast(res.message, "danger");
                                    if (res.step === 'kanban') {
                                        resetKanbanOnly(); // Smart reset: kanban only, keep tag & label
                                    }
                                    return; 
                                }

                                $('#idStatusSection').slideDown();
                                $('#idStatusText').html(`Item: ${res.item.itemName} <br><small class='text-warning fw-bold'>STOCK: ${res.item.currentStock || 0} BOX</small>`);
                                $('#idTargetInfo').text(res.item.vin);

                                // Tampilkan external PartNo dari ItemMappings (jika ada)
                                if (res.item.externalPartNos && res.item.externalPartNos.length > 0) {
                                    const extBadges = res.item.externalPartNos.map(p => `<span class='badge bg-warning text-dark me-1'>${p}</span>`).join('');
                                    $('#idStatusText').append(`<br><small class='text-warning'>Kanban expected: ${extBadges}</small>`);
                                    // Update placeholder kanban agar user tahu apa yang di-scan
                                    const hintCodes = res.item.externalPartNos.join(' / ');
                                    $('#kanbanInput').attr('placeholder', `Scan kanban (${hintCodes})`);
                                } else {
                                    $('#kanbanInput').attr('placeholder', 'Scan Kanban');
                                }

                                // --- STEP FINAL: semua field terisi tapi jadwal tidak ditemukan ---
                                // Auto-save sebagai PENDING langsung tanpa perlu klik tombol
                                if (res.step === 'final') {
                                    $('#idStatusText').append(`<br><span class='badge bg-warning text-dark mt-1'><i class='bi bi-clock-history me-1'></i>JADWAL BELUM ADA — menyimpan sebagai PENDING...</span>`);
                                    if (manualMode) {
                                        // Mode manual: tampilkan tombol, user klik sendiri
                                        $('#btnSavePreparation').text('💾 Simpan Sebagai PENDING').show();
                                    } else {
                                        // Mode scan: simpan otomatis ke queue, reset form langsung
                                        const delayPending = isFastMode ? 50 : 300;
                                        setTimeout(() => doSave(), delayPending);
                                    }
                                    return;
                                }
                                
                                // Always enable Label if Tag is valid
                                $('#labelInput, .btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);

                                // Focus next field for External Scanner
                                const delay = isFastMode ? 50 : 300;
                                if (label) {
                                    $('#kanbanInput, .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                                    setTimeout(() => $('#kanbanInput').focus(), delay);
                                } else {
                                    setTimeout(() => $('#labelInput').focus(), delay);
                                }
                            } else {
                                // Tidak found, tidak ada item — bisa jadi validasi error dari server
                                // (mis: label tidak mengandung VIN, step:"label")
                                if (res.message) {
                                    if (res.step === 'label') {
                                        logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), '', res.message);
                                        resetLabelAndKanban(); // Smart reset: keep tag
                                    } else if (res.step === 'kanban') {
                                        logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                        resetKanbanOnly(); // Smart reset: keep tag & label
                                    } else {
                                        // TAG tidak dikenal — reset semua
                                        logNGScan('Preparation', $('#tagInput').val().trim(), '', '', res.message);
                                        resetInputs();
                                        $('#tagInput').val('');
                                    }
                                    showScannerToast(res.message, "danger");
                                } else {
                                    resetInputs();
                                    $('#tagInput').val('');
                                }
                            }
                        } else {
                            // Server menolak (success: false) — Smart reset berdasarkan jenis error
                            if (res.message) {
                                showScannerToast(res.message, "danger");
                                if (res.message.includes('KANBAN') || res.message.includes('Kanban')) {
                                    // Error kanban → reset hanya kanban
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    resetKanbanOnly();
                                } else if (res.message.includes('LABEL') || res.message.includes('Label')) {
                                    // Error label → reset label & kanban
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), '', res.message);
                                    resetLabelAndKanban();
                                } else {
                                    // Error kritis (TAG/VIN tidak dikenal, STOCK HABIS, dll) → reset semua
                                    logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), res.message);
                                    resetInputs();
                                    $('#tagInput').val('');
                                }
                            } else {
                                resetInputs();
                                $('#tagInput').val('');
                            }
                        }
                    },
                    error: function() {
                         logNGScan('Preparation', $('#tagInput').val().trim(), $('#labelInput').val().trim(), $('#kanbanInput').val().trim(), "Gagal menghubungi server (Lookup Error)");
                         showScannerToast("Gagal menghubungi server.", "danger");
                         resetInputs();
                         $('#tagInput').val(''); // --- AUTO RESET ---
                    }
                });
            }

            $('#btnSavePreparation').click(function () {
                doSave();
            });

            // Error Modal (untuk danger) — MANUAL CLOSE ONLY (tidak auto-close)
            let scanBlocked = false;
            const $errModal = $('<div class="modal fade" id="scanErrorModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:2100"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="background:#1e293b;border:2px solid #ef4444;border-radius:12px;"><div class="modal-body text-center py-4 px-4"><div style="font-size:3rem;color:#ef4444;" class="mb-3"><i class="bi bi-x-circle-fill"></i></div><h5 class="fw-bold text-white mb-3" id="scanErrorTitle">SCAN TIDAK VALID</h5><p class="text-white-50 mb-3" id="scanErrorMsg"></p><button type="button" class="btn btn-danger px-5 py-2 fw-bold" id="btnCloseScanError"><i class="bi bi-check-lg me-2"></i>Tutup</button></div></div></div></div>');
            $('body').append($errModal);
            const scanErrorModal = new bootstrap.Modal(document.getElementById('scanErrorModal'));
            $('#btnCloseScanError').on('click', function() {
                scanErrorModal.hide();
            });
            document.getElementById('scanErrorModal').addEventListener('hidden.bs.modal', function() {
                scanBlocked = false;
            });

            // Notification Helper
            function showScannerToast(message, type = 'primary') {
                if (type === 'danger') {
                    // Tampilkan error modal — scan diblokir
                    scanBlocked = true;
                    $('#scanErrorMsg').text(message);
                    scanErrorModal.show();
                    return;
                }
                // Use high-contrast global toast for success/warning/info
                if (window.showScanToast) {
                    window.showScanToast(message, type, 3500);
                    return;
                }
                // Fallback ke Bootstrap toast
                const $toast = $('#scannerToast');
                $toast.removeClass('bg-primary bg-success bg-danger bg-warning');
                $toast.addClass('bg-' + type);
                $('#scannerToastBody').text(message);
                const toast = new bootstrap.Toast($toast[0], { delay: 3000, autohide: true });
                toast.show();
            }

            function logNGScan(module, tag, label, kanban, reason) {
                fetch('@Url.Action("LogNG", "PreparationWorkflow")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        Module: module, 
                        Tag: tag, 
                        Label: label, 
                        Kanban: kanban, 
                        Reason: reason 
                    })
                }).catch(() => {}); // silent — jangan block UI
            }

            // Global click to refocus for external scanners
            $(document).click(function(e) {
                if (!$(e.target).closest('input, button, select, textarea').length) {
                    if ($('#kanbanInput').is(':visible') && !$('#kanbanInput').prop('disabled')) {
                        $('#kanbanInput').focus();
                    } else if ($('#labelInput').is(':visible') && !$('#labelInput').prop('disabled')) {
                        $('#labelInput').focus();
                    } else {
                        $('#tagInput').focus();
                    }
                }
            });

            // Visual feedback for focus
            $('input').on('focus', function() {
                $(this).closest('.custom-cyber-input-group').addClass('selected-glow');
            }).on('blur', function() {
                $(this).closest('.custom-cyber-input-group').removeClass('selected-glow');
            });

            // --- FLOATING BUTTON & SCHEDULE MODAL LOGIC ---
            const scheduleModal = new bootstrap.Modal(document.getElementById('scheduleModal'));
            
            $('#btnShowSchedule').click(function() {
                scheduleModal.show();
                loadScheduleList();
            });

            // Filter Event Listeners
            let filterTimeout;
            $('#filterSchedDate, #filterSchedVin').on('input change', function() {
                clearTimeout(filterTimeout);
                filterTimeout = setTimeout(loadScheduleList, 500);
            });

            function loadScheduleList() {
                const date = $('#filterSchedDate').val();
                const vin = $('#filterSchedVin').val();

                $('#scheduleListBody').html(`
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="spinner-border text-yellow" role="status"></div>
                            <div class="mt-2">Memuat data...</div>
                        </td>
                    </tr>
                `);

                $.ajax({
                    url: '/PreparationWorkflow/GetSchedulesJson',
                    type: 'GET',
                    data: { filterDate: date, vin: vin },
                    success: function(data) {
                        let html = '';
                        if (data && data.length > 0) {
                            data.forEach(item => {
                                let statusClass = 'bg-secondary';
                                let statusText = item.status || 'Waiting';
                                if (statusText === 'Completed') statusClass = 'bg-success';
                                else if (statusText === 'Preparing') statusClass = 'bg-warning text-dark';
                                else statusClass = 'bg-secondary';

                                // Kanban Fraction Display
                                let actual = item.totalKanbanActual || 0;
                                let target = item.totalKanbanTarget || 0;
                                let progressClass = 'bg-info text-dark';
                                if (actual >= target && target > 0) progressClass = 'bg-success text-white';

                                html += `
                                    <tr>
                                        <td class="p-2">
                                            <small class="fw-bold text-info">${item.scheduleNumber}</small>
                                        </td>
                                        <td class="p-2">
                                            <small class="fw-bold">${item.customerName}</small><br>
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> ${item.dock}</small>
                                        </td>
                                        <td class="p-2">
                                            <span class="text-warning fw-bold">${item.viNs || '-'}</span>
                                        </td>
                                        <td class="p-2 text-center">
                                            <small>${item.qtyPcs || 0} Pcs</small><br>
                                            <small class="text-muted">${item.qtyLot || '-'} /lot</small>
                                        </td>
                                        <td class="p-2 text-center">
                                            <span class="badge ${progressClass}" style="min-width:45px; font-size:0.75rem;">${actual.toFixed(0)} / ${target.toFixed(0)}</span>
                                        </td>
                                        <td class="p-2 text-center">
                                            <span class="badge ${statusClass}" style="font-size: 0.7rem;">${statusText}</span>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="6" class="text-center py-4 text-muted fst-italic">Tidak ada jadwal ditemukan.</td></tr>';
                        }
                        $('#scheduleListBody').html(html);
                    },
                    error: function() {
                        $('#scheduleListBody').html('<tr><td colspan="6" class="text-center py-4 text-danger">Gagal memuat data.</td></tr>');
                    }
                });
            }
            // --- RESTORE TOGGLE STATE dari localStorage ---
            // fastScanMode: default ON (null = belum pernah disimpan → anggap ON)
            const savedFast = localStorage.getItem(LS_FAST);
            if (savedFast === null || savedFast === '1') {
                $('#fastScanMode').prop('checked', true);
                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                setTimeout(() => $('#tagInput').focus(), 100);
            } else {
                $('#fastScanMode').prop('checked', false);
            }

            // skipStockMode: restore dari server Session (sumber kebenaran) — Admin aktifkan, semua role ikut
            // Nilai dari ViewData["SkipStockActive"] sudah di-render di indicator banner (show/hide oleh server)
            // Sync variable JS dan checkbox Admin agar konsisten
            const serverSkipActive = @(skipStockActive ? "true" : "false");
            if (serverSkipActive) {
                skipStockMode = true;
                localStorage.setItem(LS_SKIP, '1');
                $('#skipStockMode').prop('checked', true);
                // Indicator sudah tampil dari server-side render (style display:block)
            } else if (localStorage.getItem(LS_SKIP) === '1') {
                // localStorage bilang aktif tapi server bilang tidak → ikut server (reset localStorage)
                localStorage.setItem(LS_SKIP, '0');
            }

            // manualInputMode: default OFF
            // SECURITY: Hanya restore manual mode jika user adalah Admin.
            // Jika bukan Admin, paksa clear localStorage agar tidak bisa aktif dari sisa sesi Admin sebelumnya.
            const isAdminUser = @(ViewData["IsAdmin"] is bool isAdminJs && isAdminJs ? "true" : "false");
            if (!isAdminUser) {
                // Non-admin: pastikan manual mode SELALU off & hapus dari localStorage
                localStorage.removeItem(LS_MANUAL);
                manualMode = false;
            } else if (localStorage.getItem(LS_MANUAL) === '1') {
                $('#manualInputMode').prop('checked', true);
                manualMode = true;
                $('#manualModeIndicator').show();
                $('#fastScanMode').prop('disabled', true).closest('.form-check').css('opacity', 0.4);
                $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                $('.btn-scan-trigger').prop('disabled', false);
                $('#btnSavePreparation').show();
                $('#tagInput').attr('placeholder', 'Ketik Barcode Rak...');
                $('#labelInput').attr('placeholder', 'Ketik Barcode Label...');
                $('#kanbanInput').attr('placeholder', 'Ketik Barcode Kanban...');
                setTimeout(() => $('#tagInput').focus(), 100);
            }

            $('#fastScanMode').change(function() {
                const checked = $(this).is(':checked');
                localStorage.setItem(LS_FAST, checked ? '1' : '0');
                if (checked) {
                    $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                    // Fokus ke tagInput agar scanner langsung bisa scan
                    setTimeout(() => $('#tagInput').focus(), 50);
                } else {
                    // Reset if turned off and inputs are empty
                    if (!$('#tagInput').val()) resetInputs();
                }
            });

            // --- MANUAL INPUT MODE (Admin Only) ---
            $('#manualInputMode').change(function() {
                // SECURITY: Double-check server-side role (checkbox tidak muncul untuk non-Admin, tapi guard tetap diperlukan)
                if (!isAdminUser) {
                    $(this).prop('checked', false);
                    localStorage.removeItem(LS_MANUAL);
                    return;
                }
                manualMode = $(this).is(':checked');
                localStorage.setItem(LS_MANUAL, manualMode ? '1' : '0');
                if (manualMode) {
                    $('#manualModeIndicator').slideDown();
                    // Nonaktifkan fastScanMode saat manual mode aktif
                    $('#fastScanMode').prop('disabled', true).closest('.form-check').css('opacity', 0.4);
                    // Hapus readonly & enable semua field
                    $('#tagInput, #labelInput, #kanbanInput').prop('readonly', false).prop('disabled', false);
                    $('.btn-scan-trigger').prop('disabled', false);
                    // Tampilkan tombol simpan selalu
                    $('#btnSavePreparation').show();
                    // Update placeholder hint
                    $('#tagInput').attr('placeholder', 'Ketik Barcode Rak...');
                    $('#labelInput').attr('placeholder', 'Ketik Barcode Label...');
                    $('#kanbanInput').attr('placeholder', 'Ketik Barcode Kanban...');
                    $('#tagInput').focus();
                } else {
                    $('#manualModeIndicator').slideUp();
                    $('#fastScanMode').prop('disabled', false).closest('.form-check').css('opacity', 1);
                    // Kembalikan placeholder asli
                    $('#tagInput').attr('placeholder', 'Scan Barcode Rak...');
                    $('#labelInput').attr('placeholder', 'Scan Barcode Label...');
                    $('#kanbanInput').attr('placeholder', 'Scan Barcode Kanban...');
                    // Reset ke mode scan
                    resetInputs();
                }
            });

            // --- SKIP STOCK VALIDATION MODE (Admin Only toggle — berlaku untuk semua role via Session server) ---
            $('#skipStockMode').change(function() {
                skipStockMode = $(this).is(':checked');
                localStorage.setItem(LS_SKIP, skipStockMode ? '1' : '0');
                // Simpan ke server Session agar role Preparation pun ikut bypass
                $.ajax({
                    url: '@Url.Action("SetSkipStockMode", "PreparationWorkflow")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ active: skipStockMode })
                });
                if (skipStockMode) {
                    $('#skipStockIndicator').slideDown();
                } else {
                    $('#skipStockIndicator').slideUp();
                }
            });

            // --- FOCUS RECOVERY: Pastikan fokus selalu di tagInput agar scanner fisik langsung masuk buffer ---
            // Jalankan setiap 800ms — jika tidak ada modal terbuka dan tidak manual mode,
            // kembalikan fokus ke tagInput supaya scanner selalu punya target yang benar.
            setInterval(function() {
                if (manualMode) return;
                if ($('.modal.show').length > 0) return;
                const $focused = $(document.activeElement);
                // Jika fokus ada di luar field cyber (mis: button, body, document) → kembalikan ke tagInput
                if (!$focused.hasClass('cyber-field') && !$focused.is('input[type=text]')) {
                    $('#tagInput').focus();
                }
            }, 800);
        });
    </script>
}
