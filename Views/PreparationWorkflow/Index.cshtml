@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Gallery Checking";
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="mb-1"><i class="bi bi-truck text-primary"></i> Preparation Delivery Checking</h2>
        <p class="text-muted">Pengecekan barang di rak Finish Good sebelum dikirim ke Customer.</p>
    </div>
</div>

<div class="row justify-content-center">
    <!-- Single Full-Width Card -->
    <div class="col-12">
        <div class="cyber-card p-4">
            <h5 class="mb-4 fw-bold border-bottom pb-2"><i class="bi bi-shield-check me-2"></i> Form Input Preparation</h5>
            
            <div class="mx-auto" style="max-width: 800px;">
                <!-- 0. Pilih Schedule -->
                <div class="mb-4">
                    <label class="form-label d-block fw-bold text-primary"><i class="bi bi-calendar-check me-2"></i> 0. Pilih No. Schedule</label>
                    <div class="custom-cyber-input-group mb-2">
                        <div class="input-icon-left">
                            <i class="bi bi-list-task"></i>
                        </div>
                        <select class="form-select cyber-field" id="scheduleSelect">
                            <option value="">-- PILIH SCHEDULE DULU --</option>
                            @foreach (var schedule in Model)
                            {
                                <option value="@schedule.ScheduleId">
                                    @schedule.ScheduleNumber - @(schedule.Customer?.CustomerCode ?? "???") [@(schedule.Customer?.CustomerName ?? "No Name")] - DOCK: @(schedule.Customer?.Docking ?? "-") (@schedule.ScheduledDate.ToString("dd/MM"))
                                </option>
                            }
                        </select>
                        <button type="button" class="btn-scan-trigger" id="btnScanSchedule" title="Scan No. Schedule">
                            <i class="bi bi-qr-code-scan"></i>
                        </button>
                    </div>
                    <small class="text-info"><i class="bi bi-info-circle"></i> Pilih jadwal pengiriman sebelum mulai scan item.</small>
                </div>

                <!-- 1. Pilih Plant -->
                <div class="mb-4">
                    <label class="form-label d-block fw-bold text-primary"><i class="bi bi-building me-2"></i> 1. Pilih Plant</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="plant" id="plantMolded" value="Molded" checked>
                        <label class="btn btn-outline-primary py-3" for="plantMolded">MOLDED</label>

                        <input type="radio" class="btn-check" name="plant" id="plantHose" value="Hose">
                        <label class="btn btn-outline-primary py-3" for="plantHose">HOSE</label>

                        <input type="radio" class="btn-check" name="plant" id="plantRVI" value="RVI">
                        <label class="btn btn-outline-primary py-3" for="plantRVI">RVI</label>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4">

                <!-- 2. Identifikasi Produk (Tag, Label, Kanban) -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-primary mb-3"><i class="bi bi-qr-code-scan me-2"></i> 2. Identifikasi Produk</label>
                    
                    <!-- Tag Input Group -->
                    <div class="mb-4">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Tag <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left">
                                <i class="bi bi-pencil"></i>
                            </div>
                            <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Ketik manual atau scan...">
                            <button type="button" class="btn-scan-trigger" data-target="tagInput" title="Start Scanning">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Label Input Group -->
                    <div class="mb-4">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Label <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left">
                                <i class="bi bi-pencil"></i>
                            </div>
                            <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Ketik manual atau scan...">
                            <button type="button" class="btn-scan-trigger" data-target="labelInput" title="Start Scanning">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Kanban Input Group -->
                    <div class="mb-4">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Kanban <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left">
                                <i class="bi bi-pencil"></i>
                            </div>
                            <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Ketik manual atau scan...">
                            <button type="button" class="btn-scan-trigger" data-target="kanbanInput" title="Start Scanning">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                    </div>

                </div>

                <div class="mt-5 pb-5"> <!-- Added pb-5 for extra space -->
                    <button type="button" class="btn btn-neon-success w-100 py-4 shadow-lg fs-5" id="btnSavePreparation">
                        <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA PREPARATION
                    </button>
                </div>
            </div>
            
            @* Extra spacer to help browser open dropdown downwards *@
            <div style="height: 150px;"></div>
        </div>
    </div>
</div>

@section Modals {
    <!-- Scanner Modal -->
    <div class="modal fade" id="scannerModal" tabindex="-1" aria-labelledby="scannerModalLabel" aria-hidden="false" data-bs-backdrop="static" style="z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-darker-card border-primary border-opacity-50 shadow-lg">
                <div class="modal-header border-bottom border-primary border-opacity-25 bg-dark">
                    <h6 class="modal-title text-white" id="scannerModalLabel">
                        <i class="bi bi-camera-fill me-2 text-primary"></i>
                        <span id="currentScanningField">Scanning...</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 position-relative overflow-hidden" style="height: 400px; background: #000;">
                    <div id="reader" style="width: 100%; height: 100%;"></div>
                    <div class="scanner-overlay">
                        <div class="bounding-box">
                            <div class="scan-line"></div>
                            <div class="corner-tl"></div>
                            <div class="corner-tr"></div>
                            <div class="corner-bl"></div>
                            <div class="corner-br"></div>
                        </div>
                        <div class="scanner-tip" id="scanner-status">Mencari Barcode / QR... (v5)</div>
                        <button type="button" class="btn btn-sm btn-primary mt-3 px-3 py-1 rounded-pill" id="btnRestartCamera" style="pointer-events: auto; position: relative; z-index: 30;">
                            <i class="bi bi-arrow-clockwise me-1"></i> RESTART KAMERA
                        </button>
                    </div>
                </div>
                <div class="modal-footer border-top border-primary border-opacity-25 bg-dark justify-content-center py-2">
                    <button type="button" class="btn btn-outline-light btn-sm px-4" data-bs-dismiss="modal">BATAL</button>
                </div>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        $(document).ready(function () {
            let activeInputId = null;

            // Modal handling
            const scannerModalElement = document.getElementById('scannerModal');
            const scannerModal = new bootstrap.Modal(scannerModalElement);
            
            // Scanner implementation using Html5Qrcode
            let html5QrCode = null;

            $(scannerModalElement).on('shown.bs.modal', function () {
                console.log("Modal shown, starting Html5Qrcode...");
                initScanner();
            });

            $(scannerModalElement).on('hidden.bs.modal', function () {
                console.log("Modal hidden, stopping Html5Qrcode...");
                stopScanner();
            });

            // Re-added missing click handler
            $('.btn-scan-trigger').not('#btnScanSchedule').click(function() {
                activeInputId = $(this).data('target');
                const fieldName = (activeInputId || "").replace('Input', '').toUpperCase();
                $('#currentScanningField').text("Scanning " + fieldName);
                scannerModal.show();
            });

            // Special handler for Schedule Scanning
            $('#btnScanSchedule').click(function() {
                activeInputId = "scheduleSelect";
                $('#currentScanningField').text("Scanning SCHEDULE NUMBER");
                scannerModal.show();
            });

            $('#btnRestartCamera').click(function(e) {
                e.preventDefault();
                console.log("Manual restart triggered.");
                stopScanner().then(() => initScanner());
            });

            function initScanner() {
                // Check for Secure Context
                if (!window.isSecureContext) {
                    $('#scanner-status').html('<span class="text-danger">Error: HTTPS diperlukan</span><br><small style="font-size:0.6rem">Akses via IP wajib menggunakan HTTPS untuk kamera.</small>');
                    console.error("Camera access requires a Secure Context (HTTPS or localhost).");
                    return;
                }

                const config = { 
                    fps: 10, 
                    qrbox: { width: 250, height: 150 },
                    aspectRatio: 1.0
                };

                if (!html5QrCode) {
                    html5QrCode = new Html5Qrcode("reader");
                }

                $('#scanner-status').text("Mengakses Kamera...");
                
                html5QrCode.start(
                    { facingMode: "environment" }, 
                    config,
                    (decodedText) => {
                        console.log("Scan Result:", decodedText);
                        onDetected(decodedText);
                    },
                    (errorMessage) => {
                        // ignore noise
                    }
                ).then(() => {
                    $('#scanner-status').text("Scanner Aktif (v8)");
                }).catch(err => {
                    console.error("Html5Qrcode Error:", err);
                    $('#scanner-status').text("Gagal: " + err);
                    
                    // Fallback to any camera
                    html5QrCode.start(
                        { facingMode: "user" }, 
                        config,
                        (decodedText) => onDetected(decodedText)
                    ).catch(err2 => {
                        $('#scanner-status').text("Kamera Gagal Akses");
                    });
                });
            }

            function onDetected(code) {
                if (activeInputId === "scheduleSelect") {
                    // Try to match scanned text with option values or text
                    let found = false;
                    $('#scheduleSelect option').each(function() {
                        if ($(this).text().startsWith(code) || $(this).val() == code) {
                            $('#scheduleSelect').val($(this).val());
                            found = true;
                            return false;
                        }
                    });
                    
                    if (!found) {
                        alert("Schedule Number '" + code + "' tidak ditemukan di daftar aktif.");
                    } else {
                        $('#scheduleSelect').addClass('active-scan');
                        setTimeout(() => $('#scheduleSelect').removeClass('active-scan'), 500);
                    }
                    scannerModal.hide();
                } else if (activeInputId) {
                    $(`#${activeInputId}`).val(code).addClass('active-scan');
                    setTimeout(() => $(`#${activeInputId}`).removeClass('active-scan'), 500);
                    scannerModal.hide();
                }
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) {
                    try {
                        await html5QrCode.stop();
                        console.log("Scanner Stopped.");
                    } catch (err) {
                        console.warn("Stop Error:", err);
                    }
                }
            }

            // Save Data (AJAX)
            $('#btnSavePreparation').click(function () {
                const plant = $('input[name="plant"]:checked').val();
                const tag = $('#tagInput').val();
                const label = $('#labelInput').val();
                const kanban = $('#kanbanInput').val();
                const scheduleId = $('#scheduleSelect').val();
                const scheduleText = $('#scheduleSelect option:selected').text();

                if (!scheduleId) {
                    alert('SILAKAN PILIH NO. SCHEDULE TERLEBIH DAHULU!');
                    return;
                }

                if (!tag || !label || !kanban) {
                    alert('Lengkapi semua data yang WAJIB (Tag, Label, Kanban)!');
                    return;
                }

                const data = {
                    Plant: plant,
                    Tag: tag,
                    Label: label,
                    Kanban: kanban,
                    ScheduleId: parseInt(scheduleId)
                };

                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Menyimpan...');

                $.ajax({
                    url: '/PreparationWorkflow/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {
                        if (response.success) {
                            alert('SUKSES: ' + response.message);
                            // Reset location elements but NOT plant
                            $('#tagInput, #labelInput, #kanbanInput').val('');
                        } else {
                            alert('GAGAL: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Terjadi kesalahan koneksi ke server.');
                    },
                    complete: function() {
                        $('#btnSavePreparation').prop('disabled', false).html('<i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA PREPARATION');
                    }
                });
            });
        });
    </script>
}

<style>
    /* CUSTOM INPUT GROUP DESIGN (MATCHING POOLING STYLE) */
    .custom-cyber-input-group {
        display: flex;
        align-items: stretch;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .custom-cyber-input-group:focus-within {
        border-color: var(--primary-blue);
        box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
        background: rgba(30, 41, 59, 0.9);
    }

    .input-icon-left {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.2rem;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cyber-field {
        background: rgba(15, 23, 42, 0.8) !important;
        border: none !important;
        box-shadow: none !important;
        color: white !important;
        padding: 14px 18px !important;
        font-size: 1rem;
        flex-grow: 1;
        width: 100%;
        position: relative;
        z-index: 5;
    }

    /* Fixed dropdown options for dark mode visibility */
    .cyber-field option {
        background-color: #1e293b !important; /* solid dark blue-gray */
        color: #f1f5f9 !important; /* light text */
    }

    .cyber-field:focus {
        background: rgba(30, 41, 59, 0.9) !important;
        outline: none !important;
    }

    .cyber-field::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        padding: 0 18px;
        font-size: 1.4rem;
        transition: all 0.2s;
        cursor: pointer;
        position: relative;
        z-index: 5;
    }

    .btn-scan-trigger:hover {
        background: rgba(59, 130, 246, 0.1);
        color: var(--primary-blue);
    }

    .btn-scan-trigger.active-scanning {
        background: var(--primary-blue);
        color: white;
        animation: pulse-scanner 1.5s infinite;
    }

    @@keyframes pulse-scanner {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: 700;
        border: none;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
    }

    .btn-neon-success:hover {
        background: #059669;
        transform: translateY(-2px);
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.5);
        color: white;
    }

    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }
    
    .scanner-tip {
        color: white;
        font-size: 0.8rem;
        margin-top: 15px;
        background: rgba(0,0,0,0.5);
        padding: 5px 15px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .bounding-box {
        width: 260px;
        height: 160px;
        position: relative;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.4);
        border: 2px solid rgba(59, 130, 246, 0.5);
    }
    
    /* Corner indicators */
    .corner-tl, .corner-tr, .corner-bl, .corner-br {
        position: absolute;
        width: 20px;
        height: 20px;
        border: 4px solid var(--primary-blue);
    }
    .corner-tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
    .corner-tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
    .corner-bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
    .corner-br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }

    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2s linear infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; }
        100% { top: 100%; }
    }

    #reader video {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
    }
    
    #reader canvas {
        display: none !important;
    }

    .active-scan {
        background: rgba(16, 185, 129, 0.2) !important;
        border-color: #10b981 !important;
    }
</style>
