@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Workflow Scanner";
}

<!-- Custom Styles -->
<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .scanner-top-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 2rem;
    }

    .custom-cyber-input-group {
        display: flex;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        overflow: hidden;
    }
    
    .input-icon-left {
        display: flex;
        align-items: center;
        padding: 0 12px;
        color: rgba(255, 255, 255, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .cyber-field {
        background: transparent !important;
        border: none !important;
        color: white !important;
        padding: 10px 12px !important;
        width: 100%;
        font-size: 0.9rem;
    }
    
    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        padding: 0 12px;
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

    /* Progress Table Styles */
    .progress-table-container {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        overflow: hidden;
        margin-top: 1.5rem;
    }

    .cyber-table {
        width: 100%;
        margin-bottom: 0;
        color: white;
        border-collapse: separate;
        border-spacing: 0;
    }

    .cyber-table th {
        background: rgba(0,0,0,0.3);
        color: var(--cyber-yellow);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 12px 15px;
        border-bottom: 2px solid var(--cyber-border);
    }

    .cyber-table td {
        padding: 12px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle;
    }

    .item-row.highlight-row {
        background: rgba(250, 204, 21, 0.1) !important;
        border-left: 4px solid var(--cyber-yellow);
        animation: row-glow 1s infinite alternate;
    }

    @@keyframes row-glow {
        from { background: rgba(250, 204, 21, 0.05); }
        to { background: rgba(250, 204, 21, 0.2); }
    }

    .progress-mini {
        height: 6px;
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
        margin-top: 4px;
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
    }

    /* Floating Progress Area (Success Dialog) */
    .progress-detail-container {
        display: none;
        background: #0f172a;
        border: 2px solid var(--cyber-yellow);
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    /* Scanner Video Fix */
    #reader video {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important; /* Fix alignment */
    }

    /* Scanner Overlay & Bounding Box */
    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }

    .bounding-box {
        width: 250px;
        height: 250px;
        position: relative;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.4);
        border: 2px solid var(--cyber-yellow);
        border-radius: 4px;
    }
    
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2.5s ease-in-out infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 100%; opacity: 0; }
    }

    .scanner-tip {
        color: white;
        font-size: 0.75rem;
        margin-top: 15px;
        background: rgba(0,0,0,0.6);
        padding: 4px 12px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-warning"></i> Input Progress Preparation</h2>
            <p class="text-secondary mb-0">Scan VIN (Tag), Label, dan Kanban untuk update progres.</p>
        </div>

    </div>

    <!-- Scanner Section (Refactored to match Pulling UI) -->
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="cyber-card p-4" style="background: #1e293b; border-radius: 12px; border: 1px solid #334155;">
                <h5 class="mb-4 fw-bold border-bottom border-secondary pb-2 text-white"><i class="bi bi-pencil-square me-2"></i> Form Input Preparation</h5>
                
                <div class="mx-auto">
                    <!-- Status Identification (Moved here for better flow) -->
                    <div id="idStatusSection" style="display: none;" class="mb-4 p-3 border border-primary border-opacity-50 rounded bg-dark bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="spinner-grow spinner-grow-sm text-yellow me-2" role="status"></div>
                                <span id="idStatusText" class="text-white small fw-bold">Mencocokkan data...</span>
                            </div>
                            <span id="idTargetInfo" class="badge bg-primary px-3">---</span>
                        </div>
                    </div>

                    <!-- 1. VIN (Tag) -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">VIN (TAG MASTER) <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-tag-fill"></i></div>
                            <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Scan VIN..." autofocus>
                            <button type="button" class="btn-scan-trigger" data-target="tagInput"><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 2. Label Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">LABEL CUSTOMER <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-upc-scan"></i></div>
                            <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Scan Label..." disabled>
                            <button type="button" class="btn-scan-trigger" data-target="labelInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- 3. Kanban Customer -->
                    <div class="mb-3">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">KANBAN CUSTOMER <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left"><i class="bi bi-clipboard-check"></i></div>
                            <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Scan Kanban..." disabled>
                            <button type="button" class="btn-scan-trigger" data-target="kanbanInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                        </div>
                    </div>

                    <!-- Hidden Button & Indicator -->
                    <div class="mt-4 text-center">
                        <button type="button" class="btn btn-neon-success w-100 py-2 shadow-lg fs-5" id="btnSavePreparation" style="display:none;">
                            <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA
                        </button>
                        <div id="prepLoadingIndicator" style="display:none;" class="text-info">
                            <span class="spinner-border spinner-border-sm me-2"></span>Menyimpan otomatis...
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Progress Table (Restored) -->
    <div class="progress-table-container shadow-lg">
        <table class="cyber-table">
            <thead>
                <tr>
                    <th>Manifest / Schedule</th>
                    <th>Customer / Dock</th>
                    <th>Part No / VIN</th>
                    <th>Progress</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var schedule in Model)
                    {
                        foreach (var item in schedule.DeliveryItems)
                        {
                            var percent = (item.Quantity > 0) ? ((double)(item.ActualQuantity ?? 0) / (double)item.Quantity * 100) : 0;
                            <tr class="item-row" data-schedule-id="@schedule.ScheduleId">
                                <td>
                                    <div class="fw-bold text-warning">@schedule.ScheduleNumber</div>
                                    <small class="text-white-50">@schedule.ScheduledDate.ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    <div class="text-white fw-bold">@schedule.Customer?.CustomerName</div>
                                    <span class="badge bg-secondary opacity-75" style="font-size: 0.65rem;">Dock: @schedule.Customer?.Docking</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        @if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber))
                                        {
                                            <span class="text-info fw-bold fs-6">@item.Item.CustomerPartNumber</span>
                                            <small class="text-secondary opacity-75" style="font-size: 0.75rem;">VIN: @item.Item.VIN</small>
                                        }
                                        else
                                        {
                                            <span class="text-info fw-bold">@item.Item?.VIN</span>
                                        }
                                    </div>
                                </td>
                                <td style="min-width: 150px;">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-white-50 font-monospace">@((item.ActualQuantity ?? 0).ToString("G29")) / @item.Quantity.ToString("G29")</span>
                                        <span class="@(percent >= 100 ? "text-success" : "text-info")">@percent.ToString("0")%</span>
                                    </div>
                                    <div class="progress progress-mini">
                                        <div class="progress-bar @(percent >= 100 ? "bg-success" : "bg-info")" 
                                             role="progressbar" style="width: @percent%"></div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (percent >= 100) { <span class="status-badge bg-success text-white">READY</span> }
                                    else if (percent > 0) { <span class="status-badge bg-warning text-dark">PROGRESS</span> }
                                    else { <span class="status-badge bg-secondary opacity-50">WAITING</span> }
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            <span class="text-secondary">Tidak ada jadwal aktif untuk saat ini.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Success Progress Popup -->
    <div id="progressDetailArea" class="progress-detail-container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="text-yellow mb-0"><i class="bi bi-check-circle me-2"></i> BERHASIL DI-SCAN: <span id="progressTargetName" class="text-white">---</span></h6>
            <span id="progressPercentTotal" class="badge bg-success">0%</span>
        </div>
    </div>

<!-- Modal Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h6 class="modal-title text-white" id="scannerModalLabel">Scanning...</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 position-relative overflow-hidden" style="height: 400px; background: #000;">
                <div id="reader" style="width: 100%; height: 100%;"></div>
                <div class="scanner-overlay">
                    <div class="bounding-box">
                        <div class="scan-line"></div>
                    </div>
                    <div class="scanner-tip" id="scanner-status">Mencari Barcode / QR...</div>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        $(document).ready(function () {
            let html5QrCode = null;
            const scannerModalEl = document.getElementById('scannerModal');
            const scannerModal = new bootstrap.Modal(scannerModalEl);
            let activeInputId = null;
            let currentScheduleId = null;

            // --- SCANNER HANDLERS ---
            $('.btn-scan-trigger').click(function() {
                activeInputId = $(this).data('target');
                $('#scannerModalLabel').text("MEMINDAI: " + (activeInputId || "ITEM").toUpperCase());
                scannerModal.show();
            });

            $(scannerModalEl).on('shown.bs.modal', function () {
                initScanner();
            });

            $(scannerModalEl).on('hidden.bs.modal', function () {
                stopScanner();
                // Ensure focus is definitely not on the modal trigger if possible, though we handled it in onDetected
            });

            async function initScanner() {
                try {
                    const config = { 
                        fps: 25, 
                        aspectRatio: 1.0, 
                        qrbox: { width: 250, height: 250 },
                        showTorchButtonIfSupported: true,
                        videoConstraints: {
                            facingMode: "environment",
                            focusMode: "continuous",
                            width: { min: 640, ideal: 1280, max: 1920 },
                            height: { min: 480, ideal: 720, max: 1080 }
                        }
                    };
                    
                    if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
                    if (html5QrCode.isScanning) await html5QrCode.stop();

                    $('#scanner-status').text("Mengakses Kamera...");
                    await html5QrCode.start({ facingMode: "environment" }, config, onDetected);
                    $('#scanner-status').text("Scanner Aktif");
                } catch (err) {
                    $('#scanner-status').text("Gagal: " + err);
                    try {
                         if (html5QrCode) await html5QrCode.start({ facingMode: "user" }, { fps: 20, qrbox: { width: 250, height: 250 } }, onDetected);
                    } catch (e2) {
                         alert("Tidak dapat mengakses kamera: " + e2);
                    }
                }
            }

            function onDetected(decodedText) {
                // FIX ARIA HIDDEN: Focus OUT of the modal immediately.
                if (activeInputId) {
                    const $input = $(`#${activeInputId}`);
                    $input.val(decodedText).addClass('active-scan');
                    $input.prop('disabled', false).focus(); // Ensure it's enabled before focusing
                } else {
                    $('#tagInput').focus();
                }
                
                // Delay hiding to let the focus event propagate
                setTimeout(() => {
                    scannerModal.hide();
                    performLookup();
                }, 150);
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) await html5QrCode.stop();
            }

            // --- INPUT LOGIC ---

            function checkAndAdvance() {
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) { $('#tagInput').focus(); return; }
                if (!label && !$('#labelInput').prop('disabled')) { $('#labelInput').focus(); return; }
                if (!kanban && !$('#kanbanInput').prop('disabled')) { $('#kanbanInput').focus(); return; }

                if (tag && label && kanban) {
                    triggerPrepAutoSave();
                }
            }

            function triggerPrepAutoSave() {
                if ($('#btnSavePreparation').prop('disabled')) return;
                $('#btnSavePreparation').click();
            }

            $('#tagInput, #labelInput, #kanbanInput').on('change keypress', function(e) {
                if(e.type === 'keypress' && e.which !== 13) return;
                
                const id = $(this).attr('id');
                if (id === 'kanbanInput') {
                    checkAndAdvance();
                } else {
                    performLookup();
                }
            });

            function resetInputs() {
                $('#idStatusSection').slideUp();
                $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', true);
                currentScheduleId = null;
                $('.item-row').removeClass('highlight-row');
            }

            function performLookup() {
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) return;

                $.ajax({
                    url: '/PreparationWorkflow/LookupSchedule',
                    type: 'GET',
                    data: { tag: tag, label: label, kanban: kanban },
                    success: function(res) {
                        if (res.success) {
                            if (res.found) {
                                currentScheduleId = res.schedule.scheduleId;
                                $('#idStatusSection').slideDown();
                                $('#idStatusText').text("Ditemukan: " + res.schedule.customerName);
                                $('#idTargetInfo').text(res.schedule.scheduleNumber);
                                
                                // Highlight
                                $('.item-row').removeClass('highlight-row');
                                $(`.item-row[data-schedule-id="${currentScheduleId}"]`).addClass('highlight-row');
                                
                                const $firstRow = $(`.item-row[data-schedule-id="${currentScheduleId}"]`).first();
                                if ($firstRow.length) {
                                    $('html, body').animate({ scrollTop: $firstRow.offset().top - 200 }, 500);
                                }

                                // Enable All
                                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);

                                // Auto Advance / Submit
                                if (tag && label && kanban) {
                                    triggerPrepAutoSave();
                                } else if (tag && label) {
                                    // AUTOMATION: Open Kanban Scanner
                                    setTimeout(() => {
                                        if (!$('#scannerModal').is(':visible')) {
                                            $('.btn-scan-trigger[data-target="kanbanInput"]').click();
                                        }
                                    }, 500);
                                } else if (tag) {
                                    // AUTOMATION: Open Label Scanner
                                    setTimeout(() => {
                                        if (!$('#scannerModal').is(':visible')) {
                                            $('.btn-scan-trigger[data-target="labelInput"]').click();
                                        }
                                    }, 500);
                                }

                            } else if (res.item) {
                                // Partial Match / Step
                                
                                // Handle Specific Validation Failures (Label/Kanban mismatch)
                                if (res.message && (res.message.includes("tidak sesuai") || res.message.includes("tidak cocok") || res.message.includes("Label tidak sesuai"))) {
                                    alert(res.message);
                                    if (res.step === 'label') {
                                        $('#labelInput').val('').focus();
                                    } else if (res.step === 'kanban') {
                                        $('#kanbanInput').val('').focus();
                                    }
                                    // Don't proceed to update UI if error
                                    return; 
                                }

                                $('#idStatusSection').slideDown();
                                $('#idStatusText').text("Item: " + res.item.itemName);
                                $('#idTargetInfo').text(res.item.vin);
                                
                                // Always enable Label if Tag is valid
                                $('#labelInput, .btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);

                                // If Label is present, enable Kanban and Focus it
                                if (label) {
                                    $('#kanbanInput, .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                                    // AUTOMATION: Open Kanban Scanner
                                    setTimeout(() => {
                                        if (!$('#scannerModal').is(':visible')) {
                                            $('.btn-scan-trigger[data-target="kanbanInput"]').click();
                                        }
                                    }, 500);
                                } else {
                                     // AUTOMATION: Open Label Scanner
                                    setTimeout(() => {
                                        if (!$('#scannerModal').is(':visible')) {
                                            $('.btn-scan-trigger[data-target="labelInput"]').click();
                                        }
                                    }, 500);
                                }
                            }
                        } else {
                            if (res.message) alert(res.message);
                            resetInputs();
                            $('#tagInput').focus();
                        }
                    },
                    error: function() {
                         alert("Gagal menghubungi server.");
                    }
                });
            }

            $('#btnSavePreparation').click(function () {
                const data = {
                    Tag: $('#tagInput').val().trim(),
                    Label: $('#labelInput').val().trim(),
                    Kanban: $('#kanbanInput').val().trim()
                };

                if (!data.Tag || !data.Label || !data.Kanban) return; 

                const $btn = $(this);
                $btn.prop('disabled', true);
                $('#prepLoadingIndicator').show();

                $.ajax({
                    url: '/PreparationWorkflow/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            if (res.isFallback || (res.message && res.message.includes("FIFO"))) {
                                alert(res.message);
                            }
                            location.reload();
                        } else {
                            alert(res.message);
                            $btn.prop('disabled', false);
                            $('#prepLoadingIndicator').hide();
                            $('#kanbanInput').val('').focus();
                        }
                    },
                    error: function() {
                         alert("Connection Error");
                         $btn.prop('disabled', false);
                         $('#prepLoadingIndicator').hide();
                    }
                });
            });

        });
    </script>
}
