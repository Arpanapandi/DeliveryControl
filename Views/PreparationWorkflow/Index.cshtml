@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Workflow Scanner";
}

<!-- Custom Styles -->
<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .scanner-top-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 2rem;
    }

    .custom-cyber-input-group {
        display: flex;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        overflow: hidden;
    }
    
    .input-icon-left {
        display: flex;
        align-items: center;
        padding: 0 12px;
        color: rgba(255, 255, 255, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .cyber-field {
        background: transparent !important;
        border: none !important;
        color: white !important;
        padding: 10px 12px !important;
        width: 100%;
        font-size: 0.9rem;
    }
    
    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        padding: 0 12px;
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

    /* Progress Table Styles */
    .progress-table-container {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        overflow: hidden;
        margin-top: 1.5rem;
    }

    .cyber-table {
        width: 100%;
        margin-bottom: 0;
        color: white;
        border-collapse: separate;
        border-spacing: 0;
    }

    .cyber-table th {
        background: rgba(0,0,0,0.3);
        color: var(--cyber-yellow);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 12px 15px;
        border-bottom: 2px solid var(--cyber-border);
    }

    .cyber-table td {
        padding: 12px 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle;
    }

    .item-row.highlight-row {
        background: rgba(250, 204, 21, 0.1) !important;
        border-left: 4px solid var(--cyber-yellow);
        animation: row-glow 1s infinite alternate;
    }

    @@keyframes row-glow {
        from { background: rgba(250, 204, 21, 0.05); }
        to { background: rgba(250, 204, 21, 0.2); }
    }

    .progress-mini {
        height: 6px;
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
        margin-top: 4px;
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
    }

    /* Floating Progress Area (Success Dialog) */
    .progress-detail-container {
        display: none;
        background: #0f172a;
        border: 2px solid var(--cyber-yellow);
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    /* Scanner Video Fix */
    #reader video {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
    }

    /* Scanner Overlay & Bounding Box */
    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 20;
    }

    .bounding-box {
        width: 320px;
        height: 180px;
        position: relative;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.4);
        border: 2px solid var(--cyber-yellow);
        border-radius: 4px;
    }
    
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2.5s ease-in-out infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 100%; opacity: 0; }
    }

    .scanner-tip {
        color: white;
        font-size: 0.75rem;
        margin-top: 15px;
        background: rgba(0,0,0,0.6);
        padding: 4px 12px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-warning"></i> Input Progress Preparation</h2>
            <p class="text-secondary mb-0">Scan VIN (Tag), Label, dan Kanban untuk update progres.</p>
        </div>

    </div>

    <!-- Scanner Section -->
    <div class="scanner-top-bar shadow-sm">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label mb-1 text-white-50 small fw-bold text-uppercase">VIN (TAG)</label>
                <div class="custom-cyber-input-group">
                    <div class="input-icon-left"><i class="bi bi-tag-fill"></i></div>
                    <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Scan VIN..." autofocus>
                    <button type="button" class="btn-scan-trigger" data-target="tagInput"><i class="bi bi-qr-code-scan"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1 text-white-50 small fw-bold text-uppercase">LABEL CUSTOMER</label>
                <div class="custom-cyber-input-group">
                    <div class="input-icon-left"><i class="bi bi-upc-scan"></i></div>
                    <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Scan Label..." disabled>
                    <button type="button" class="btn-scan-trigger" data-target="labelInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1 text-white-50 small fw-bold text-uppercase">KANBAN CUSTOMER</label>
                <div class="custom-cyber-input-group">
                    <div class="input-icon-left"><i class="bi bi-clipboard-check"></i></div>
                    <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Scan Kanban..." disabled>
                    <button type="button" class="btn-scan-trigger" data-target="kanbanInput" disabled><i class="bi bi-qr-code-scan"></i></button>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="button" class="btn btn-neon-success w-100 py-2 shadow-sm" id="btnSavePreparation">
                    <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA
                </button>
            </div>
        </div>
        
        <!-- Status Identification -->
        <div id="idStatusSection" style="display: none;" class="mt-3 pt-3 border-top border-secondary border-opacity-25 row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center">
                    <div class="spinner-grow spinner-grow-sm text-yellow me-2" role="status"></div>
                    <span id="idStatusText" class="text-white-50 small fw-bold">Mencocokkan data...</span>
                </div>
            </div>
            <div class="col-md-4 text-end">
                 <span id="idTargetInfo" class="badge bg-primary px-3">---</span>
            </div>
        </div>

        <!-- Success Progress Popup (Optional/Dynamic) -->
        <div id="progressDetailArea" class="progress-detail-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-yellow mb-0"><i class="bi bi-check-circle me-2"></i> BERHASIL DI-SCAN: <span id="progressTargetName" class="text-white">---</span></h6>
                <span id="progressPercentTotal" class="badge bg-success">0%</span>
            </div>
            <div id="confirmButtonArea" class="mt-3 text-center" style="display:none;">
                <button type="button" class="btn btn-success btn-sm fw-bold" id="btnConfirmFinal">
                    <i class="bi bi-check-all me-1"></i> KONFIRMASI SELESAI
                </button>
            </div>
        </div>
    </div>


</div>

<!-- Modal Scanner -->
<div class="modal fade" id="scannerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h6 class="modal-title text-white" id="scannerModalLabel">Scanning...</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 position-relative overflow-hidden" style="height: 400px; background: #000;">
                <div id="reader" style="width: 100%; height: 100%;"></div>
                <div class="scanner-overlay">
                    <div class="bounding-box">
                        <div class="scan-line"></div>
                    </div>
                    <div class="scanner-tip" id="scanner-status">Mencari Barcode / QR...</div>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        $(document).ready(function () {
            let html5QrCode = null;
            let scannerModal = new bootstrap.Modal(document.getElementById('scannerModal'));
            let activeInputId = null;
            let currentScheduleId = null;

            // Trigger scanner
            $('.btn-scan-trigger').click(function() {
                activeInputId = $(this).data('target');
                $('#scannerModalLabel').text("MEMINDAI: " + activeInputId.toUpperCase());
                scannerModal.show();
            });

            // Start scanner ONLY after modal is fully shown to ensure container has dimensions
            $('#scannerModal').on('shown.bs.modal', function () {
                initScanner();
            });

            $('#scannerModal').on('hidden.bs.modal', function () {
                stopScanner();
            });

            async function initScanner() {
                try {
                    // Optimized for 1D Barcodes (wider box)
                    const config = { 
                        fps: 25, 
                        aspectRatio: 1.0, 
                        qrbox: { width: 300, height: 150 }, // Rectangular for 1D barcodes
                        showTorchButtonIfSupported: true, // Enable flashlight
                        videoConstraints: {
                            facingMode: "environment",
                            width: { min: 640, ideal: 1280, max: 1920 },
                            height: { min: 480, ideal: 720, max: 1080 }
                        }
                    };
                    
                    if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
                    
                    if (html5QrCode.isScanning) {
                        await html5QrCode.stop();
                    }

                    $('#scanner-status').text("Mengakses Kamera...");
                    await html5QrCode.start({ facingMode: "environment" }, config, onDetected);
                    $('#scanner-status').text("Scanner Aktif");
                    console.log("Scanner started successfully");
                } catch (err) {
                    console.error("Scanner failed to start", err);
                    $('#scanner-status').text("Gagal: " + err);
                    try {
                         if (html5QrCode) await html5QrCode.start({ facingMode: "user" }, { fps: 20, qrbox: { width: 250, height: 250 } }, onDetected);
                    } catch (e2) {
                         alert("Tidak dapat mengakses kamera: " + e2);
                    }
                }
            }

            function onDetected(decodedText) {
                $(`#${activeInputId}`).val(decodedText).addClass('active-scan');
                scannerModal.hide();
                performLookup();
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) await html5QrCode.stop();
            }

            // Trigger lookup on enter or change (for scanners that don't send enter)
            $('#tagInput, #labelInput, #kanbanInput').on('keypress', function(e) {
                if (e.which == 13) {
                    e.preventDefault();
                    performLookup();
                }
            }).on('change', function() {
                if ($(this).val().trim()) performLookup();
            });

            function resetInputs() {
                $('#idStatusSection').slideUp();
                $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', true);
                currentScheduleId = null;
                $('.item-row').removeClass('highlight-row');
            }

            function performLookup() {
                const tag = $('#tagInput').val().trim();
                const label = $('#labelInput').val().trim();
                const kanban = $('#kanbanInput').val().trim();

                if (!tag) return;

                $.ajax({
                    url: '/PreparationWorkflow/LookupSchedule',
                    type: 'GET',
                    data: { tag: tag, label: label, kanban: kanban },
                    success: function(res) {
                        if (res.success) {
                            if (res.found) {
                                currentScheduleId = res.schedule.scheduleId;
                                $('#idStatusSection').slideDown();
                                $('#idStatusText').text("Ditemukan: " + res.schedule.customerName);
                                $('#idTargetInfo').text(res.schedule.scheduleNumber);
                                
                                // Highlight Row
                                $('.item-row').removeClass('highlight-row');
                                $(`.item-row[data-schedule-id="${currentScheduleId}"]`).addClass('highlight-row');
                                
                                // Scroll to row
                                const $firstRow = $(`.item-row[data-schedule-id="${currentScheduleId}"]`).first();
                                if ($firstRow.length) {
                                    $('html, body').animate({
                                        scrollTop: $firstRow.offset().top - 200
                                    }, 500);
                                }

                                $('#labelInput, #kanbanInput, .btn-scan-trigger').prop('disabled', false);
                            } else if (res.item) {
                                // Item identified but not all 3 scans completed
                                $('#idStatusSection').slideDown();
                                $('#idStatusText').text("Item: " + res.item.itemName);
                                $('#idTargetInfo').text(res.item.vin);
                                
                                // Enable inputs progressively
                                const tag = $('#tagInput').val().trim();
                                const label = $('#labelInput').val().trim();
                                
                                if (tag) {
                                    $('#labelInput, .btn-scan-trigger[data-target="labelInput"]').prop('disabled', false);
                                    if (!label) $('#labelInput').focus();
                                }
                                if (label) {
                                    $('#kanbanInput, .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                                    if (!kanban) $('#kanbanInput').focus();
                                }
                                if (tag && label && kanban) {
                                    $('#btnSavePreparation').focus();
                                }
                            }
                        } else {
                            if (res.message) alert(res.message);
                            resetInputs();
                        }
                    }
                });
            }

            $('#btnSavePreparation').click(function () {
                const data = {
                    Tag: $('#tagInput').val().trim(),
                    Label: $('#labelInput').val().trim(),
                    Kanban: $('#kanbanInput').val().trim()
                };

                if (!data.Tag || !data.Label || !data.Kanban) return alert('Data belum lengkap!');

                $(this).prop('disabled', true).html('Saving...');

                $.ajax({
                    url: '/PreparationWorkflow/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            // Reload page to reflect updated counts in the main table
                            location.reload();
                        } else {
                            alert(res.message);
                            $('#btnSavePreparation').prop('disabled', false).html('SIMPAN DATA');
                        }
                    }
                });
            });

            // SignalR for updates
            // (Assumed already set up in layout or needed here)
        });
    </script>
}
