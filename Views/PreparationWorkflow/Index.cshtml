@model IEnumerable<DeliveryControl.Models.DeliverySchedule>
@{
    ViewData["Title"] = "Preparation Gallery Checking";
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="mb-1 text-white fw-bold"><i class="bi bi-truck text-primary me-2"></i> Preparation Delivery Checking</h2>
        <p class="text-secondary">Pengecekan barang di rak Finish Good sebelum dikirim ke Customer.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-12">
        <!-- Target Schedule Info (Appears when VIN/Tag is scanned) -->
        <div id="targetScheduleCard" style="display: none;" class="mb-4">
            <div class="cyber-card p-3 border-primary border-opacity-50 shadow-glow">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-calendar-event me-2"></i> TARGET SCHEDULE</span>
                    <span id="targetDate" class="text-secondary small"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-7 border-end border-secondary border-opacity-25">
                        <div class="mb-2">
                            <label class="text-white-50 small text-uppercase fw-bold d-block">Schedule Number</label>
                            <span id="targetScheduleNumber" class="text-info fs-4 fw-bold"></span>
                        </div>
                        <div>
                            <label class="text-white-50 small text-uppercase fw-bold d-block">Customer</label>
                            <span id="targetCustomerName" class="text-white fs-5 fw-bold"></span>
                        </div>
                    </div>
                    <div class="col-md-5 ps-md-4">
                        <div class="mb-2">
                            <label class="text-white-50 small text-uppercase fw-bold d-block">Docking / Area</label>
                            <span id="targetDock" class="badge bg-secondary fs-6"></span>
                        </div>
                        <div>
                            <label class="text-white-50 small text-uppercase fw-bold d-block">Item Internal (VIN)</label>
                            <span id="targetVin" class="text-warning fs-5 fw-bold"></span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 text-center">
                    <small class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Data sesuai dengan Jadwal Preparation. Silakan scan Barcode Customer.</small>
                </div>
            </div>
        </div>

        <div class="cyber-card p-4">
            <!-- 1. Identifikasi Produk (Tag, Label, Kanban) -->
            <div class="mb-4">
                <label class="form-label fw-bold text-primary mb-3 text-center d-block fs-4"><i class="bi bi-qr-code-scan me-2"></i> Identifikasi Produk</label>
                
                <div class="alert alert-info border-0 bg-primary bg-opacity-10 text-center mb-4">
                    <small><i class="bi bi-info-circle me-1"></i> Scan <strong>Tag, Label, dan Kanban</strong> untuk validasi pengiriman.</small>
                </div>

                <!-- Tag Input Group -->
                <div class="mb-4">
                    <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input VIN (TAG MASTER) <span class="text-danger">*</span></label>
                    <div class="custom-cyber-input-group">
                        <div class="input-icon-left">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Scan VIN...">
                        <button type="button" class="btn-scan-trigger" data-target="tagInput" title="Start Scanning">
                            <i class="bi bi-qr-code-scan"></i>
                        </button>
                    </div>
                </div>

                <!-- Label Input Group -->
                <div class="mb-4">
                    <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Label Customer <span class="text-danger">*</span></label>
                    <div class="custom-cyber-input-group">
                        <div class="input-icon-left">
                            <i class="bi bi-upc-scan"></i>
                        </div>
                        <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Scan Label Customer..." disabled>
                        <button type="button" class="btn-scan-trigger" data-target="labelInput" title="Start Scanning" disabled>
                            <i class="bi bi-qr-code-scan"></i>
                        </button>
                    </div>
                </div>

                <!-- Kanban Input Group -->
                <div class="mb-4">
                    <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Kanban Customer <span class="text-danger">*</span></label>
                    <div class="custom-cyber-input-group">
                        <div class="input-icon-left">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <input type="text" class="form-control cyber-field" id="kanbanInput" placeholder="Scan Kanban Customer..." disabled>
                        <button type="button" class="btn-scan-trigger" data-target="kanbanInput" title="Start Scanning" disabled>
                            <i class="bi bi-qr-code-scan"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-4 pb-2">
                <button type="button" class="btn btn-neon-success w-100 py-3 shadow-lg fs-5" id="btnSavePreparation">
                    <i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA PREPARATION
                </button>
            </div>
        </div>
        
        <div style="height: 100px;"></div>
    </div>
</div>

@section Modals {
    <!-- Scanner Modal -->
    <div class="modal fade" id="scannerModal" tabindex="-1" aria-labelledby="scannerModalLabel" aria-hidden="false" data-bs-backdrop="static" style="z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-darker-card border-primary border-opacity-50 shadow-lg">
                <div class="modal-header border-bottom border-primary border-opacity-25 bg-dark">
                    <h6 class="modal-title text-white" id="scannerModalLabel">
                        <i class="bi bi-camera-fill me-2 text-primary"></i>
                        <span id="currentScanningField">Scanning...</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 position-relative overflow-hidden" style="height: 400px; background: #000;">
                    <div id="reader" style="width: 100%; height: 100%;"></div>
                    <div class="scanner-overlay">
                        <div class="bounding-box">
                            <div class="scan-line"></div>
                            <div class="corner-tl"></div>
                            <div class="corner-tr"></div>
                            <div class="corner-bl"></div>
                            <div class="corner-br"></div>
                        </div>
                        <div class="scanner-tip" id="scanner-status">Mencari Barcode...</div>
                        <button type="button" class="btn btn-sm btn-primary mt-3 px-3 py-1 rounded-pill" id="btnRestartCamera" style="pointer-events: auto; position: relative; z-index: 30;">
                            <i class="bi bi-arrow-clockwise me-1"></i> RESTART KAMERA
                        </button>
                    </div>
                </div>
                <div class="modal-footer border-top border-primary border-opacity-25 bg-dark justify-content-center py-2">
                    <button type="button" class="btn btn-outline-light btn-sm px-4" data-bs-dismiss="modal">BATAL</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        $(document).ready(function () {
            let activeInputId = null;
            let currentScheduleId = null;

            // Scanner Implementation
            const scannerModalElement = document.getElementById('scannerModal');
            const scannerModal = new bootstrap.Modal(scannerModalElement);
            let html5QrCode = null;

            $('.btn-scan-trigger').click(function() {
                if ($(this).prop('disabled')) return;
                activeInputId = $(this).data('target');
                const fieldName = (activeInputId || "").replace('Input', '').toUpperCase();
                $('#currentScanningField').text("Scanning " + fieldName);
                scannerModal.show();
            });

            $(scannerModalElement).on('shown.bs.modal', function () { initScanner(); });
            $(scannerModalElement).on('hidden.bs.modal', function () { stopScanner(); });

            function initScanner() {
                if (!window.isSecureContext) {
                    $('#scanner-status').html('<span class="text-danger">Error: Secure Context Needed</span>');
                    return;
                }
                const config = { fps: 20, aspectRatio: 1.0, showTorchButtonIfSupported: true };
                if (!html5QrCode) html5QrCode = new Html5Qrcode("reader");
                
                html5QrCode.start({ facingMode: "environment" }, config, onDetected)
                    .catch(err => $('#scanner-status').text("Camera Error: " + err));
            }

            function onDetected(decodedText) {
                if (activeInputId) {
                    const currentId = activeInputId;
                    $(`#${currentId}`).val(decodedText).addClass('active-scan');
                    setTimeout(() => $(`#${currentId}`).removeClass('active-scan'), 500);
                    scannerModal.hide();

                    if (currentId === 'tagInput') {
                        lookupSchedule(decodedText);
                    } else if (currentId === 'labelInput') {
                        setTimeout(() => $('.btn-scan-trigger[data-target="kanbanInput"]').click(), 600);
                    } else if (currentId === 'kanbanInput') {
                        setTimeout(() => $('#btnSavePreparation').focus(), 600);
                    }
                }
            }

            async function stopScanner() {
                if (html5QrCode && html5QrCode.isScanning) await html5QrCode.stop();
            }

            // Real-time Lookup
            function lookupSchedule(tag) {
                if (!tag) return;

                $.ajax({
                    url: '/PreparationWorkflow/LookupSchedule',
                    type: 'GET',
                    data: { tag: tag },
                    success: function(res) {
                        if (res.success) {
                            if (res.found) {
                                currentScheduleId = res.schedule.scheduleId;
                                $('#targetScheduleNumber').text(res.schedule.scheduleNumber);
                                $('#targetCustomerName').text(res.schedule.customerName);
                                $('#targetDock').text(res.schedule.dock);
                                $('#targetDate').text(res.schedule.date);
                                $('#targetVin').text(res.item.vin + " (" + res.item.itemName + ")");
                                $('#targetScheduleCard').slideDown();
                                
                                // Enable other inputs
                                $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', false);
                                
                                // Automatic next scan
                                setTimeout(() => $('.btn-scan-trigger[data-target="labelInput"]').click(), 800);
                            } else {
                                resetLookup(res.message);
                                if (res.item) {
                                    $('#targetVin').text(res.item.vin + " (" + res.item.itemName + ")");
                                    $('#targetScheduleNumber').text("NO SCHEDULE");
                                    $('#targetScheduleCard').slideDown();
                                }
                            }
                        } else {
                            alert(res.message);
                            resetLookup();
                        }
                    },
                    error: function() { alert("Error connecting to server."); }
                });
            }

            function resetLookup(msg) {
                if (msg) alert(msg);
                $('#targetScheduleCard').slideUp();
                $('#labelInput, #kanbanInput, .btn-scan-trigger[data-target="labelInput"], .btn-scan-trigger[data-target="kanbanInput"]').prop('disabled', true);
                $('#labelInput, #kanbanInput').val('');
                currentScheduleId = null;
            }

            // Save Data
            $('#btnSavePreparation').click(function () {
                const data = {
                    Tag: $('#tagInput').val().trim(),
                    Label: $('#labelInput').val().trim(),
                    Kanban: $('#kanbanInput').val().trim()
                };

                if (!data.Tag || !data.Label || !data.Kanban) {
                    alert('Lengkapi Tag, Label, dan Kanban!');
                    return;
                }

                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Menyimpan...');

                $.ajax({
                    url: '/PreparationWorkflow/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            $('#tagInput, #labelInput, #kanbanInput').val('');
                            resetLookup();
                            $('#tagInput').focus();
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () { alert('Server error.'); },
                    complete: function() {
                        $('#btnSavePreparation').prop('disabled', false).html('<i class="bi bi-shield-check-fill me-2"></i> SIMPAN DATA PREPARATION');
                    }
                });
            });

            // Initial Focus
            $('#tagInput').focus();
        });
    </script>
}

<style>
    .cyber-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .shadow-glow {
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
    }
    .custom-cyber-input-group {
        display: flex;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        overflow: hidden;
    }
    .input-icon-left {
        display: flex;
        align-items: center;
        padding: 0 15px;
        color: rgba(255, 255, 255, 0.5);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
    .cyber-field {
        background: transparent !important;
        border: none !important;
        color: white !important;
        padding: 12px 15px !important;
        width: 100%;
    }
    .cyber-field:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        padding: 0 15px;
    }
    .btn-scan-trigger:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }
    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }
    .btn-neon-success:hover {
        background: #059669;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
    }
    .active-scan {
        background: rgba(16, 185, 129, 0.1) !important;
    }
    .scanner-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        pointer-events: none;
    }
    .bounding-box {
        width: 250px; height: 150px;
        border: 2px solid rgba(59, 130, 246, 0.5);
        position: relative;
    }
    .scan-line {
        position: absolute; top: 0; left: 0; width: 100%; height: 2px;
        background: #ef4444; box-shadow: 0 0 10px #ef4444;
        animation: scan-line 2s infinite;
    }
    @@keyframes scan-line {
        0% { top: 0; } 100% { top: 100%; }
    }
</style>
