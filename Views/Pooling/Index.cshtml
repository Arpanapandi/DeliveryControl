@{
    ViewData["Title"] = "Pooling Process";
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="mb-1"><i class="bi bi-arrow-down-square text-primary"></i> Pooling Finish Good</h2>
        <p class="text-muted">Proses penyimpanan barang dari line produksi ke rak Rak Finish Good.</p>
    </div>
</div>

<div class="row justify-content-center">
    <!-- Single Full-Width Card -->
    <div class="col-12">
        <div class="cyber-card p-4">
            <h5 class="mb-4 fw-bold border-bottom pb-2"><i class="bi bi-pencil-square me-2"></i> Form Input Pooling</h5>
            
            <div class="mx-auto" style="max-width: 800px;">
                <!-- 1. Pilih Plant -->
                <div class="mb-4">
                    <label class="form-label d-block fw-bold text-primary"><i class="bi bi-building me-2"></i> 1. Pilih Plant</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="plant" id="plantMolded" value="Molded" checked>
                        <label class="btn btn-outline-primary py-3" for="plantMolded">MOLDED</label>

                        <input type="radio" class="btn-check" name="plant" id="plantHose" value="Hose">
                        <label class="btn btn-outline-primary py-3" for="plantHose">HOSE</label>

                        <input type="radio" class="btn-check" name="plant" id="plantRVI" value="RVI">
                        <label class="btn btn-outline-primary py-3" for="plantRVI">RVI</label>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4">

                <!-- 2. Pilih Rak (A-K) -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-primary"><i class="bi bi-grid-3x3 me-2"></i> 2. Pilih Rak (A-K)</label>
                    <div class="rack-segmented-bar d-flex mb-3">
                        @foreach (var letter in "ABCDEFGHIJK")
                        {
                            <div class="rack-segment" data-rack="@letter">@letter</div>
                        }
                    </div>
                </div>

                <!-- 3. Pilih Kolom (Dropdown) -->
                <div class="mb-4" id="columnSelectContainer" style="display: none;">
                    <label class="form-label fw-bold text-primary"><i class="bi bi-list-ol me-2"></i> 3. Pilih Kolom</label>
                    <select class="form-select py-3 bg-dark text-white border-primary border-opacity-25" id="columnSelect">
                        <option value="">-- Click to Select Column --</option>
                        @for (int i = 1; i <= 20; i++)
                        {
                            <option value="@i">Lokasi Kolom @i</option>
                        }
                    </select>
                </div>

                <!-- Visual Validation (Optional Check) -->
                <div id="visualWrapper" style="display: none;" class="mb-4">
                    <div class="p-4 bg-dark-subtle rounded border border-primary border-opacity-10">
                        <small class="text-muted d-block mb-3 text-center text-uppercase fw-bold">Visual Mapping Confirmation</small>
                        <div id="visualGrid" class="row g-2 justify-content-center">
                            <!-- Generated via JS -->
                        </div>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4">

                <!-- 4. Identifikasi Produk (Tag & Label) -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-primary mb-3"><i class="bi bi-qr-code-scan me-2"></i> 4. Identifikasi Produk</label>
                    
                    <!-- Tag Input Group -->
                    <div class="mb-4">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Tag <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left">
                                <i class="bi bi-pencil"></i>
                            </div>
                            <input type="text" class="form-control cyber-field" id="tagInput" placeholder="Ketik manual atau scan...">
                            <button type="button" class="btn-scan-trigger" data-target="tagInput" title="Start Scanning">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Label Input Group -->
                    <div class="mb-4">
                        <label class="form-label mb-2 text-white-50 small fw-bold text-uppercase">Input Label <span class="text-danger">*</span></label>
                        <div class="custom-cyber-input-group">
                            <div class="input-icon-left">
                                <i class="bi bi-pencil"></i>
                            </div>
                            <input type="text" class="form-control cyber-field" id="labelInput" placeholder="Ketik manual atau scan...">
                            <button type="button" class="btn-scan-trigger" data-target="labelInput" title="Start Scanning">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Scanner Viewport (Hidden by default) -->
                    <div class="cyber-card p-0 mb-4 overflow-hidden" id="scannerContainer" style="display: none; min-height: 350px; position: relative; border: 2px solid var(--primary-blue);">
                        <div class="scanner-header p-2 bg-primary d-flex justify-content-between align-items-center">
                            <small id="currentScanningField" class="fw-bold text-white"><i class="bi bi-camera me-2"></i>Camera Active...</small>
                            <button type="button" class="btn btn-light btn-sm py-0" id="btnStopScanner">STOP</button>
                        </div>
                        <div id="interactive" class="viewport" style="position: relative;">
                            <div class="scanner-overlay"><div class="bounding-box"></div></div>
                        </div>
                    </div>
                </div>

                <div class="mt-5">
                    <button type="button" class="btn btn-neon-success w-100 py-4 shadow-lg fs-5" id="btnSavePooling">
                        <i class="bi bi-cloud-arrow-up-fill me-2"></i> SIMPAN DATA POOLING
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quagga@0.12.1/dist/quagga.min.js"></script>
    <script>
        $(document).ready(function () {
            let activeInputId = null;
            let currentRack = null;

            // Rack Selection -> Show Column Dropdown
            $('.rack-segment').click(function() {
                $('.rack-segment').removeClass('active');
                $(this).addClass('active');
                
                currentRack = $(this).data('rack');
                $('#columnSelectContainer').fadeIn();
                $('#columnSelect').val(''); // Reset column selection
                $('#visualWrapper').fadeOut();
            });

            // Column Selection -> Show Visual Mapping (Optional)
            $('#columnSelect').change(function() {
                const column = $(this).val();
                if(!column) {
                    $('#visualWrapper').fadeOut();
                    return;
                }
                
                $('#visualWrapper').fadeIn();
                generateVisualGrid(currentRack, column);
            });

            function generateVisualGrid(rack, selectedColumn) {
                let html = '';
                for(let i=1; i<=20; i++) {
                    const activeClass = (i == selectedColumn) ? 'bg-primary text-white border-primary' : 'bg-dark text-muted opacity-50';
                    const glowClass = (i == selectedColumn) ? 'selected-glow' : '';
                    html += `
                        <div class="col-auto">
                            <div class="visual-col-box ${activeClass} ${glowClass}">
                                ${i}
                            </div>
                        </div>
                    `;
                }
                $('#visualGrid').html(html);
            }

            // Scan Trigger Buttons
            $('.btn-scan-trigger').click(function() {
                const target = $(this).data('target');
                const $btn = $(this);
                
                if ($btn.hasClass('active-scanning')) {
                    stopScanner();
                } else {
                    $('.btn-scan-trigger').removeClass('active-scanning');
                    $btn.addClass('active-scanning');
                    activeInputId = target;
                    startScanner(target);
                }
            });

            $('#btnStopScanner').click(stopScanner);

            function startScanner(target) {
                $('#scannerContainer').fadeIn();
                $('#currentScanningField').html("<i class='bi bi-camera me-2'></i>Scanning " + target.replace('Input', '').toUpperCase());
                
                Quagga.init({
                    inputStream: {
                        name: "Live",
                        type: "InputStream",
                        target: document.querySelector('#interactive'),
                        constraints: { facingMode: "environment" },
                    },
                    decoder: {
                        readers: ["code_128_reader", "ean_reader", "code_39_reader"]
                    },
                    locate: true
                }, function (err) {
                    if (err) { alert("Camera Access Error: " + err); return; }
                    Quagga.start();
                });

                Quagga.onDetected(function (result) {
                    const code = result.codeResult.code;
                    $(`#${activeInputId}`).val(code).addClass('active-scan');
                    setTimeout(() => $(`#${activeInputId}`).removeClass('active-scan'), 500);
                    stopScanner();
                });
            }

            function stopScanner() {
                if (Quagga) Quagga.stop();
                $('#scannerContainer').hide();
                $('.btn-scan-trigger').removeClass('active-scanning');
                activeInputId = null;
            }

            // Save Data (AJAX)
            $('#btnSavePooling').click(function () {
                const plant = $('input[name="plant"]:checked').val();
                const rack = $('.rack-btn.active').data('rack');
                const column = $('#columnSelect').val();
                const tag = $('#tagInput').val();
                const label = $('#labelInput').val();

                if (!rack || !column || !tag || !label) {
                    alert('Lengkapi semua data yang WAJIB (Rack, Column, Tag, Label)!');
                    return;
                }

                const data = {
                    Plant: plant,
                    Rack: rack,
                    Column: parseInt(column),
                    Tag: tag,
                    Label: label
                };

                $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Menyimpan...');

                $.ajax({
                    url: '/Pooling/Save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {
                        if (response.success) {
                            alert('SUKSES: ' + response.message);
                            // Reset location elements but NOT plant
                            $('#tagInput, #labelInput').val('');
                            $('#columnSelect').val('');
                            $('.rack-btn').removeClass('active btn-primary').addClass('btn-outline-light');
                            $('#columnSelectContainer, #visualWrapper').hide();
                        } else {
                            alert('GAGAL: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Terjadi kesalahan koneksi ke server.');
                    },
                    complete: function() {
                        $('#btnSavePooling').prop('disabled', false).html('<i class="bi bi-cloud-arrow-up-fill me-2"></i> SIMPAN DATA POOLING');
                    }
                });
            });
        });
    </script>
}

<style>
    .rack-segmented-bar {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        width: 100%;
    }

    .rack-segment {
        flex: 1;
        text-align: center;
        padding: 15px 0;
        cursor: pointer;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.7);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.2s ease;
        font-size: 1.1rem;
    }

    .rack-segment:last-child {
        border-right: none;
    }

    .rack-segment:hover {
        background: rgba(59, 130, 246, 0.1);
        color: white;
    }

    .rack-segment.active {
        background: var(--primary-blue);
        color: white;
        box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.2);
    }

    .visual-col-box {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: bold;
        border-radius: 4px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    /* CUSTOM INPUT GROUP DESIGN (MATCHING IMAGE) */
    .custom-cyber-input-group {
        display: flex;
        align-items: stretch;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .custom-cyber-input-group:focus-within {
        border-color: var(--primary-blue);
        box-shadow: 0 0 12px rgba(59, 130, 246, 0.2);
        background: rgba(30, 41, 59, 0.6);
    }

    .input-icon-left {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 15px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.2rem;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cyber-field {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        color: white !important;
        padding: 14px 18px !important;
        font-size: 1rem;
        flex-grow: 1;
    }

    .cyber-field::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .btn-scan-trigger {
        background: transparent;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        padding: 0 18px;
        font-size: 1.4rem;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-scan-trigger:hover {
        background: rgba(59, 130, 246, 0.1);
        color: var(--primary-blue);
    }

    .btn-scan-trigger.active-scanning {
        background: var(--primary-blue);
        color: white;
        animation: pulse-scanner 1.5s infinite;
    }

    @@keyframes pulse-scanner {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }

    .btn-neon-success {
        background: #10b981;
        color: white;
        font-weight: 700;
        border: none;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
    }

    .btn-neon-success:hover {
        background: #059669;
        transform: translateY(-2px);
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.5);
        color: white;
    }

    .selected-glow {
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.8);
        animation: pulse-primary 1.5s infinite;
    }

    @@keyframes pulse-primary {
        0% { opacity: 1; }
        50% { opacity: 0.7; }
        100% { opacity: 1; }
    }

    .scanner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .bounding-box {
        width: 80%;
        height: 120px;
        border: 2px solid #3b82f6;
        box-shadow: 0 0 0 1000px rgba(0, 0, 0, 0.6);
        position: relative;
    }

    .bounding-box::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: #ef4444;
        box-shadow: 0 0 15px #ef4444;
        animation: scan-line 2.5s linear infinite;
    }

    @@keyframes scan-line {
        0% { top: 0; }
        100% { top: 100%; }
    }

    #interactive video {
        width: 100%;
        height: auto;
        max-height: 400px;
        object-fit: cover;
    }

    .active-scan {
        background: rgba(16, 185, 129, 0.2) !important;
        border-color: #10b981 !important;
    }
</style>
