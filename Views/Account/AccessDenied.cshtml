@{
    ViewData["Title"] = "Akses Ditolak";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body py-5">
                <i class="bi bi-shield-x" style="font-size:4rem;color:#ef4444;"></i>
                <h2 class="mt-3 text-danger">Akses Ditolak</h2>
                @if (TempData["ErrorMessage"] != null)
                {
                    <p class="text-muted mt-2">@TempData["ErrorMessage"]</p>
                }
                else
                {
                    <p class="text-muted mt-2">Anda tidak memiliki izin untuk mengakses halaman tersebut.</p>
                }
                <div class="mt-4 d-flex gap-2 justify-content-center">
                    <a onclick="history.back()" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Kembali
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
