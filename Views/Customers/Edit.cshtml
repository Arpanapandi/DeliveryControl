@model DeliveryControl.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-pencil-square"></i> Edit Customer</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Customer</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> Form Edit Customer</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerCode" class="form-label"></label>
                            <input asp-for="CustomerCode" class="form-control" placeholder="Nama Customer (PT...)" />
                            <span asp-validation-for="CustomerCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Dock..." />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Route" class="form-label"></label>
                            <input asp-for="Route" class="form-control" />
                            <span asp-validation-for="Route" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cycle" class="form-label"></label>
                            <input asp-for="Cycle" class="form-control" />
                            <span asp-validation-for="Cycle" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Docking" class="form-label"></label>
                            <input asp-for="Docking" class="form-control" placeholder="08:00" />
                            <span asp-validation-for="Docking" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Pickup" class="form-label"></label>
                            <input asp-for="Pickup" class="form-control" placeholder="10:00" />
                            <span asp-validation-for="Pickup" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ETD" class="form-label"></label>
                            <input asp-for="ETD" class="form-control" placeholder="12:00" />
                            <span asp-validation-for="ETD" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Range (Auto)</label>
                            <input type="text" class="form-control" value="@Model.Range" readonly disabled style="background-color: #e9ecef;" />
                            <small class="text-muted">Dihitung otomatis dari ETD - Pickup</small>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SKID" class="form-label"></label>
                            <input asp-for="SKID" class="form-control" type="text" />
                            <span asp-validation-for="SKID" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Area" class="form-label"></label>
                            <input asp-for="Area" class="form-control" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">
                                Status Aktif
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Batal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> Informasi</h6>
            </div>
            <div class="card-body">
                <p class="small">
                    <strong>Dibuat:</strong><br />
                    @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")
                </p>
                @if (Model.UpdatedDate.HasValue)
                {
                    <p class="small">
                        <strong>Terakhir Diupdate:</strong><br />
                        @Model.UpdatedDate.Value.ToString("dd MMM yyyy HH:mm")
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

