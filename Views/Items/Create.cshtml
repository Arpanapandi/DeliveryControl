@model DeliveryControl.Models.Item

@{
    ViewData["Title"] = "Tambah Item";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-box"></i> Tambah Item Baru</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Item</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tambah</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> Form Data Item</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ItemCode" class="form-label"></label>
                            <input asp-for="ItemCode" class="form-control" placeholder="Contoh: ITEM001" />
                            <span asp-validation-for="ItemCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ItemName" class="form-label"></label>
                            <input asp-for="ItemName" class="form-control" placeholder="Nama Item" />
                            <span asp-validation-for="ItemName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Deskripsi item (opsional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Unit" class="form-label"></label>
                            <input asp-for="Unit" class="form-control" placeholder="Contoh: PCS, KG, BOX" />
                            <span asp-validation-for="Unit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label"></label>
                            <input asp-for="Category" class="form-control" placeholder="Kategori item" />
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Weight" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Weight" class="form-control" placeholder="0.00" type="number" step="0.01" />
                                <span class="input-group-text">KG</span>
                            </div>
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Volume" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Volume" class="form-control" placeholder="0.00" type="number" step="0.01" />
                                <span class="input-group-text">M³</span>
                            </div>
                            <span asp-validation-for="Volume" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="MinStock" class="form-label">Min Stock (Shortage Target)</label>
                            <input asp-for="MinStock" class="form-control" type="number" value="5" />
                            <span asp-validation-for="MinStock" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxStock" class="form-label">Max Stock (Overstock Target)</label>
                            <input asp-for="MaxStock" class="form-control" type="number" value="20" />
                            <span asp-validation-for="MaxStock" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label">
                                Status Aktif
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Batal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Simpan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informasi</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    <strong>Kode Item:</strong> Kode unik untuk identifikasi item. Contoh: ITEM001, PROD-A, dll.
                </p>
                <p class="small text-muted">
                    <strong>Unit:</strong> Satuan pengukuran item (PCS, KG, BOX, PALLET, dll).
                </p>
                <p class="small text-muted">
                    <strong>Weight & Volume:</strong> Berat dalam KG dan volume dalam M³. Data ini opsional.
                </p>
                <p class="small text-muted">
                    <strong>Status Aktif:</strong> Centang jika item masih aktif digunakan.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

