@model DeliveryControl.Models.StockDashboardViewModel
@{
    ViewData["Title"] = Model.PlantName + " Transactions";
    var selectedDate = ViewBag.SelectedDate as string;
}

<div class="row mb-3">
    <div class="col-12">
        <div class="header-main-row mb-3">
            <div class="header-title-section">
                <i class="bi bi-clock-history fs-4 text-primary"></i>

                <h1 class="h5 fw-bold mb-0 text-white text-nowrap">@Model.PlantName - Transaction Logs</h1>
            </div>

            <div class="custom-filter-bar">
                <div class="search-box-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="logSearch" class="custom-search-input" placeholder="Cari Tag atau Kanban...">
                </div>

                <form method="get" class="d-flex gap-2 align-items-center">
                    <div class="filter-group">
                        <span class="filter-label">Tanggal:</span>
                        <input type="date" name="date" class="custom-date-input" value="@selectedDate" onchange="this.form.submit()" />
                    </div>
                    <div class="filter-group">
                        <span class="filter-label">Periode:</span>
                        <select name="period" class="custom-select-input" onchange="this.form.submit()">
                            <option value="Day" selected='@(ViewBag.SelectedPeriod == "Day")'>Day</option>
                            <option value="Week" selected='@(ViewBag.SelectedPeriod == "Week")'>Week</option>
                            <option value="Month" selected='@(ViewBag.SelectedPeriod == "Month")'>Month</option>
                            <option value="Year" selected='@(ViewBag.SelectedPeriod == "Year")'>Year</option>
                        </select>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- Dashboard Sub-Menu Navigation -->
        <div class="dashboard-nav-wrapper mb-2">
            <div class="nav-links-container">
                <a asp-controller="Stock" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-columns-gap"></i>
                    <span>Overall Stock</span>
                </a>
                <a asp-controller="Stock" asp-action="Molded" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Molded" ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Transaction Molded</span>
                </a>
                <a asp-controller="Stock" asp-action="Hose" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Hose" ? "active" : "")">
                    <i class="bi bi-layers"></i>
                    <span>Transaction Hose</span>
                </a>
                <a asp-controller="Stock" asp-action="RVI" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "RVI" ? "active" : "")">
                    <i class="bi bi-cpu"></i>
                    <span>Transaction RVI</span>
                </a>
                <a asp-controller="Stock" asp-action="Trend" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Trend" ? "active" : "")">
                    <i class="bi bi-graph-up"></i>
                    <span>Trend Stock</span>
                </a>
                <a asp-controller="Stock" asp-action="TrendCriticalStock" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "TrendCriticalStock" ? "active" : "")" style="color: #f59e0b;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Critical Stock</span>
                </a>
            </div>
        </div>
        <hr class="mt-0 opacity-25" />
    </div>
</div>

<style>
    /* ========================================
       DASHBOARD SUB-MENU NAV STYLING
       ======================================== */
    .dashboard-nav-wrapper {
        border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    }

    .nav-links-container {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .nav-link-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-decoration: none;
        padding: 10px 0px;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
        border-bottom: 2px solid transparent;
    }

    .nav-link-item i {
        font-size: 1rem;
    }

    .nav-link-item:hover {
        color: #fff;
    }

    .nav-link-item.active {
        color: #3b82f6;
        border-bottom-color: #3b82f6;
    }

    .nav-link-item.active i {
        color: #3b82f6;
    }
</style>

<div id="transactionLogsContent">
<div class="row">
    <!-- Pulling History (IN) -->
    <div class="col-md-6 mb-4">
        <div class="cyber-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary"><i class="bi bi-arrow-down-circle me-2"></i> Pulling (IN)</h5>
                <span class="badge bg-primary">@Model.RecentPulling.Count Records</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Time</th>
                            <th>Stok</th>
                            <th>Tag</th>
                            <th>Label</th>
                            <th>Rak & No Rak</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.RecentPulling)
                        {
                            <tr>
                                <td class="small">@record.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="small">@record.CreatedDate.ToString("HH:mm:ss")</td>
                                <td><span class="badge bg-dark border border-primary text-primary">1 Box</span></td>
                                <td><span class="text-primary fw-bold">@record.Tag</span></td>
                                <td>@record.Label</td>
                                <td class="small text-truncate" style="max-width: 150px;">
                                    @((record.Rack ?? "-") + "." + record.Column)
                                </td>
                                <td class="smaller">@record.CreatedBy</td>
                            </tr>
                        }
                        @if (!Model.RecentPulling.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted small">Tidak ada data pulling pada tanggal ini.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Preparation History (OUT) -->
    <div class="col-md-6 mb-4">
        <div class="cyber-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-info"><i class="bi bi-truck me-2"></i> Preparation (OUT)</h5>
                <span class="badge bg-info text-dark">@Model.RecentPreparation.Count Records</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Time</th>
                            <th>Tag</th>
                            <th>Label</th>
                            <th>Kanban</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.RecentPreparation)
                        {
                            <tr>
                                <td class="small">@record.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="small">@record.CreatedDate.ToString("HH:mm:ss")</td>
                                <td><span class="text-info fw-bold">@record.Tag</span></td>
                                <td>@record.Label</td>
                                <td><span class="badge bg-info text-dark">@record.Kanban</span></td>
                                <td class="smaller">@record.CreatedBy</td>
                            </tr>
                        }
                        @if (!Model.RecentPreparation.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted small">Tidak ada data preparation pada tanggal ini.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<div class="row mt-2 mb-4">
    <div class="col-12 text-center">
        <partial name="_Pager" model='new { CurrentPage = ViewBag.CurrentPage, TotalPages = ViewBag.TotalPages, TotalItems = ViewBag.TotalItems, RouteData = ViewBag.RouteData }' />
    </div>
</div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/stockHub")
                .withAutomaticReconnect()
                .build();

            connection.on("updateStock", function () {
                refreshLogs();
            });

            connection.start().catch(err => console.error(err.toString()));

            function refreshLogs() {
                const date = $('input[name="date"]').val() || '';
                const period = $('select[name="period"]').val() || 'Day';
                const plant = "@Model.PlantName";
                const urlParams = new URLSearchParams(window.location.search);
                const pageNumber = urlParams.get('pageNumber') || '1';
                
                $.ajax({
                    url: `/Stock/${plant}?date=${date}&period=${period}&pageNumber=${pageNumber}`,
                    type: 'GET',
                    success: function (html) {
                        const newContent = $(html).find('#transactionLogsContent').html();
                        $('#transactionLogsContent').fadeOut(200, function() {
                            $(this).html(newContent).fadeIn(200);
                            bindFilterEvents();
                        });
                    }
                });
            }

            function bindFilterEvents() {
                $('#logSearch').off('keyup').on('keyup', function() {
                    var value = $(this).val().toLowerCase();
                    $(".table tbody tr").filter(function() {
                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                    });
                });
            }

            bindFilterEvents();
        });
    </script>
}
