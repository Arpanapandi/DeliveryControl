@model DeliveryControl.Models.StockDashboardViewModel
@{
    ViewData["Title"] = Model.PlantName + " Transactions";
    var selectedDate = ViewBag.SelectedDate as string;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1"><i class="bi bi-clock-history text-primary"></i> @Model.PlantName - Transaction Logs</h2>
                <p class="text-muted">History of Pooling (IN) and Preparation (OUT)</p>
            </div>
            <div class="text-end">
                <div class="d-flex gap-3 align-items-center">
                    <div class="input-group input-group-sm" style="max-width: 250px;">
                        <span class="input-group-text bg-dark border-primary text-primary"><i class="bi bi-search"></i></span>
                        <input type="text" id="logSearch" class="form-control bg-dark text-white border-primary" placeholder="Cari Tag atau Kanban...">
                    </div>
                    <form method="get" class="d-flex gap-2 align-items-center">
                        <label class="small text-muted text-nowrap">Tanggal:</label>
                        <input type="date" name="date" class="form-control form-control-sm bg-dark text-white border-primary" value="@selectedDate" />
                        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                        <a asp-action="@Model.PlantName" class="btn btn-outline-secondary btn-sm">Reset</a>
                    </form>
                </div>
            </div>
        </div>
        <hr />
    </div>
</div>

<div class="row">
    <!-- Pooling History (IN) -->
    <div class="col-md-6 mb-4">
        <div class="cyber-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary"><i class="bi bi-arrow-down-circle me-2"></i> Pooling (IN)</h5>
                <span class="badge bg-primary">@Model.RecentPooling.Count Records</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Stok</th>
                            <th>Tag</th>
                            <th>Label</th>
                            <th>Item Name</th>
                            <th>Operator</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.RecentPooling)
                        {
                            <tr>
                                <td class="small">@record.CreatedDate.ToString("HH:mm:ss")</td>
                                <td><span class="badge bg-dark border border-primary text-primary">1 Box</span></td>
                                <td><span class="text-primary fw-bold">@record.Tag</span></td>
                                <td>@record.Label</td>
                                <td class="small text-truncate" style="max-width: 150px;">@(record.Item?.ItemName ?? "N/A")</td>
                                <td class="smaller">@record.CreatedBy</td>
                            </tr>
                        }
                        @if (!Model.RecentPooling.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted small">Tidak ada data pooling pada tanggal ini.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Preparation History (OUT) -->
    <div class="col-md-6 mb-4">
        <div class="cyber-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-info"><i class="bi bi-truck me-2"></i> Preparation (OUT)</h5>
                <span class="badge bg-info text-dark">@Model.RecentPreparation.Count Records</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Tag</th>
                            <th>Label</th>
                            <th>Kanban</th>
                            <th>Operator</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.RecentPreparation)
                        {
                            <tr>
                                <td class="small">@record.CreatedDate.ToString("HH:mm:ss")</td>
                                <td><span class="text-info fw-bold">@record.Tag</span></td>
                                <td>@record.Label</td>
                                <td><span class="badge bg-info text-dark">@record.Kanban</span></td>
                                <td class="smaller">@record.CreatedBy</td>
                            </tr>
                        }
                        @if (!Model.RecentPreparation.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted small">Tidak ada data preparation pada tanggal ini.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#logSearch').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $(".table tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
