@model DeliveryControl.Models.StockDashboardViewModel
@{
    ViewData["Title"] = "Molded Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1"><i class="bi bi-grid-3x3-gap text-primary"></i> Stock Dashboard - Molded</h2>
                <p class="text-muted">Monitoring stock flows for Molded Plant: Pooling -> Storage -> Delivery</p>
            </div>
            <div class="text-end">
                <div class="d-flex gap-2">
                    <a asp-controller="Pooling" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> New Pooling
                    </a>
                    <a asp-controller="PreparationWorkflow" asp-action="Index" class="btn btn-primary btn-sm">
                        <i class="bi bi-truck me-1"></i> New Preparation
                    </a>
                </div>

            </div>
        </div>
        <hr />
    </div>
</div>

<div id="dashboardContent">
    <div class="row">
        <!-- Status Indicator Cards -->
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-danger indicator-card clickable" data-filter="Shortage" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Shortage</small>
                <h2 class="fw-bold mb-0 text-danger">@Model.ShortageCount</h2>
                <small class="text-white-50">Low Stock Items</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-success indicator-card clickable" data-filter="Normal" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Normal</small>
                <h2 class="fw-bold mb-0 text-success">@Model.NormalCount</h2>
                <small class="text-white-50">Safe Stock Items</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-info indicator-card clickable" data-filter="Over" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Over</small>
                <h2 class="fw-bold mb-0 text-info">@Model.OverCount</h2>
                <small class="text-white-50">Excessive Stock</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center">
                <div class="status-indicator-live active"></div>
                <small class="text-muted d-block text-uppercase">Stock Level</small>
                <h2 class="fw-bold mb-0 text-white fs-4">@Model.NetStock Total</h2>
                <small class="text-white-50">Items in Storage</small>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Detailed Data Table -->
        <div class="col-12 mb-4">
            <div class="cyber-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <span class="fw-bold text-primary"><i class="bi bi-list-ul me-2"></i> Detail Data Barang</span>
                    
                    <!-- Search and Filter Controls -->
                    <div class="d-flex gap-3 align-items-center flex-grow-1 justify-content-end">
                        <div class="input-group input-group-sm" style="max-width: 300px;">
                            <span class="input-group-text bg-dark border-primary text-primary"><i class="bi bi-search"></i></span>
                            <input type="text" id="tagLabelSearch" class="form-control bg-dark text-white border-primary" placeholder="Cari Tag atau Label...">
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span id="activeFilterLabel" class="badge bg-primary">All Items</span>
                            <button id="btnClearFilter" class="btn btn-outline-secondary btn-xs" style="font-size: 0.6rem;">Clear</button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="stockDetailTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Tag</th>
                                <th>Label</th>
                                <th>Time</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Operator</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.StockDetails)
                            {
                                <tr class="stock-row" data-status="@record.Status">
                                    <td>@record.No</td>
                                    <td><span class="text-primary fw-bold">@record.Tag</span></td>
                                    <td>@record.Label</td>
                                    <td>@record.Time</td>
                                    <td>@record.Date</td>
                                    <td><span class="badge bg-dark border border-primary">@record.Location</span></td>
                                    <td>@record.Operator</td>
                                </tr>
                            }
                            @if (!Model.StockDetails.Any())
                            {
                                <tr><td colspan="7" class="text-center py-5 text-muted small">Tidak ada data barang dalam stok.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Setup SignalR
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/stockHub")
                .withAutomaticReconnect()
                .build();

            connection.on("UpdateStock", function () {
                console.log("Stock update received! Refreshing dashboard...");
                refreshDashboard();
            });

            connection.start().catch(err => console.error(err.toString()));

            function refreshDashboard() {
                $.ajax({
                    url: window.location.href,
                    type: 'GET',
                    success: function (html) {
                        const newContent = $(html).find('#dashboardContent').html();
                        $('#dashboardContent').fadeOut(200, function() {
                            $(this).html(newContent).fadeIn(200);
                            // Re-bind click events after refresh
                            bindFilterEvents();
                        });
                    }
                });
            }

            // Filtering Logic
            let currentStatusFilter = 'All';

            function bindFilterEvents() {
                $('.indicator-card.clickable').off('click').on('click', function() {
                    currentStatusFilter = $(this).data('filter');
                    applyAllFilters();
                });

                $('#btnClearFilter').off('click').on('click', function() {
                    currentStatusFilter = 'All';
                    $('#tagLabelSearch').val('');
                    applyAllFilters();
                });

                $('#tagLabelSearch').off('input').on('input', function() {
                    applyAllFilters();
                });
            }

            function applyAllFilters() {
                const searchText = $('#tagLabelSearch').val().toLowerCase();
                console.log("Applying filters:", currentStatusFilter, searchText);
                
                // Update indicator card visual state
                $('.indicator-card').removeClass('active-filter').css('opacity', '0.5');
                
                if (currentStatusFilter === 'All') {
                    $('.indicator-card').css('opacity', '1');
                    $('#activeFilterLabel').text('All Items').removeClass().addClass('badge bg-primary');
                } else {
                    $(`.indicator-card[data-filter="${currentStatusFilter}"]`).addClass('active-filter').css('opacity', '1');
                    
                    let badgeClass = 'bg-secondary';
                    if (currentStatusFilter === 'Shortage') badgeClass = 'bg-danger';
                    if (currentStatusFilter === 'Normal') badgeClass = 'bg-success';
                    if (currentStatusFilter === 'Over') badgeClass = 'bg-info text-dark';
                    $('#activeFilterLabel').text('Status: ' + currentStatusFilter).removeClass().addClass('badge ' + badgeClass);
                }

                // Filter Rows
                $('.stock-row').each(function() {
                    const rowStatus = $(this).data('status');
                    const tag = $(this).find('td:nth-child(2)').text().toLowerCase();
                    const label = $(this).find('td:nth-child(3)').text().toLowerCase();
                    
                    const matchesStatus = (currentStatusFilter === 'All' || rowStatus === currentStatusFilter);
                    const matchesSearch = (tag.includes(searchText) || label.includes(searchText));
                    
                    if (matchesStatus && matchesSearch) {
                        $(this).fadeIn(200);
                    } else {
                        $(this).fadeOut(100);
                    }
                });
            }

            bindFilterEvents();
        });
    </script>
}

<style>
    .smaller { font-size: 0.75rem; }
    .btn-xs { padding: 0.1rem 0.3rem; font-size: 0.7rem; }
    
    .status-indicator-live {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #94a3b8;
        display: inline-block;
        margin-bottom: 5px;
    }
    .indicator-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-width: 2px !important;
    }
    .indicator-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
    .indicator-card.active-filter {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(255,255,255,0.1);
        border-width: 3px !important;
    }
    .status-indicator-live.active {
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: pulse-live 2s infinite;
    }
    @@keyframes pulse-live {
        0% { opacity: 1; }
        50% { opacity: 0.4; }
        100% { opacity: 1; }
    }
</style>
