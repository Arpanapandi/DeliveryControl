@model DeliveryControl.Models.StockTrendViewModel

@{
    ViewData["Title"] = "Grafik Trend Stok";
}

<div class="header-main-row mb-3">
    <div class="header-title-section">
        <i class="bi bi-graph-up-arrow fs-4 text-primary"></i>
        <h1 class="h5 fw-bold mb-0 text-white text-nowrap">@(Model.ViewMode == "Level" ? "Grafik Level Stok" : "Grafik Trend Stok")</h1>
    </div>

    <div class="custom-filter-bar">
        <!-- View Mode Switch -->
        <div class="btn-group shadow-sm me-2" role="group">
            <a asp-action="Trend" asp-route-period="@Model.FilterPeriod" asp-route-mode="Activity" 
               class="btn btn-sm @(Model.ViewMode == "Activity" ? "btn-primary" : "btn-outline-primary")" title="Tren Aktivitas (Produksi vs Pengiriman)" style="height: 30px; display: flex; align-items: center;">
                <i class="bi bi-activity"></i> <span class="ms-1">Aktivitas</span>
            </a>
            <a asp-action="Trend" asp-route-period="@Model.FilterPeriod" asp-route-mode="Level" 
               class="btn btn-sm @(Model.ViewMode == "Level" ? "btn-primary" : "btn-outline-primary")" title="Tren Level Stok (Kebutuhan vs Aktual)" style="height: 30px; display: flex; align-items: center;">
                <i class="bi bi-bar-chart-steps"></i> <span class="ms-1">Level Stok</span>
            </a>
        </div>

        <div class="dash-v-divider" style="width: 1px; height: 20px; background: rgba(255,255,255,0.1); margin: 0 5px;"></div>

        <!-- Excel Export -->
        <a asp-action="ExportTrendToExcel" class="btn btn-sm btn-success shadow-sm me-2" style="height: 30px; display: flex; align-items: center; gap: 6px; border-radius: 6px; font-size: 0.75rem; font-weight: 600;">
            <i class="bi bi-file-earmark-excel"></i> <span>Template Excel</span>
        </a>

        <!-- Dropdowns & Period -->
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="plantFilterBtn" data-bs-toggle="dropdown" aria-expanded="false" style="height: 30px; font-size: 0.75rem;">
                <i class="bi bi-filter"></i> Semua Plant
            </button>
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="plantFilterBtn">
                <li><a class="dropdown-item active" href="#" onclick="updateMainChart('Overall', 'Semua Plant', this)">Semua Plant</a></li>
                <li><hr class="dropdown-divider opacity-25"></li>
                @foreach (var plant in Model.PlantTrends)
                {
                    <li><a class="dropdown-item" href="#" onclick="updateMainChart('@plant.PlantName', 'Trend @plant.PlantName', this)">@plant.PlantName</a></li>
                }
            </ul>
        </div>
        <div class="btn-group btn-group-sm shadow-sm" role="group">
            <a asp-action="Trend" asp-route-period="Day" asp-route-mode="@Model.ViewMode" class="btn @(Model.FilterPeriod == "Day" ? "btn-primary" : "btn-outline-primary")" style="height: 30px; display: flex; align-items: center; font-size: 0.75rem;">Hari Ini</a>
            <a asp-action="Trend" asp-route-period="Month" asp-route-mode="@Model.ViewMode" class="btn @(Model.FilterPeriod == "Month" ? "btn-primary" : "btn-outline-primary")" style="height: 30px; display: flex; align-items: center; font-size: 0.75rem;">Bulan Ini</a>
            <a asp-action="Trend" asp-route-period="Year" asp-route-mode="@Model.ViewMode" class="btn @(Model.FilterPeriod == "Year" ? "btn-primary" : "btn-outline-primary")" style="height: 30px; display: flex; align-items: center; font-size: 0.75rem;">Tahun Ini</a>
        </div>
    </div>
</div>
    
    <div class="col-12 mt-2">
        <!-- Dashboard Sub-Menu Navigation -->
        <div class="dashboard-nav-wrapper mb-2">
            <div class="nav-links-container">
                <a asp-controller="Stock" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-columns-gap"></i>
                    <span>Overall Stock</span>
                </a>
                <a asp-controller="Stock" asp-action="Molded" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Molded" ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Transaction Molded</span>
                </a>
                <a asp-controller="Stock" asp-action="Hose" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Hose" ? "active" : "")">
                    <i class="bi bi-layers"></i>
                    <span>Transaction Hose</span>
                </a>
                <a asp-controller="Stock" asp-action="RVI" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "RVI" ? "active" : "")">
                    <i class="bi bi-cpu"></i>
                    <span>Transaction RVI</span>
                </a>
                <a asp-controller="Stock" asp-action="Trend" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Trend" ? "active" : "")">
                    <i class="bi bi-graph-up"></i>
                    <span>Trend Stock</span>
                </a>
            </div>
        </div>
        <hr class="mt-0 opacity-25" />
    </div>


<style>
    /* ========================================
       DASHBOARD SUB-MENU NAV STYLING
       ======================================== */
    .dashboard-nav-wrapper {
        border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    }

    .nav-links-container {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .nav-link-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-decoration: none;
        padding: 10px 0px;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
        border-bottom: 2px solid transparent;
    }

    .nav-link-item i {
        font-size: 1rem;
    }

    .nav-link-item:hover {
        color: #fff;
    }

    .nav-link-item.active {
        color: #3b82f6;
        border-bottom-color: #3b82f6;
    }

    .nav-link-item.active i {
        color: #3b82f6;
    }
</style>

<div id="trendDashboardContent">
    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="cyber-card stat-card stat-card-blue p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold" id="fgStockLabel">Total FG Stock</h6>
                        <h2 class="mb-0 fw-bold"><span id="fgStockVal">@Model.TotalFGStock.ToString("N0")</span> <small class="fs-6 fw-normal">BOX</small></h2>
                    </div>
                    <div class="stat-icon-circle bg-primary-subtle text-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cyber-card stat-card stat-card-green p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold">Peak Activity</h6>
                        <h2 class="mb-0 fw-bold"><span id="peakActivityVal">@Model.HighestActivityTarget.ToString("N0")</span> <small class="fs-6 fw-normal">Trx</small></h2>
                    </div>
                    <div class="stat-icon-circle bg-success-subtle text-success">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cyber-card stat-card stat-card-orange p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold">Current Period</h6>
                        <h2 class="mb-0 fw-bold">@Model.FilterPeriod</h2>
                    </div>
                    <div class="stat-icon-circle bg-warning-subtle text-warning">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Overall Trend Chart -->
    <div class="row mb-4" id="mainChartRow">
        <div class="col-12">
            <div class="cyber-card p-4">
                <h5 class="mb-4 fw-bold" id="mainChartTitle"><i class="bi bi-activity text-primary me-2"></i> Trend Aktivitas Keseluruhan (Semua Plant)</h5>
                <div style="height: 350px;">
                    <canvas id="overallTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Plant Specific Trends -->
    <div class="row g-4 mb-4" id="plantTrendsRow">
        @foreach (var plant in Model.PlantTrends)
        {
            <div class="col-md-4 plant-card" data-plant="@plant.PlantName">
                <div class="cyber-card p-4">
                    <h6 class="mb-3 fw-bold"><i class="bi bi-building me-2"></i> Trend @plant.PlantName</h6>
                    <div style="height: 200px;">
                        <canvas id="chart-@plant.PlantName"></canvas>
                    </div>
                    <div class="mt-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Peak: <strong>@plant.PeakActivity</strong></small>
                        <span class="badge bg-primary-subtle text-primary fw-normal">Live Monitoring</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Recent Critical Stocks (Molded, Hose, RVI) -->
    <div class="row g-4 mb-4" id="recentActivitiesRow">
    @{
        var plantsOrder = new[] { 
            new { Name = "MOLDED", Data = Model.RecentMolded, Color = "#3b82f6" },
            new { Name = "HOSE", Data = Model.RecentHose, Color = "#10b981" },
            new { Name = "RVI", Data = Model.RecentRVI, Color = "#f59e0b" }
        };
    }

    @foreach (var p in plantsOrder)
    {
        <div class="col-md-4 plant-recent" data-plant="@p.Name">
            <div class="cyber-card p-0 overflow-hidden" style="border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); background: linear-gradient(145deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%); height: 450px; display: flex; flex-direction: column; transition: all 0.3s ease; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                @{
                    var periodLabel = Model.FilterPeriod == "Month" ? "Bulan Ini" : 
                                     Model.FilterPeriod == "Year" ? "Tahun Ini" : "Hari Ini";
                }
                <div class="p-3 d-flex justify-content-between align-items-center" style="background: rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.1); flex-shrink: 0; z-index: 10;">
                    <h6 class="mb-0 fw-bold text-uppercase" style="letter-spacing: 1.5px; color: @p.Color; font-size: 0.8rem;">Histori @p.Name (@periodLabel)</h6>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center" title="Toggle Auto Scroll">
                            <span class="text-muted me-2" style="font-size: 0.55rem; font-weight: 700; text-transform: uppercase;">Scroll</span>
                            <div class="form-check form-switch m-0 p-0" style="min-height: auto;">
                                <input class="form-check-input scroll-toggle" type="checkbox" checked data-target="@p.Name" style="cursor: pointer; width: 1.8em; height: 0.9em; margin: 0; background-color: rgba(255,255,255,0.1);">
                            </div>
                        </div>
                        <span class="badge bg-primary px-2 py-1" style="font-size: 0.55rem; letter-spacing: 1px; box-shadow: 0 0 15px rgba(59, 130, 246, 0.3); border-radius: 4px;">LIVE</span>
                    </div>
                </div>
                
                <div class="flex-grow-1 d-flex flex-column position-relative overflow-hidden">
                    <div class="table-responsive auto-scroll-container flex-grow-1" id="scroll-container-@p.Name" style="overflow-y: auto; scrollbar-width: none; background: rgba(0,0,0,0.1);">
                        @if (p.Data != null && p.Data.Any())
                        {
                            <table class="table table-hover table-sm mb-0" style="table-layout: fixed; border-collapse: separate; border-spacing: 0; color: #cbd5e1;">
                                <thead style="position: sticky; top: 0; z-index: 20;">
                                    <tr>
                                        <th class="p-2 ps-4 text-uppercase text-muted fw-bold" style="font-size: 0.6rem; letter-spacing: 1px; background: #1a2333; border-bottom: 2px solid @p.Color; width: 68%;">Part Kode</th>
                                        <th class="p-2 text-center text-uppercase text-muted fw-bold" style="font-size: 0.6rem; letter-spacing: 1px; background: #1a2333; border-bottom: 2px solid @p.Color; width: 32%;">Stock</th>
                                    </tr>
                                </thead>
                                <tbody id="table-body-@p.Name">
                                    @foreach (var item in p.Data)
                                    {
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                                            <td class="p-2 ps-4 fw-medium text-light-emphasis text-truncate" style="font-size: 0.75rem; background: transparent;" title="@item.ItemName">@item.VIN</td>
                                             <td class="p-2 text-center" style="background: transparent;">
                                                 @{
                                                     var stockClass = item.LevelStock < 1.0m ? "stock-level-red" :
                                                                    item.LevelStock >= 1.0m && item.LevelStock < 1.5m ? "stock-level-orange" :
                                                                    item.LevelStock >= 1.5m && item.LevelStock < 2.0m ? "stock-level-yellow" :
                                                                    item.LevelStock >= 2.0m && item.LevelStock <= 3.0m ? "stock-level-green" :
                                                                    "stock-level-blue";
                                                 }
                                                 <span class="badge @stockClass rounded-pill" style="font-size: 0.65rem; padding: 0.3rem 0.6rem; font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                                                     @item.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)
                                                 </span>
                                             </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="h-100 d-flex flex-column align-items-center justify-content-center p-4 text-center">
                                <div class="mb-3" style="opacity: 0.15;">
                                    <i class="bi bi-clock-history" style="font-size: 3.5rem; color: @p.Color;"></i>
                                </div>
                                <h6 class="text-muted small fw-light mb-1" style="letter-spacing: 0.5px;">Belum ada aktivitas @periodLabel.ToLower()</h6>
                                <p class="text-muted" style="font-size: 0.6rem; opacity: 0.5;">Data transaksi akan muncul di sini secara realtime</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script id="allDataJson" type="application/json">
    @Html.Raw(Json.Serialize(new Dictionary<string, object>
    {
        { "Overall", new { 
            pulling = Model.OverallTrend.Select(p => p.PullingCount), 
            preparation = Model.OverallTrend.Select(p => p.PreparationCount),
            catLess1 = Model.CategoryTrends.Select(c => c.CatLess1),
            catLess1_5 = Model.CategoryTrends.Select(c => c.CatLess1_5),
            catRange1_5_2 = Model.CategoryTrends.Select(c => c.CatRange1_5_2),
            catRange2_3 = Model.CategoryTrends.Select(c => c.CatRange2_3),
            catMore3 = Model.CategoryTrends.Select(c => c.CatMore3),
            stock = Model.TotalFGStock.ToString("N0"),
            peak = Model.HighestActivityTarget.ToString("N0")
        }},
        { "MOLDED", new { 
            pulling = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "MOLDED")?.DataPoints.Select(d => d.PullingCount),
            preparation = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "MOLDED")?.DataPoints.Select(d => d.PreparationCount),
            stock = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "MOLDED")?.TotalStock.ToString("N0"),
            peak = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "MOLDED")?.PeakActivity.ToString("N0")
        }},
        { "HOSE", new { 
            pulling = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "HOSE")?.DataPoints.Select(d => d.PullingCount),
            preparation = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "HOSE")?.DataPoints.Select(d => d.PreparationCount),
            stock = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "HOSE")?.TotalStock.ToString("N0"),
            peak = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "HOSE")?.PeakActivity.ToString("N0")
        }},
        { "RVI", new { 
            pulling = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "RVI")?.DataPoints.Select(d => d.PullingCount),
            preparation = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "RVI")?.DataPoints.Select(d => d.PreparationCount),
            stock = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "RVI")?.TotalStock.ToString("N0"),
            peak = Model.PlantTrends.FirstOrDefault(p => p.PlantName == "RVI")?.PeakActivity.ToString("N0")
        }}
    }))
</script>
</div>

<style>
    .futuristic-title {
        color: var(--primary-blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 800;
    }
    .cyber-card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .cyber-card:hover {
        border-color: var(--primary-blue);
    }
    .stat-card-blue { border-left: 4px solid #3b82f6; }
    .stat-card-green { border-left: 4px solid #10b981; }
    .stat-card-orange { border-left: 4px solid #f59e0b; }
    
    .stat-icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .small-badge {
        font-size: 0.6rem;
        padding: 0.2rem 0.4rem;
        min-width: 40px;
    }
    .table-dark {
        background-color: transparent !important;
    }
    .table-dark td {
        border-color: rgba(255, 255, 255, 0.05);
    }
    .auto-scroll-container::-webkit-scrollbar {
        display: none;
    }
    .stock-level-red { background-color: #ef4444 !important; color: white !important; }
    .stock-level-orange { background-color: #f97316 !important; color: white !important; }
    .stock-level-yellow { background-color: #eab308 !important; color: black !important; }
    .stock-level-green { background-color: #22c55e !important; color: white !important; }
    .stock-level-blue { background-color: #3b82f6 !important; color: white !important; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { 
                        color: '#94a3b8',
                        font: { weight: 'bold' }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255, 255, 255, 0.1)' },
                    ticks: { color: '#94a3b8' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#94a3b8' }
                }
            }
        };

        // Data Store for filtering
        let currentPlantKey = 'Overall';
        const viewMode = '@Model.ViewMode';
        const allData = {
            'Overall': {
                pulling: @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.PullingCount))),
                preparation: @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.PreparationCount))),
                catLess1: @Html.Raw(Json.Serialize(Model.CategoryTrends.Select(c => c.CatLess1))),
                catLess1_5: @Html.Raw(Json.Serialize(Model.CategoryTrends.Select(c => c.CatLess1_5))),
                catRange1_5_2: @Html.Raw(Json.Serialize(Model.CategoryTrends.Select(c => c.CatRange1_5_2))),
                catRange2_3: @Html.Raw(Json.Serialize(Model.CategoryTrends.Select(c => c.CatRange2_3))),
                catMore3: @Html.Raw(Json.Serialize(Model.CategoryTrends.Select(c => c.CatMore3))),
                stock: '@Model.TotalFGStock.ToString("N0")',
                peak: '@Model.HighestActivityTarget.ToString("N0")'
            },
            @foreach (var plant in Model.PlantTrends)
            {
                <text>'@plant.PlantName': {
                    pulling: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PullingCount))),
                    preparation: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PreparationCount))),
                    stock: '@plant.TotalStock.ToString("N0")',
                    peak: '@plant.PeakActivity.ToString("N0")'
                },</text>
            }
        };

        const overallLabels = @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.Label)));

        let datasets = [];
        if (viewMode === 'Level') {
            datasets = [
                { label: '< 1 D', data: allData['Overall'].catLess1, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: false, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#ef4444' },
                { label: '< 1.5 D', data: allData['Overall'].catLess1_5, borderColor: '#f97316', backgroundColor: 'rgba(249, 115, 22, 0.1)', fill: false, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#f97316' },
                { label: '1.5 - 2 D', data: allData['Overall'].catRange1_5_2, borderColor: '#eab308', backgroundColor: 'rgba(234, 179, 8, 0.1)', fill: false, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#eab308' },
                { label: '2 - 3 D', data: allData['Overall'].catRange2_3, borderColor: '#22c55e', backgroundColor: 'rgba(34, 197, 94, 0.1)', fill: false, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#22c55e' },
                { label: '> 3 D', data: allData['Overall'].catMore3, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: false, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#3b82f6' }
            ];
        } else {
            datasets = [
                { label: 'Pulling (Barang Masuk)', data: allData['Overall'].pulling, borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0.1)', fill: true, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#10b981' },
                { label: 'Preparation (Barang Keluar)', data: allData['Overall'].preparation, borderColor: '#f59e0b', backgroundColor: 'rgba(245, 158, 11, 0.1)', fill: true, tension: 0.1, borderWidth: 3, pointRadius: 4, pointBackgroundColor: '#f59e0b' }
            ];
        }

        const mainChart = new Chart(document.getElementById('overallTrendChart'), {
            type: 'line',
            data: {
                labels: overallLabels,
                datasets: datasets
            },
            options: chartOptions
        });

        function updateMainChart(key, title, element) {
            currentPlantKey = key;
            document.getElementById('mainChartTitle').innerHTML = `<i class="bi bi-activity text-primary me-2"></i> ${title}`;
            
            if (viewMode === 'Level' && key !== 'Overall') {
                // For now, Level view is overall only. If plant selected, show no data or alert
                mainChart.data.datasets.forEach(ds => ds.data = []);
            } else if (viewMode === 'Level') {
                mainChart.data.datasets[0].data = allData[key].catLess1;
                mainChart.data.datasets[1].data = allData[key].catLess1_5;
                mainChart.data.datasets[2].data = allData[key].catRange1_5_2;
                mainChart.data.datasets[3].data = allData[key].catRange2_3;
                mainChart.data.datasets[4].data = allData[key].catMore3;
            } else {
                mainChart.data.datasets[0].data = allData[key].pulling;
                mainChart.data.datasets[1].data = allData[key].preparation;
            }
            mainChart.update();

            // Update Indicators
            document.getElementById('fgStockVal').innerText = allData[key].stock;
            document.getElementById('peakActivityVal').innerText = allData[key].peak;
            document.getElementById('fgStockLabel').innerText = key === 'Overall' ? 'Total FG Stock' : `Stock ${key}`;

            // Update UI
            document.getElementById('plantFilterBtn').innerHTML = `<i class="bi bi-filter"></i> ${key === 'Overall' ? 'Semua Plant' : key}`;
            
            // Filter Plant Cards & Recent Activities
            const plantCards = document.querySelectorAll('.plant-card');
            const recentCards = document.querySelectorAll('.plant-recent');

            if (key === 'Overall') {
                plantCards.forEach(c => c.style.display = 'block');
                recentCards.forEach(c => c.style.display = 'block');
            } else {
                plantCards.forEach(c => {
                    c.style.display = (c.getAttribute('data-plant') === key) ? 'block' : 'none';
                });
                recentCards.forEach(c => {
                    c.style.display = (c.getAttribute('data-plant') === key) ? 'block' : 'none';
                });
            }

            // Update Active State
            const items = document.querySelectorAll('.dropdown-item');
            items.forEach(i => i.classList.remove('active'));
            element.classList.add('active');
        }

        // Plant Specific Charts
        @foreach (var plant in Model.PlantTrends)
        {
            <text>
            new Chart(document.getElementById('chart-@plant.PlantName'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.Label))),
                    datasets: [
                        {
                            label: 'IN',
                            data: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PullingCount))),
                            backgroundColor: '#10b981'
                        },
                        {
                            label: 'OUT',
                            data: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PreparationCount))),
                            backgroundColor: '#f59e0b'
                        }
                    ]
                },
                options: {
                    ...chartOptions,
                    plugins: { ...chartOptions.plugins, legend: { display: false } }
                }
            });
            </text>
        }

        // Auto-scroll logic for tables with toggle support
        const scrollStates = {};

        // Delegate listener for toggle changes to persist state
        $(document).on('change', '.scroll-toggle', function() {
            const plant = $(this).data('target');
            localStorage.setItem('trendScroll_' + plant, this.checked);
        });

        function initAutoScroll() {
            const containers = document.querySelectorAll('.auto-scroll-container');
            
            containers.forEach(container => {
                const id = container.id;
                const plantName = id.replace('scroll-container-', '');
                
                if (scrollStates[id] && scrollStates[id].interval) {
                    clearInterval(scrollStates[id].interval);
                }

                // Restore state from localStorage
                const savedState = localStorage.getItem('trendScroll_' + plantName);
                const toggle = document.querySelector(`.scroll-toggle[data-target="${plantName}"]`);
                if (savedState !== null && toggle) {
                    toggle.checked = savedState === 'true';
                }

                scrollStates[id] = {
                    speed: 1,
                    paused: false,
                    lastScroll: 0,
                    direction: 1, // 1: Down, -1: Up
                    interval: null
                };

                const scrollFn = () => {
                    const currentToggle = document.querySelector(`.scroll-toggle[data-target="${plantName}"]`);
                    const isEnabled = currentToggle ? currentToggle.checked : true;

                    if (isEnabled && !scrollStates[id].paused && container.scrollHeight > container.clientHeight) {
                        const prevPos = container.scrollTop;
                        container.scrollTop += (scrollStates[id].direction * scrollStates[id].speed);

                        // If position didn't change despite scroll attempt, we hit a boundary
                        if (container.scrollTop === prevPos) {
                            scrollStates[id].paused = true;
                            setTimeout(() => {
                                if (scrollStates[id]) {
                                    scrollStates[id].direction *= -1;
                                    scrollStates[id].paused = false;
                                }
                            }, 2000); // Pause 2 seconds at edges
                        }
                    }
                };

                scrollStates[id].interval = setInterval(scrollFn, 40);

                // Pause on interaction
                container.addEventListener('mouseenter', () => scrollStates[id].paused = true);
                container.addEventListener('mouseleave', () => scrollStates[id].paused = false);
                container.addEventListener('touchstart', () => scrollStates[id].paused = true);
            });
        }

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/stockHub")
            .withAutomaticReconnect()
            .build();

        connection.on("UpdateStock", function () {
            console.log("Stock update received, refreshing trends...");
            refreshDashboard();
        });

        connection.start().catch(err => console.error(err.toString()));

        function refreshDashboard() {
            $.ajax({
                url: window.location.href,
                type: 'GET',
                success: function (html) {
                    const $newHtml = $(html);
                    
                    // 1. Update Indicators & Tables
                    const newDashboardContent = $newHtml.find('#trendDashboardContent').html();
                    $('#trendDashboardContent').html(newDashboardContent);
                    
                    // 2. Extract and Update Chart Data
                    const rawJson = $newHtml.find('#allDataJson').text();
                    if (rawJson) {
                        try {
                            const newData = JSON.parse(rawJson);
                            Object.assign(allData, newData);
                            
                            // 3. Update Main Chart (it uses allData)
                            mainChart.data.datasets[0].data = allData[currentPlantKey].pulling;
                            mainChart.data.datasets[1].data = allData[currentPlantKey].preparation;
                            mainChart.update();

                            // 4. Update Header Indicators (important for realtime)
                            document.getElementById('fgStockVal').innerText = allData[currentPlantKey].stock;
                            document.getElementById('peakActivityVal').innerText = allData[currentPlantKey].peak;
                            document.getElementById('fgStockLabel').innerText = currentPlantKey === 'Overall' ? 'Total FG Stock' : `Stock ${currentPlantKey}`;
                            
                            // 5. Apply visibility filters (important to keep current filter)
                            const plantCards = document.querySelectorAll('.plant-card');
                            const recentCards = document.querySelectorAll('.plant-recent');

                            if (currentPlantKey === 'Overall') {
                                plantCards.forEach(c => c.style.display = 'block');
                                recentCards.forEach(c => c.style.display = 'block');
                            } else {
                                plantCards.forEach(c => {
                                    c.style.display = (c.getAttribute('data-plant').toUpperCase() === currentPlantKey.toUpperCase()) ? 'block' : 'none';
                                });
                                recentCards.forEach(c => {
                                    c.style.display = (c.getAttribute('data-plant').toUpperCase() === currentPlantKey.toUpperCase()) ? 'block' : 'none';
                                });
                            }
                        } catch (e) { console.error("Error parsing new allData", e); }
                    }

                    // 4. Re-initialize Auto Scroll
                    initAutoScroll();
                    
                    console.log("Trends refreshed successfully.");
                },
                error: function(err) {
                    console.error("Failed to refresh trends:", err);
                }
            });
        }

        window.addEventListener('load', initAutoScroll);
    </script>
}
