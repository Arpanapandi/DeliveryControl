@model DeliveryControl.Models.StockTrendViewModel

@{
    ViewData["Title"] = "Grafik Trend Stok";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="futuristic-title"><i class="bi bi-graph-up-arrow"></i> Grafik Trend Stok</h2>
        <p class="text-muted">Visualisasi pergerakan barang (Pooling vs Preparation) di Finished Goods</p>
    </div>
    <div class="col-md-6 text-end">
        <div class="d-flex justify-content-end gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="plantFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-filter"></i> Semua Plant
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="plantFilterBtn">
                    <li><a class="dropdown-item active" href="#" onclick="updateMainChart('Overall', 'Semua Plant', this)">Semua Plant</a></li>
                    <li><hr class="dropdown-divider opacity-25"></li>
                    @foreach (var plant in Model.PlantTrends)
                    {
                        <li><a class="dropdown-item" href="#" onclick="updateMainChart('@plant.PlantName', 'Trend @plant.PlantName', this)">@plant.PlantName</a></li>
                    }
                </ul>
            </div>
            <div class="btn-group shadow-sm" role="group">
                <a asp-action="Trend" asp-route-period="Day" class="btn @(Model.FilterPeriod == "Day" ? "btn-primary" : "btn-outline-primary")">Hari Ini</a>
                <a asp-action="Trend" asp-route-period="Month" class="btn @(Model.FilterPeriod == "Month" ? "btn-primary" : "btn-outline-primary")">Bulan Ini</a>
                <a asp-action="Trend" asp-route-period="Year" class="btn @(Model.FilterPeriod == "Year" ? "btn-primary" : "btn-outline-primary")">Tahun Ini</a>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="cyber-card stat-card stat-card-blue p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small fw-bold" id="fgStockLabel">Total FG Stock</h6>
                    <h2 class="mb-0 fw-bold"><span id="fgStockVal">@Model.TotalFGStock.ToString("N0")</span> <small class="fs-6 fw-normal">BOX</small></h2>
                </div>
                <div class="stat-icon-circle bg-primary-subtle text-primary">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="cyber-card stat-card stat-card-green p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small fw-bold">Peak Activity</h6>
                    <h2 class="mb-0 fw-bold"><span id="peakActivityVal">@Model.HighestActivityTarget.ToString("N0")</span> <small class="fs-6 fw-normal">Trx</small></h2>
                </div>
                <div class="stat-icon-circle bg-success-subtle text-success">
                    <i class="bi bi-lightning-charge"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="cyber-card stat-card stat-card-orange p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-muted small fw-bold">Current Period</h6>
                    <h2 class="mb-0 fw-bold">@Model.FilterPeriod</h2>
                </div>
                <div class="stat-icon-circle bg-warning-subtle text-warning">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Overall Trend Chart -->
<div class="row mb-4">
    <div class="col-12">
        <div class="cyber-card p-4">
            <h5 class="mb-4 fw-bold" id="mainChartTitle"><i class="bi bi-activity text-primary me-2"></i> Trend Aktivitas Keseluruhan (Semua Plant)</h5>
            <div style="height: 350px;">
                <canvas id="overallTrendChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Plant Specific Trends -->
<div class="row g-4 mb-4">
    @foreach (var plant in Model.PlantTrends)
    {
        <div class="col-md-4 plant-card" data-plant="@plant.PlantName">
            <div class="cyber-card p-4">
                <h6 class="mb-3 fw-bold"><i class="bi bi-building me-2"></i> Trend @plant.PlantName</h6>
                <div style="height: 200px;">
                    <canvas id="chart-@plant.PlantName"></canvas>
                </div>
                <div class="mt-3 d-flex justify-content-between align-items-center">
                    <small class="text-muted">Peak: <strong>@plant.PeakActivity</strong></small>
                    <span class="badge bg-primary-subtle text-primary fw-normal">Live Monitoring</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Recent Critical Stocks (Molded, Hose, RVI) -->
<div class="row g-4 mb-4" id="recentActivitiesRow">
    @{
        var plantsOrder = new[] { 
            new { Name = "MOLDED", Data = Model.RecentMolded, Color = "#3b82f6" },
            new { Name = "HOSE", Data = Model.RecentHose, Color = "#10b981" },
            new { Name = "RVI", Data = Model.RecentRVI, Color = "#f59e0b" }
        };
    }

    @foreach (var p in plantsOrder)
    {
        <div class="col-md-4 plant-recent" data-plant="@p.Name">
            <div class="cyber-card p-0 overflow-hidden" style="border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); background: linear-gradient(145deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%);">
                <div class="p-3 d-flex justify-content-between align-items-center" style="background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <h6 class="mb-0 fw-bold text-uppercase" style="letter-spacing: 1.5px; color: @p.Color;">RECENT @p.Name</h6>
                    <span class="badge bg-primary" style="font-size: 0.65rem; padding: 0.35em 0.8em; border-radius: 6px; box-shadow: 0 0 10px rgba(59, 130, 246, 0.4);">LIVE</span>
                </div>
                <div class="table-responsive auto-scroll-container" style="height: 300px; overflow-y: auto; scrollbar-width: none;">
                    <table class="table table-dark table-hover table-sm mb-0 small">
                        <thead style="background: rgba(0,0,0,0.2); border-bottom: 2px solid @p.Color; position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th class="p-3 ps-4 text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; background: #161e2b;">PART KODE</th>
                                <th class="p-3 text-center text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; background: #161e2b;">LVL STOCK</th>
                            </tr>
                        </thead>
                        <tbody id="table-body-@p.Name">
                            @if (p.Data != null && p.Data.Any())
                            {
                                @foreach (var item in p.Data)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                                        <td class="p-3 ps-4 fw-medium text-light-emphasis">@item.ItemName</td>
                                        <td class="p-3 text-center">
                                            <span class="badge bg-danger rounded-pill px-3 py-1" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                                                @item.LevelStock.ToString("N1").Replace(".", ",")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="py-5 text-center">
                                        <div class="text-muted opacity-50 mb-2"><i class="bi bi-info-circle fs-4"></i></div>
                                        <div class="small fw-light text-muted">No shortage items in @p.Name</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .futuristic-title {
        color: var(--primary-blue);
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 800;
    }
    .cyber-card {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .cyber-card:hover {
        border-color: var(--primary-blue);
    }
    .stat-card-blue { border-left: 4px solid #3b82f6; }
    .stat-card-green { border-left: 4px solid #10b981; }
    .stat-card-orange { border-left: 4px solid #f59e0b; }
    
    .stat-icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .small-badge {
        font-size: 0.6rem;
        padding: 0.2rem 0.4rem;
        min-width: 40px;
    }
    .table-dark {
        background-color: transparent !important;
    }
    .table-dark td {
        border-color: rgba(255, 255, 255, 0.05);
    }
    .auto-scroll-container::-webkit-scrollbar {
        display: none;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { 
                        color: '#94a3b8',
                        font: { weight: 'bold' }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255, 255, 255, 0.1)' },
                    ticks: { color: '#94a3b8' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#94a3b8' }
                }
            }
        };

        // Data Store for filtering
        const allData = {
            'Overall': {
                pooling: @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.PoolingCount))),
                preparation: @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.PreparationCount))),
                stock: '@Model.TotalFGStock.ToString("N0")',
                peak: '@Model.HighestActivityTarget.ToString("N0")'
            },
            @foreach (var plant in Model.PlantTrends)
            {
                <text>'@plant.PlantName': {
                    pooling: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PoolingCount))),
                    preparation: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PreparationCount))),
                    stock: '@plant.TotalStock.ToString("N0")',
                    peak: '@plant.PeakActivity.ToString("N0")'
                },</text>
            }
        };

        const overallLabels = @Html.Raw(Json.Serialize(Model.OverallTrend.Select(p => p.Label)));

        const mainChart = new Chart(document.getElementById('overallTrendChart'), {
            type: 'line',
            data: {
                labels: overallLabels,
                datasets: [
                    {
                        label: 'Pooling (Barang Masuk)',
                        data: allData['Overall'].pooling,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.1,
                        borderWidth: 3,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981',
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Preparation (Barang Keluar)',
                        data: allData['Overall'].preparation,
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        fill: true,
                        tension: 0.1,
                        borderWidth: 3,
                        pointRadius: 4,
                        pointBackgroundColor: '#f59e0b',
                        pointHoverRadius: 6
                    }
                ]
            },
            options: chartOptions
        });

        function updateMainChart(key, title, element) {
            // Update Title
            document.getElementById('mainChartTitle').innerHTML = `<i class="bi bi-activity text-primary me-2"></i> ${title}`;
            
            // Update Chart Data
            mainChart.data.datasets[0].data = allData[key].pooling;
            mainChart.data.datasets[1].data = allData[key].preparation;
            mainChart.update();

            // Update Indicators
            document.getElementById('fgStockVal').innerText = allData[key].stock;
            document.getElementById('peakActivityVal').innerText = allData[key].peak;
            document.getElementById('fgStockLabel').innerText = key === 'Overall' ? 'Total FG Stock' : `Stock ${key}`;

            // Update UI
            document.getElementById('plantFilterBtn').innerHTML = `<i class="bi bi-filter"></i> ${key === 'Overall' ? 'Semua Plant' : key}`;
            
            // Filter Plant Cards & Recent Activities
            const plantCards = document.querySelectorAll('.plant-card');
            const recentCards = document.querySelectorAll('.plant-recent');

            if (key === 'Overall') {
                plantCards.forEach(c => c.style.display = 'block');
                recentCards.forEach(c => c.style.display = 'block');
            } else {
                plantCards.forEach(c => {
                    c.style.display = (c.getAttribute('data-plant') === key) ? 'block' : 'none';
                });
                recentCards.forEach(c => {
                    c.style.display = (c.getAttribute('data-plant') === key) ? 'block' : 'none';
                });
            }

            // Update Active State
            const items = document.querySelectorAll('.dropdown-item');
            items.forEach(i => i.classList.remove('active'));
            element.classList.add('active');
        }

        // Plant Specific Charts
        @foreach (var plant in Model.PlantTrends)
        {
            <text>
            new Chart(document.getElementById('chart-@plant.PlantName'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.Label))),
                    datasets: [
                        {
                            label: 'IN',
                            data: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PoolingCount))),
                            backgroundColor: '#10b981'
                        },
                        {
                            label: 'OUT',
                            data: @Html.Raw(Json.Serialize(plant.DataPoints.Select(p => p.PreparationCount))),
                            backgroundColor: '#f59e0b'
                        }
                    ]
                },
                options: {
                    ...chartOptions,
                    plugins: { ...chartOptions.plugins, legend: { display: false } }
                }
            });
            </text>
        }

        // Auto-scroll logic for tables
        function initAutoScroll() {
            const containers = document.querySelectorAll('.auto-scroll-container');
            containers.forEach(container => {
                let scrollSpeed = 1;
                let scrollInterval = 50;
                
                setInterval(() => {
                    if (container.scrollHeight > container.clientHeight) {
                        container.scrollTop += scrollSpeed;
                        if (container.scrollTop + container.clientHeight >= container.scrollHeight - 1) {
                            setTimeout(() => {
                                container.scrollTop = 0;
                            }, 2000); // Pause at bottom
                        }
                    }
                }, scrollInterval);

                // Pause on hover
                container.addEventListener('mouseenter', () => scrollSpeed = 0);
                container.addEventListener('mouseleave', () => scrollSpeed = 1);
            });
        }

        window.addEventListener('load', initAutoScroll);
    </script>
}
