@model List<DeliveryControl.Models.Item>
@{
    ViewData["Title"] = "Manage Stock Targets";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1"><i class="bi bi-gear text-info"></i> Manage Stock Targets</h2>
                <p class="text-muted">Set threshold limits for Shortage, Normal, and Over stock categories.</p>
            </div>
            <a asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Master Item
            </a>

        </div>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-12">
        <form asp-action="UpdateTargets" method="post">
            <div class="cyber-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-info"><i class="bi bi-list-check me-2"></i> Items Threshold Configuration</span>
                    <button type="submit" class="btn btn-info btn-sm">
                        <i class="bi bi-check-circle me-1"></i> Save All Changes
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th style="width: 150px;">Min Stock (Shortage)</th>
                                <th style="width: 150px;">Max Stock (Over)</th>
                                <th>Current Category Logic</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="updates[@i].ItemId" value="@Model[i].ItemId" />
                                        <span class="text-primary fw-bold">@Model[i].ItemCode</span>
                                    </td>
                                    <td>@Model[i].ItemName</td>
                                    <td>
                                        <input type="number" name="updates[@i].MinStock" value="@Model[i].MinStock" class="form-control form-control-sm bg-dark text-white border-danger" required />
                                    </td>
                                    <td>
                                        <input type="number" name="updates[@i].MaxStock" value="@Model[i].MaxStock" class="form-control form-control-sm bg-dark text-white border-info" required />
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            Status: <span class="text-danger">&lt;@Model[i].MinStock</span> | 
                                            <span class="text-success">@Model[i].MinStock-@Model[i].MaxStock</span> | 
                                            <span class="text-info">&gt;@Model[i].MaxStock</span>
                                        </small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-end p-3">
                    <button type="submit" class="btn btn-info">
                        <i class="bi bi-save me-1"></i> Save All Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .form-control:focus {
        background-color: #1e293b;
        color: white;
        border-color: #38bdf8;
        box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.25);
    }
</style>
