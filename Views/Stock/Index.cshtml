@model DeliveryControl.Models.StockDashboardViewModel
@{
    ViewData["Title"] = "Dashboard FG";
}

<div class="header-container mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <!-- Title Section -->
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-columns-gap fs-3 text-primary"></i>
            <div>
                <h1 class="h4 fw-bold mb-0 text-white">Dashboard Finished Goods</h1>
                <p class="text-muted mb-0 smaller">Monitoring stock levels across all plants</p>
            </div>
        </div>

        <!-- Filter Bar Section -->
        <div class="custom-filter-bar">
            <!-- Search Box -->
            <div class="search-box-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="tagLabelSearch" class="custom-search-input" placeholder="Cari Tag atau Kanban...">
            </div>

            <!-- Plant Filter -->
            <div class="filter-group">
                <span class="filter-label">Plant:</span>
                <select id="plantFilter" class="custom-select-input">
                    <option value="Overall" selected="@(Model.PlantName == "Overall")">Overall</option>
                    <option value="Molded" selected="@(Model.PlantName == "Molded")">Molded</option>
                    <option value="Hose" selected="@(Model.PlantName == "Hose")">Hose</option>
                    <option value="RVI" selected="@(Model.PlantName == "RVI")">RVI</option>
                </select>
            </div>

            <!-- Date Filter -->
            <div class="filter-group">
                <span class="filter-label">Tanggal:</span>
                <input type="date" id="dateFilter" class="custom-date-input" value="@(Model.SearchDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))">
            </div>

            <div class="dash-v-divider"></div>

            <!-- Excel Download -->
            <button id="btnDownloadExcel" class="btn-custom-excel">
                <i class="bi bi-file-earmark-excel"></i>
                <span>Template Excel</span>
            </button>
        </div>
    </div>

    <!-- Dashboard Sub-Menu Navigation -->
    <div class="dashboard-nav-wrapper">
        <div class="nav-links-container">
            <a asp-controller="Stock" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-columns-gap"></i>
                <span>Overall Stock</span>
            </a>
            <a asp-controller="Stock" asp-action="Molded" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Molded" ? "active" : "")">
                <i class="bi bi-grid-3x3-gap"></i>
                <span>Transaction Molded</span>
            </a>
            <a asp-controller="Stock" asp-action="Hose" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Hose" ? "active" : "")">
                <i class="bi bi-layers"></i>
                <span>Transaction Hose</span>
            </a>
            <a asp-controller="Stock" asp-action="RVI" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "RVI" ? "active" : "")">
                <i class="bi bi-cpu"></i>
                <span>Transaction RVI</span>
            </a>
            <a asp-controller="Stock" asp-action="Trend" class="nav-link-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Trend" ? "active" : "")">
                <i class="bi bi-graph-up"></i>
                <span>Trend Stock</span>
            </a>
        </div>
    </div>
</div>

<div id="dashboardContent">
    <div class="row">
        <!-- Status Indicator Cards -->
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-danger indicator-card clickable" data-filter="Shortage" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Shortage</small>
                <h2 class="fw-bold mb-0 text-danger">@Model.ShortageCount</h2>
                <small class="text-white-50">Low Stock Items</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-success indicator-card clickable" data-filter="Normal" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Normal</small>
                <h2 class="fw-bold mb-0 text-success">@Model.NormalCount</h2>
                <small class="text-white-50">Safe Stock Items</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center border-info indicator-card clickable" data-filter="Over" style="cursor: pointer;">
                <small class="text-muted d-block text-uppercase">Over</small>
                <h2 class="fw-bold mb-0 text-info">@Model.OverCount</h2>
                <small class="text-white-50">Excessive Stock</small>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="cyber-card p-3 text-center">
                <div class="status-indicator-live active"></div>
                <small class="text-muted d-block text-uppercase">Stock Level</small>
                <h2 class="fw-bold mb-0 text-white fs-4">@Model.NetStock Total</h2>
                <small class="text-white-50">Box in Storage</small>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Detailed Data Table -->
        <div class="col-12 mb-4">
            <div class="cyber-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary"><i class="bi bi-list-ul me-2"></i> Detail Data Barang (@Model.PlantName)</span>
                    
                    <div class="d-flex align-items-center gap-2">
                         <span id="autoScrollStatus" class="small text-muted fw-bold me-1" style="font-size: 0.75rem;">Auto Scroll: OFF</span>
                         <button id="btnToggleAutoScroll" class="btn btn-outline-secondary btn-xs d-flex align-items-center gap-1">
                             <i class="bi bi-play-circle"></i> Toggle
                         </button>
                    </div>
                </div>
                <div class="table-responsive main-stock-container">
                    <table class="table table-hover mb-0" id="stockDetailTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Plant</th>
                                <th>Tag</th>
                                <th>Label</th>
                                <th>Nama Item</th>
                                <th>Stock</th>
                                <th>Min</th>
                                <th>Max</th>
                                <th class="text-nowrap">Level Stock</th>
                                <th class="text-center">Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.StockDetails)
                            {
                                <tr class="stock-row" data-status="@record.Status">
                                    <td>@record.No</td>
                                    <td><span class="badge @(record.Plant == "Molded" ? "bg-primary" : record.Plant == "Hose" ? "bg-info text-dark" : "bg-warning text-dark") smaller">@record.Plant</span></td>
                                    <td><span class="text-primary fw-bold">@record.Tag</span></td>
                                    <td>@record.Label</td>
                                    <td class="small">@record.ItemName</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold @(record.Status == "Shortage" ? "text-danger" : record.Status == "Over" ? "text-info" : "text-success")">@record.CurrentStock.ToString("G29")</span>
                                            <small class="text-muted" style="font-size: 0.6rem;">BOX</small>
                                        </div>
                                    </td>
                                    <td><span class="text-muted smaller">@(record.Min?.ToString() ?? "-")</span></td>
                                    <td><span class="text-muted smaller">@(record.Max?.ToString() ?? "-")</span></td>
                                     <td>
                                         @if (record.LevelStock < 1.0m)
                                         {
                                             <span class="stock-badge stock-level-red px-2 py-1">
                                                 <i class="bi bi-exclamation-triangle-fill"></i> @record.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture) Days
                                             </span>
                                         }
                                         else if (record.LevelStock >= 1.0m && record.LevelStock < 1.5m)
                                         {
                                             <span class="stock-badge stock-level-orange px-2 py-1">
                                                 <i class="bi bi-exclamation-circle-fill"></i> @record.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture) Days
                                             </span>
                                         }
                                         else if (record.LevelStock >= 1.5m && record.LevelStock < 2.0m)
                                         {
                                             <span class="stock-badge stock-level-yellow px-2 py-1">
                                                 <i class="bi bi-info-circle-fill"></i> @record.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture) Days
                                             </span>
                                         }
                                         else if (record.LevelStock >= 2.0m && record.LevelStock <= 3.0m)
                                         {
                                             <span class="stock-badge stock-level-green px-2 py-1">
                                                 <i class="bi bi-check-circle-fill"></i> @record.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture) Days
                                             </span>
                                         }
                                         else
                                         {
                                             <span class="stock-badge stock-level-blue px-2 py-1">
                                                 <i class="bi bi-star-fill"></i> @record.LevelStock.ToString("N1", System.Globalization.CultureInfo.InvariantCulture) Days
                                             </span>
                                         }
                                     </td>
                                     <td class="text-center"><span class="badge bg-dark border border-primary text-white">@record.Location</span></td>
                                </tr>
                            }
                            @if (!Model.StockDetails.Any())
                            {
                                <tr><td colspan="9" class="text-center py-5 text-muted small">Tidak ada data barang dalam stok.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/stockHub")
                .withAutomaticReconnect()
                .build();

            connection.on("UpdateStock", function () {
                refreshDashboard();
            });

            connection.start().catch(err => console.error(err.toString()));

            function refreshDashboard() {
                const plant = $('#plantFilter').val() || 'Overall';
                const date = $('#dateFilter').val() || '';
                
                $.ajax({
                    url: `/Stock/Index?plant=${plant}&date=${date}`,
                    type: 'GET',
                    success: function (html) {
                        const newContent = $(html).find('#dashboardContent').html();
                        $('#dashboardContent').fadeOut(200, function() {
                            $(this).html(newContent).fadeIn(200);
                            bindFilterEvents();
                            applyAllFilters(); // Re-apply local filters (Search & Status)
                            
                            // Re-apply auto scroll state if it was active
                            if (isAutoScrollActive) {
                                syncAutoScrollUI();
                                startScrolling();
                            }
                        });
                    }
                });
            }

            let currentStatusFilter = 'All';

            function bindFilterEvents() {
                $('.indicator-card.clickable').off('click').on('click', function() {
                    currentStatusFilter = $(this).data('filter');
                    applyAllFilters();
                });

                $('#plantFilter, #dateFilter').off('change').on('change', function() {
                    refreshDashboard();
                });

                $('#tagLabelSearch').off('input').on('input', function() {
                    applyAllFilters();
                });

                $('#tagLabelSearch').off('keypress').on('keypress', function(e) {
                    if (e.which == 13) {
                        refreshDashboard();
                    }
                });

                $('#btnToggleAutoScroll').off('click').on('click', toggleAutoScroll);
            }

            function applyAllFilters() {
                const searchText = $('#tagLabelSearch').val().toLowerCase();
                
                $('.indicator-card').removeClass('active-filter').css('opacity', '0.5');
                
                if (currentStatusFilter === 'All') {
                    $('.indicator-card').css('opacity', '1');
                    $('#activeFilterLabel').text('All Items').removeClass().addClass('badge bg-primary');
                } else {
                    $(`.indicator-card[data-filter="${currentStatusFilter}"]`).addClass('active-filter').css('opacity', '1');
                    
                    let badgeClass = 'bg-secondary';
                    if (currentStatusFilter === 'Shortage') badgeClass = 'bg-danger';
                    if (currentStatusFilter === 'Normal') badgeClass = 'bg-success';
                    if (currentStatusFilter === 'Over') badgeClass = 'bg-info text-dark';
                    $('#activeFilterLabel').text('Status: ' + currentStatusFilter).removeClass().addClass('badge ' + badgeClass);
                }

                $('.stock-row').each(function() {
                    const rowStatus = $(this).data('status');
                    const tag = $(this).find('td:nth-child(3)').text().toLowerCase(); // td 3 = Tag
                    const label = $(this).find('td:nth-child(4)').text().toLowerCase(); // td 4 = Label
                    const itemName = $(this).find('td:nth-child(5)').text().toLowerCase(); // td 5 = Item Name
                    
                    const matchesStatus = (currentStatusFilter === 'All' || rowStatus === currentStatusFilter);
                    const matchesSearch = (tag.includes(searchText) || label.includes(searchText) || itemName.includes(searchText));
                    
                    if (matchesStatus && matchesSearch) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Auto Scroll Logic
            let isAutoScrollActive = localStorage.getItem('autoScrollActive') === 'true';
            let scrollInterval;
            let scrollDirection = 1; // 1: Down, -1: Up
            const scrollSpeed = 1; 
            const scrollDelay = 40; // ms

            function toggleAutoScroll() {
                isAutoScrollActive = !isAutoScrollActive;
                localStorage.setItem('autoScrollActive', isAutoScrollActive);
                syncAutoScrollUI();
                
                if (isAutoScrollActive) {
                    scrollDirection = 1;
                    startScrolling();
                } else {
                    stopScrolling();
                }
            }

            function syncAutoScrollUI() {
                const btn = $('#btnToggleAutoScroll');
                const indicator = $('#autoScrollStatus');
                const icon = btn.find('i');

                if (isAutoScrollActive) {
                    btn.removeClass('btn-outline-secondary').addClass('btn-success active');
                    indicator.text('Auto Scroll: ON').removeClass('text-muted').addClass('text-success');
                    icon.removeClass('bi-play-circle').addClass('bi-pause-circle');
                } else {
                    btn.removeClass('btn-success active').addClass('btn-outline-secondary');
                    indicator.text('Auto Scroll: OFF').removeClass('text-success').addClass('text-muted');
                    icon.removeClass('bi-pause-circle').addClass('bi-play-circle');
                }
            }

            function startScrolling() {
                const container = $('.main-stock-container');
                if (container.length === 0) return;
                const el = container[0];
                
                if (scrollInterval) clearInterval(scrollInterval);
                
                scrollInterval = setInterval(function() {
                    if (!isAutoScrollActive) return;

                    const prevPos = el.scrollTop;
                    el.scrollTop += (scrollDirection * scrollSpeed);
                    
                    // If position didn't change, we hit a boundary
                    if (el.scrollTop === prevPos && el.scrollHeight > el.clientHeight) {
                        clearInterval(scrollInterval);
                        setTimeout(function() {
                            if (isAutoScrollActive) {
                                scrollDirection *= -1;
                                startScrolling();
                            }
                        }, 2000); // Wait 2 seconds at edges
                    }
                }, scrollDelay);
            }

            function stopScrolling() {
                clearInterval(scrollInterval);
                scrollDirection = 1;
            }

            bindFilterEvents();
            
            // Initial load check
            if (isAutoScrollActive) {
                syncAutoScrollUI();
                startScrolling();
            }
        });
    </script>
}

<style>
    /* ========================================
       COMPACT HEADER & FILTER BAR STYLING
       ======================================== */
    .header-container {
        padding: 5px 0;
    }

    .custom-filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: nowrap;
    }

    .search-box-wrapper {
        display: flex;
        align-items: center;
        background: #0f172a;
        border: 1px solid #3b82f6;
        border-radius: 4px;
        padding: 0 10px;
        height: 36px;
    }

    .search-icon {
        color: #3b82f6;
        font-size: 0.9rem;
        margin-right: 8px;
    }

    .custom-search-input {
        background: transparent;
        border: none;
        color: #fff;
        outline: none;
        font-size: 0.85rem;
        width: 180px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-label {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .custom-date-input, .custom-select-input {
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 4px;
        color: #fff;
        padding: 0 8px;
        height: 36px;
        font-size: 0.85rem;
        outline: none;
        color-scheme: dark;
    }

    .custom-date-input::-webkit-calendar-picker-indicator {
        filter: invert(1);
        cursor: pointer;
    }

    .custom-date-input:focus, .custom-select-input:focus {
        border-color: #3b82f6;
    }

    .btn-custom-excel {
        background: transparent;
        border: 1px solid #10b981;
        color: #10b981;
        border-radius: 6px;
        padding: 0 12px;
        height: 36px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-custom-excel:hover {
        background: rgba(16, 185, 129, 0.1);
    }

    .dash-v-divider {
        width: 1px;
        height: 20px;
        background: rgba(255,255,255,0.1);
        margin: 0 2px;
    }

    /* ========================================
       DASHBOARD SUB-MENU NAV STYLING
       ======================================== */
    .dashboard-nav-wrapper {
        border-bottom: 1px solid rgba(59, 130, 246, 0.2);
        margin-top: 5px;
        padding-bottom: 0;
    }

    .nav-links-container {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .nav-link-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-decoration: none;
        padding: 10px 0px;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
        border-bottom: 2px solid transparent;
    }

    .nav-link-item i {
        font-size: 1rem;
    }

    .nav-link-item:hover {
        color: #fff;
    }

    .nav-link-item.active {
        color: #3b82f6;
        border-bottom-color: #3b82f6;
    }

    .nav-link-item.active i {
        color: #3b82f6;
    }

    .smaller { font-size: 0.75rem; }
    .btn-xs { padding: 0.1rem 0.3rem; font-size: 0.7rem; }
    
    .status-indicator-live {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #94a3b8;
        display: inline-block;
        margin-bottom: 5px;
    }
    .indicator-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-width: 2px !important;
    }
    .indicator-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
    .indicator-card.active-filter {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(255,255,255,0.1);
        border-width: 3px !important;
    }
    .status-indicator-live.active {
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: pulse-live 2s infinite;
    }

    .main-stock-container {
        max-height: 50vh;
        overflow-y: auto;
        position: relative;
        scrollbar-width: thin;
        scrollbar-color: #3b82f6 #0f172a;
    }
    .main-stock-container::-webkit-scrollbar {
        width: 6px;
    }
    .main-stock-container::-webkit-scrollbar-track {
        background: #0f172a;
    }
    .main-stock-container::-webkit-scrollbar-thumb {
        background: #3b82f6;
        border-radius: 10px;
    }
    /* Sticky Header for Table */
    #stockDetailTable thead th {
        position: sticky;
        top: 0;
        background-color: #0f172a; /* Sesuaikan dengan background dark card */
        z-index: 10;
        border-bottom: 2px solid #1e293b;
    }

    @@keyframes pulse-live {
        0% { opacity: 1; }
        50% { opacity: 0.4; }
        100% { opacity: 1; }
    }
</style>
