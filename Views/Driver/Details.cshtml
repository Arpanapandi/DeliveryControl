@model DeliveryControl.Models.DeliverySchedule

@{
    ViewData["Title"] = "Detail Schedule";
    var duration = Model.ActualEndTime.HasValue && Model.ActualStartTime.HasValue
        ? Model.ActualEndTime.Value - Model.ActualStartTime.Value
        : TimeSpan.Zero;
    var durationText = duration.TotalHours >= 1 
        ? $"{(int)duration.TotalHours} jam {duration.Minutes} menit"
        : $"{(int)duration.TotalMinutes} menit";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-file-text"></i> Detail Schedule Delivery</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Portal Driver</a></li>
                <li class="breadcrumb-item active" aria-current="page">Detail</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Schedule Info -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informasi Schedule</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>No. Schedule:</strong>
                        <div class="fs-5 text-primary">@Model.ScheduleNumber</div>
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        @{
                            var statusBadge = Model.Status switch
                            {
                                "Scheduled" => "bg-warning",
                                "In Progress" => "bg-info",
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                "Delayed" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <div><span class="badge @statusBadge fs-6">@Model.Status</span></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <strong>Customer:</strong>
                        <div class="fs-5">@Model.Customer.CustomerCode - @Model.Customer.CustomerName</div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        @if (!string.IsNullOrWhiteSpace(Model.Route))
                        {
                            <div class="mb-2">
                                <strong>Route:</strong>
                                <div>@Model.Route</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Area))
                        {
                            <div class="mb-2">
                                <strong>Area:</strong>
                                <div><i class="bi bi-geo-alt"></i> @Model.Area</div>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        @if (!string.IsNullOrEmpty(Model.SKID))
                        {
                            <div class="mb-2">
                                <strong>SKID:</strong>
                                <div>@Model.SKID</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
                        {
                            <div class="mb-2">
                                <strong>Kendaraan:</strong>
                                <div>@Model.VehicleNumber</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline -->
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Timeline Delivery</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <small class="text-muted">Pickup Time (Target):</small>
                            <div class="fs-4">
                                @if (Model.PickupTime.HasValue)
                                {
                                    @Model.PickupTime.Value.ToString("HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted"><strong>✅ Kedatangan Aktual:</strong></small>
                            <div class="fs-3 text-success">
                                @if (Model.ActualStartTime.HasValue)
                                {
                                    @Model.ActualStartTime.Value.ToString("HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <small class="text-muted">ETD (Target):</small>
                            <div class="fs-4">
                                @if (Model.ETD.HasValue)
                                {
                                    @Model.ETD.Value.ToString("HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted"><strong>✅ Keberangkatan Aktual:</strong></small>
                            <div class="fs-3 text-success">
                                @if (Model.ActualEndTime.HasValue)
                                {
                                    @Model.ActualEndTime.Value.ToString("HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.ActualStartTime.HasValue && Model.ActualEndTime.HasValue)
                {
                    <hr />
                    <div class="alert alert-success mb-0">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <strong><i class="bi bi-stopwatch"></i> Durasi di Lokasi:</strong>
                                <div class="fs-2">@durationText</div>
                            </div>
                            <div class="col-md-6 text-end">
                                <small class="text-muted">Dari:</small> @Model.ActualStartTime.Value.ToString("HH:mm")<br />
                                <small class="text-muted">Sampai:</small> @Model.ActualEndTime.Value.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Delivery Items -->
        @if (Model.DeliveryItems.Any())
        {
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-box-seam"></i> Item yang Dikirim</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Kode Item</th>
                                    <th>Nama Item</th>
                                    <th class="text-center">Qty Plan</th>
                                    <th class="text-center">Qty Actual</th>
                                    <th>Unit</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DeliveryItems)
                                {
                                    <tr>
                                        <td><strong>@item.Item.ItemCode</strong></td>
                                        <td>@item.Item.ItemName</td>
                                        <td class="text-center"><strong>@item.Quantity</strong></td>
                                        <td class="text-center">
                                            @if (item.ActualQuantity.HasValue)
                                            {
                                                <strong class="text-success">@item.ActualQuantity</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@item.Item.Unit</td>
                                        <td>
                                            @if (item.ActualQuantity.HasValue)
                                            {
                                                if (item.ActualQuantity == item.Quantity)
                                                {
                                                    <span class="badge bg-success">Sesuai</span>
                                                }
                                                else if (item.ActualQuantity < item.Quantity)
                                                {
                                                    <span class="badge bg-warning">Kurang</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">Lebih</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-journal-text"></i> Catatan</h6>
                </div>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre-wrap;">@Model.Notes</pre>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <!-- Actions -->
        <div class="card border-primary mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-gear"></i> Aksi</h6>
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-action="Index" asp-route-selectedDate="@Model.ScheduledDate.ToString("yyyy-MM-dd")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Kembali ke Daftar
                </a>
                
                @if (!Model.ActualStartTime.HasValue)
                {
                    <a asp-action="Arrival" asp-route-id="@Model.ScheduleId" class="btn btn-warning">
                        <i class="bi bi-geo-alt-fill"></i> Konfirmasi Kedatangan
                    </a>
                }
                else if (!Model.ActualEndTime.HasValue)
                {
                    <a asp-action="Departure" asp-route-id="@Model.ScheduleId" class="btn btn-info">
                        <i class="bi bi-arrow-right-circle-fill"></i> Konfirmasi Keberangkatan
                    </a>
                }
            </div>
        </div>

        <!-- Driver Info -->
        @if (!string.IsNullOrWhiteSpace(Model.DriverName))
        {
            <div class="card border-success mb-3">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-person"></i> Informasi Driver</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <strong>Nama:</strong>
                        <div>@Model.DriverName</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DriverPhone))
                    {
                        <div class="mb-2">
                            <strong>Telepon:</strong>
                            <div><i class="bi bi-telephone"></i> @Model.DriverPhone</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Audit -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> Audit Trail</h6>
            </div>
            <div class="card-body">
                <small class="text-muted">Dibuat:</small>
                <div class="mb-2">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                
                @if (Model.UpdatedDate.HasValue)
                {
                    <small class="text-muted">Terakhir Update:</small>
                    <div class="mb-2">@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
                
                @if (!string.IsNullOrWhiteSpace(Model.UpdatedBy))
                {
                    <small class="text-muted">Oleh:</small>
                    <div>@Model.UpdatedBy</div>
                }
            </div>
        </div>
    </div>
</div>

