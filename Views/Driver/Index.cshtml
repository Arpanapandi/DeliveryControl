@model IEnumerable<DeliveryControl.Models.ViewModels.DriverTripViewModel>

@{
    ViewData["Title"] = "Portal Driver - Konfirmasi Delivery";
    var selectedDateValue = ViewData["SelectedDate"]?.ToString();
    var selectedDateDisplay = selectedDateValue ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dayName = ViewData["DayName"]?.ToString() ?? "";
    var selectedStatus = ViewData["SelectedStatus"]?.ToString() ?? "";
}

@* Hidden form for anti-forgery token *@
<form id="hiddenTokenForm" style="display:none;">
</form>

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-truck"></i> Portal Driver - Konfirmasi Delivery</h2>
    </div>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body">
        <form id="filterForm" asp-controller="Driver" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="selectedDate"><i class="bi bi-calendar"></i> Pilih Tanggal</label>
                <input type="date" 
                       class="form-control" 
                       name="selectedDate" 
                       id="selectedDate"
                       value="@selectedDateDisplay"
                       onchange="this.form.submit()" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="customerId"><i class="bi bi-building"></i> Nama Customer</label>
                <select class="form-select" name="customerId" id="customerId" onchange="this.form.submit()">
                    <option value="">Semua Customer</option>
                    @if (ViewBag.Customers != null)
                    {
                        @foreach (var customer in ViewBag.Customers)
                        {
                            var isSelected = ViewData["SelectedCustomerId"]?.ToString() == customer.CustomerId.ToString();
                            @if (isSelected)
                            {
                                <option value="@customer.CustomerId" selected>@customer.CustomerName</option>
                            }
                            else
                            {
                                <option value="@customer.CustomerId">@customer.CustomerName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="routeFilter"><i class="bi bi-signpost"></i> Route</label>
                <select class="form-select" name="route" id="routeFilter" onchange="this.form.submit()">
                    @{
                        var selectedRoute = ViewData["SelectedRoute"]?.ToString() ?? "";
                        var routes = ViewBag.Routes as List<string> ?? new List<string>();
                    }
                    <option value="">Semua Route</option>
                    @foreach (var r in routes)
                    {
                        var isSelectedRoute = string.Equals(selectedRoute, r, StringComparison.OrdinalIgnoreCase);
                        if (isSelectedRoute)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="cycleFilter"><i class="bi bi-arrow-repeat"></i> Cycle</label>
                <select class="form-select" name="cycle" id="cycleFilter" onchange="this.form.submit()">
                    @{
                        var selectedCycle = ViewData["SelectedCycle"]?.ToString() ?? "";
                        var cycles = ViewBag.Cycles as List<string> ?? new List<string>();
                    }
                    <option value="">Semua Cycle</option>
                    @foreach (var cy in cycles)
                    {
                        var isSelectedCycle = string.Equals(selectedCycle, cy, StringComparison.OrdinalIgnoreCase);
                        if (isSelectedCycle)
                        {
                            <option value="@cy" selected>@cy</option>
                        }
                        else
                        {
                            <option value="@cy">@cy</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-funnel"></i> Status</label>
                @{
                    var normStatus = selectedStatus?.Trim();

                    bool isScheduled = string.Equals(normStatus, "Scheduled", StringComparison.OrdinalIgnoreCase);
                    bool isInProgress = string.Equals(normStatus, "In Progress", StringComparison.OrdinalIgnoreCase);
                    bool isCompleted = string.Equals(normStatus, "Completed", StringComparison.OrdinalIgnoreCase);

                    var scheduledClass = (isScheduled ? "btn-warning text-dark" : "btn-outline-warning text-warning") + " btn btn-sm flex-fill fw-semibold";
                    var inProgressClass = (isInProgress ? "btn-info text-dark" : "btn-outline-info text-info") + " btn btn-sm flex-fill fw-semibold";
                    var completedClass = (isCompleted ? "btn-success" : "btn-outline-success text-success") + " btn btn-sm flex-fill fw-semibold";
                }
                <div class="d-flex flex-wrap gap-2 w-100">
                    <button type="submit"
                            name="status"
                            value="Scheduled"
                            class="@scheduledClass">
                        SCHEDULED
                    </button>
                    <button type="submit"
                            name="status"
                            value="In Progress"
                            class="@inProgressClass">
                        READY TO PICKUP
                    </button>
                    <button type="submit"
                            name="status"
                            value="Completed"
                            class="@completedClass">
                        COMPLETED
                    </button>
                </div>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-controller="Driver" asp-action="Index" class="btn btn-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

@{
    var needAction = ViewBag.NeedActionSchedules as List<DeliveryControl.Models.ViewModels.DriverTripViewModel> ?? new List<DeliveryControl.Models.ViewModels.DriverTripViewModel>();
    var completed = ViewBag.CompletedSchedules as List<DeliveryControl.Models.ViewModels.DriverTripViewModel> ?? new List<DeliveryControl.Models.ViewModels.DriverTripViewModel>();
}

<!-- Schedule List -->
@if (!needAction.Any() && !completed.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Tidak ada jadwal pelayan/trip untuk tanggal ini.
    </div>
}
else
{
    <!-- SECTION: BUTUH AKSI DRIVER -->
    <div class="mb-3">
        <h4 class="mb-3">
            <i class="bi bi-exclamation-circle text-warning"></i> BUTUH AKSI DRIVER
        </h4>

        @if (!needAction.Any())
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i> Tidak ada jadwal yang butuh aksi driver.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var trip in needAction)
                {
                    // Gunakan properti DriverStatus di ViewModel
                    var displayStatus = trip.DriverStatus ?? trip.OverallStatus;
                    var statusBadge = displayStatus switch
                    {
                        "Scheduled" => "bg-warning",
                        "In Progress" => "bg-info",
                        "Completed" => "bg-success",
                        "Cancelled" => "bg-danger",
                        "Delayed" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    var hasArrived = trip.HasArrived;
                    var hasDeparted = trip.HasDeparted;
                    
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 @(hasDeparted ? "border-success" : hasArrived ? "border-info" : "border-warning") shadow-sm">
                            <div class="card-header @statusBadge text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong style="font-size: 1rem;">TRIP: @trip.Cycle - @trip.Route</strong>
                                    <span class="badge bg-white text-dark shadow-sm">@(displayStatus == "Completed" ? "COMPLETED" : (displayStatus == "In Progress" ? "READY TO PICKUP" : displayStatus.ToUpper()))</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <small class="text-muted"><i class="bi bi-building"></i> Customer:</small>
                                    <div class="fw-bold fs-5">@trip.CustomerName</div>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Cycle:</small>
                                    <div class="fw-bold text-white">@trip.Cycle</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(trip.Route))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-signpost"></i> Route:</small>
                                        <div class="text-white">@trip.Route</div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(trip.Area))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-geo-alt"></i> Area:</small>
                                        <div class="text-white">@trip.Area</div>
                                    </div>
                                }
                                <div class="mb-3 text-info">
                                    <small class="text-muted"><i class="bi bi-list-check"></i> Total Manifests:</small>
                                    <strong>@trip.TotalSchedules</strong> Order
                                </div>

                                <!-- Pickup Time + ETD horizontal -->
                                <div class="row text-center mb-3 py-2 bg-dark bg-opacity-25 rounded border border-secondary mx-0">
                                    @if (trip.PickupTime.HasValue)
                                    {
                                        <div class="col-6 border-end border-secondary">
                                            <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Pickup</small>
                                            <strong class="text-warning fs-5">@trip.PickupTime.Value.ToString("HH:mm")</strong>
                                        </div>
                                    }
                                    @if (trip.ETD.HasValue)
                                    {
                                        <div class="col-6">
                                            <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">ETD</small>
                                            <strong class="text-warning fs-5">@trip.ETD.Value.ToString("HH:mm")</strong>
                                        </div>
                                    }
                                </div>

                                <!-- Execution Times -->
                                <div class="row g-2">
                                    @if (hasArrived && trip.ActualStartTime.HasValue)
                                    {
                                        <div class="col-12">
                                            <div class="p-2 border-start border-4 border-info rounded" style="font-size: 0.85rem; background: rgba(13, 110, 253, 0.15);">
                                                <i class="bi bi-geo-alt-fill text-info"></i> <span class="text-white">Tiba:</span> <strong class="text-info fs-6">@trip.ActualStartTime.Value.ToString("HH:mm")</strong>
                                            </div>
                                        </div>
                                    }
                                    @if (hasDeparted && trip.ActualEndTime.HasValue)
                                    {
                                        <div class="col-12">
                                            <div class="p-2 border-start border-4 border-success rounded" style="font-size: 0.85rem; background: rgba(25, 135, 84, 0.15);">
                                                <i class="bi bi-check-circle-fill text-success"></i> <span class="text-white">Selesai:</span> <strong class="text-success fs-6">@trip.ActualEndTime.Value.ToString("HH:mm")</strong>
                                                @{
                                                    var startTime = trip.ActualStartTime ?? trip.ActualEndTime.Value;
                                                    var duration = trip.ActualEndTime.Value - startTime;
                                                    var durationText = duration.TotalHours >= 1 
                                                        ? $"{(int)duration.TotalHours}j {duration.Minutes}m"
                                                        : $"{(int)duration.TotalMinutes}m";
                                                }
                                                <div class="text-muted small ms-4">Durasi: @durationText</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-footer">
                                @if (!hasDeparted)
                                {
                                    @if (!hasArrived)
                                    {
                                        <!-- Belum tiba, tampilkan tombol Kedatangan -->
                                        <div class="d-grid gap-2">
                                            <a asp-action="Arrival" asp-route-id="@trip.RepresentativeScheduleId" asp-route-returnDate="@selectedDateValue" class="btn btn-warning">
                                                <i class="bi bi-geo-alt-fill text-dark"></i> Konfirmasi Kedatangan
                                            </a>
                                            <form asp-action="QuickArrival" asp-route-id="@trip.RepresentativeScheduleId" asp-route-returnDate="@selectedDateValue" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning btn-sm w-100" 
                                                        onclick="return confirm('Konfirmasi kedatangan (GROUP) SEKARANG?')">
                                                    <i class="bi bi-lightning-fill"></i> Quick - Tiba Sekarang
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Sudah tiba (Enter Dock), tinggal berangkat -->
                                        <div class="d-grid gap-2">
                                            <a asp-action="Departure" asp-route-id="@trip.RepresentativeScheduleId" asp-route-returnDate="@selectedDateValue" class="btn btn-info">
                                                <i class="bi bi-arrow-right-circle-fill"></i> Konfirmasi Keberangkatan
                                            </a>
                                            <form asp-action="QuickDeparture" asp-route-id="@trip.RepresentativeScheduleId" asp-route-returnDate="@selectedDateValue" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-info btn-sm w-100" 
                                                        onclick="return confirm('Konfirmasi keberangkatan (GROUP) SEKARANG?')">
                                                    <i class="bi bi-lightning-fill"></i> Quick - Berangkat Sekarang
                                                </button>
                                            </form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <!-- Sudah selesai -->
                                    <div class="d-grid">
                                        <button class="btn btn-success disabled">
                                            <i class="bi bi-check-circle-fill"></i> Selesai
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <hr class="my-4" />

    <!-- SECTION: SUDAH SELESAI / TIDAK PERLU AKSI -->
    <div class="mb-3">
        <h4 class="mb-3">
            <i class="bi bi-check2-circle text-success"></i> SUDAH SELESAI / TIDAK PERLU AKSI
        </h4>

        @if (!completed.Any())
        {
            <div class="alert alert-secondary">
                <i class="bi bi-info-circle"></i> Belum ada jadwal yang selesai.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var trip in completed)
                {
                    // Gunakan properti DriverStatus di ViewModel
                    var displayStatus = trip.DriverStatus ?? trip.OverallStatus;
                    var statusBadge = displayStatus switch
                    {
                        "Scheduled" => "bg-warning",
                        "In Progress" => "bg-info",
                        "Completed" => "bg-success",
                        "Cancelled" => "bg-danger",
                        "Delayed" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    var hasArrived = trip.HasArrived;
                    var hasDeparted = trip.HasDeparted;
                    
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 border-success opacity-75 shadow-sm">
                            <div class="card-header bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong style="font-size: 1rem;">TRIP: @trip.Cycle - @trip.Route</strong>
                                    <span class="badge bg-white text-dark shadow-sm">COMPLETED</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <small class="text-muted"><i class="bi bi-building"></i> Customer:</small>
                                    <div class="fw-bold fs-5">@trip.CustomerName</div>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Cycle:</small>
                                    <div class="fw-bold text-white">@trip.Cycle</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(trip.Route))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-signpost"></i> Route:</small>
                                        <div class="text-white">@trip.Route</div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(trip.Area))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-geo-alt"></i> Area:</small>
                                        <div class="text-white">@trip.Area</div>
                                    </div>
                                }
                                <div class="mb-3 text-info">
                                    <small class="text-muted"><i class="bi bi-list-check"></i> Total Manifests:</small>
                                    <strong>@trip.TotalSchedules</strong> Order
                                </div>
                                
                                <!-- Execution Time -->
                                <div class="p-2 border-start border-4 border-success rounded mt-3" style="font-size: 0.85rem; background: rgba(25, 135, 84, 0.15);">
                                    <i class="bi bi-check-circle-fill text-success"></i> <span class="text-white">Selesai:</span> <strong class="text-success fs-6">@(trip.ActualEndTime?.ToString("HH:mm") ?? "-")</strong>
                                    @{
                                        var startTime = trip.ActualStartTime ?? trip.ActualEndTime;
                                        if (startTime.HasValue && trip.ActualEndTime.HasValue)
                                        {
                                            var duration = trip.ActualEndTime.Value - startTime.Value;
                                            var durationText = duration.TotalHours >= 1 
                                                ? $"{(int)duration.TotalHours}j {duration.Minutes}m"
                                                : $"{(int)duration.TotalMinutes}m";
                                            <div class="text-muted small ms-4">Durasi: @durationText</div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="d-grid">
                                    <button class="btn btn-success disabled">
                                        <i class="bi bi-check-circle-fill"></i> Selesai
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // Pastikan form submit dengan benar dan mempertahankan nilai
        document.addEventListener('DOMContentLoaded', function() {
            var filterForm = document.getElementById('filterForm');
            
            if (filterForm) {
                // Form automatic submission for other inputs is already handled by inline onchange
                console.log('Driver Portal Filter Form initialized');
            }
        });

        // Auto refresh setiap 60 detik
        setTimeout(function() {
            location.reload();
        }, 60000);
        
        // Highlight waktu real-time
        setInterval(function() {
            var now = new Date();
            var timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            document.title = timeStr + ' - Portal Driver';
        }, 1000);
    </script>
}
