@model DeliveryControl.Models.DeliverySchedule

@{
    ViewData["Title"] = "Konfirmasi Keberangkatan";
    var now = DateTime.Now;
    var isAdmin = Context.Session.GetString("Role") == "Admin";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-arrow-right-circle-fill text-info"></i> Konfirmasi Keberangkatan</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Portal Driver</a></li>
                <li class="breadcrumb-item active" aria-current="page">Konfirmasi Keberangkatan</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-clock-fill"></i> Konfirmasi Waktu Keberangkatan</h5>
            </div>
            <div class="card-body">
                <form asp-action="Departure" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ScheduleId" />

                    <!-- Info Schedule -->
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Informasi Schedule</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td width="150"><strong>No. Schedule:</strong></td>
                                <td>@Model.ScheduleNumber</td>
                            </tr>
                            <tr>
                                <td><strong>Customer:</strong></td>
                                <td>@Model.Customer.CustomerCode - @Model.Customer.CustomerName</td>
                            </tr>
                            <tr>
                                <td><strong>Waktu Tiba:</strong></td>
                                <td class="text-primary"><strong>@(Model.ActualStartTime?.ToString("HH:mm") ?? "-")</strong></td>
                            </tr>
                            @if (Model.PickupTime.HasValue)
                            {
                                <tr>
                                    <td><strong>Pickup Time (Target):</strong></td>
                                    <td>@Model.PickupTime.Value.ToString("HH:mm")</td>
                                </tr>
                            }
                        </table>
                    </div>

                    @if (isAdmin)
                    {
                        <!-- Actual Departure Time - Hanya untuk Admin -->
                        <div class="mb-4">
                            <label for="departureTime" class="form-label">
                                <i class="bi bi-clock-fill"></i> <strong>Waktu Keberangkatan Aktual</strong>
                            </label>
                            <input type="datetime-local" 
                                   class="form-control form-control-lg" 
                                   id="departureTime" 
                                   name="departureTime" 
                                   value="@now.ToString("yyyy-MM-ddTHH:mm")" 
                                   required />
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Sesuaikan dengan waktu keberangkatan Anda yang sebenarnya
                            </div>
                        </div>

                        <!-- Quick Time Buttons - Hanya untuk Admin -->
                        <div class="mb-4">
                            <label class="form-label"><strong>Quick Select:</strong></label>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="setTimeNow()">
                                    <i class="bi bi-clock"></i> Sekarang
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="adjustTime(-5)">
                                    <i class="bi bi-dash-circle"></i> -5 menit
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="adjustTime(-10)">
                                    <i class="bi bi-dash-circle"></i> -10 menit
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Hidden field untuk waktu keberangkatan (akan di-set saat submit untuk User) -->
                        <input type="hidden" id="departureTime" name="departureTime" />
                    }

                    <!-- Notes -->
                    <div class="mb-4">
                        <label for="notes" class="form-label">
                            <i class="bi bi-journal-text"></i> Catatan (Opsional)
                        </label>
                        <textarea class="form-control" 
                                  id="notes" 
                                  name="notes" 
                                  rows="3" 
                                  placeholder="Tambahkan informasi tambahan jika diperlukan..."></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" asp-route-selectedDate="@Model.ScheduledDate.ToString("yyyy-MM-dd")" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Batal
                        </a>
                        <button type="submit" class="btn btn-info btn-lg text-white">
                            <i class="bi bi-check-circle-fill"></i> Konfirmasi Keberangkatan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Current Time Display -->
        <div class="card border-primary mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-clock"></i> Waktu Saat Ini</h6>
            </div>
            <div class="card-body text-center">
                <h1 class="display-4 text-primary mb-0" id="currentTime">__ : __</h1>
                <p class="text-muted mb-0" id="currentDate">...</p>
            </div>
        </div>

        <!-- Info Card -->
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informasi</h6>
            </div>
            <div class="card-body">
                <p class="small mb-2">
                    <strong>Keberangkatan:</strong> Waktu saat Anda meninggalkan lokasi customer
                </p>
                <p class="small mb-2">
                    <strong>Status:</strong> Setelah konfirmasi, status akan berubah menjadi "DELIVERED"
                </p>
                <p class="small mb-0">
                    <strong>Durasi:</strong> Sistem akan menghitung durasi waktu tunggu/bongkar muat di customer
                </p>
            </div>
        </div>

        @if (Model.ActualEndTime.HasValue)
        {
            <div class="alert alert-warning mt-3">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Perhatian!</strong> Schedule ini sudah dikonfirmasi keberangkatan pada:
                <div class="mt-2">
                    <strong>@Model.ActualEndTime.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            function updateCurrentTime() {
                var now = new Date();
                var hours = String(now.getHours()).padStart(2, '0');
                var minutes = String(now.getMinutes()).padStart(2, '0');
                var seconds = String(now.getSeconds()).padStart(2, '0');
                var timeStr = hours + ':' + minutes + ':' + seconds;
                
                var days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
                var months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
                
                var dayName = days[now.getDay()];
                var day = now.getDate();
                var monthName = months[now.getMonth()];
                var year = now.getFullYear();
                
                var dateStr = dayName + ', ' + day + ' ' + monthName + ' ' + year;
                
                document.getElementById('currentTime').textContent = timeStr;
                document.getElementById('currentDate').textContent = dateStr;
            }
            
            window.setTimeNow = function() {
                var input = document.getElementById('departureTime');
                if (input && input.type === 'datetime-local') {
                    var now = new Date();
                    var dateString = now.getFullYear() + '-' + 
                                   String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                                   String(now.getDate()).padStart(2, '0') + 'T' + 
                                   String(now.getHours()).padStart(2, '0') + ':' + 
                                   String(now.getMinutes()).padStart(2, '0');
                    input.value = dateString;
                }
            }
            
            window.adjustTime = function(minutes) {
                var input = document.getElementById('departureTime');
                if (input && input.type === 'datetime-local') {
                    var currentTime = new Date(input.value);
                    currentTime.setMinutes(currentTime.getMinutes() + minutes);
                    
                    var dateString = currentTime.getFullYear() + '-' + 
                                   String(currentTime.getMonth() + 1).padStart(2, '0') + '-' + 
                                   String(currentTime.getDate()).padStart(2, '0') + 'T' + 
                                   String(currentTime.getHours()).padStart(2, '0') + ':' + 
                                   String(currentTime.getMinutes()).padStart(2, '0');
                    input.value = dateString;
                }
            }
            
            updateCurrentTime();
            setInterval(updateCurrentTime, 1000);
            
            document.querySelector('form').addEventListener('submit', function(e) {
                var input = document.getElementById('departureTime');
                var now = new Date();
                var dateString = now.getFullYear() + '-' + 
                               String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                               String(now.getDate()).padStart(2, '0') + 'T' + 
                               String(now.getHours()).padStart(2, '0') + ':' + 
                               String(now.getMinutes()).padStart(2, '0');
                
                if (input && input.type === 'hidden') {
                    input.value = dateString;
                }
                
                // Validasi: Keberangkatan tidak boleh sebelum Kedatangan
                var arrivalTimeStr = "@(Model.ActualStartTime?.ToString("yyyy-MM-ddTHH:mm"))";
                if (arrivalTimeStr) {
                    var arrivalTime = new Date(arrivalTimeStr);
                    var departureTime = new Date(input.value);
                    
                    if (departureTime < arrivalTime) {
                        alert('⚠️ Waktu keberangkatan tidak boleh lebih awal dari waktu kedatangan!');
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}
