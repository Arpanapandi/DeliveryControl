@model DeliveryControl.Models.DeliverySchedule

@{
    ViewData["Title"] = "Detail Preparation - Masuk Dock";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-box-arrow-in-right"></i> Detail Masuk Dock</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Portal Preparation</a></li>
                <li class="breadcrumb-item active" aria-current="page">Detail</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Informasi Schedule -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informasi Schedule</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>No. Schedule:</strong>
                        <div class="fs-5 text-primary">@Model.ScheduleNumber</div>
                    </div>
                    <div class="col-md-6">
                        <strong>Status Preparation:</strong>
                        @{
                            var displayStatus = Model.PreparationStatus ?? Model.Status;
                            var statusBadge = displayStatus switch
                            {
                                "Scheduled" => "bg-warning",
                                "In Progress" => "bg-info",
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                "Delayed" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <div><span class="badge @statusBadge fs-6">@displayStatus</span></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <strong>Customer:</strong>
                        <div class="fs-5">
                            @Model.Customer?.CustomerCode - @Model.Customer?.CustomerName
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        @if (!string.IsNullOrWhiteSpace(Model.Route))
                        {
                            <div class="mb-2">
                                <strong>Route:</strong>
                                <div>@Model.Route</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Area))
                        {
                            <div class="mb-2">
                                <strong>Area:</strong>
                                <div><i class="bi bi-geo-alt"></i> @Model.Area</div>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        @if (!string.IsNullOrEmpty(Model.SKID))
                        {
                            <div class="mb-2">
                                <strong>SKID:</strong>
                                <div>@Model.SKID</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
                        {
                            <div class="mb-2">
                                <strong>Kendaraan:</strong>
                                <div>@Model.VehicleNumber</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Daftar Barang & Status Preparation -->
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-boxes"></i> Daftar Barang & Status Stock</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th class="text-center" style="width: 120px;">Qty Order</th>
                                <th class="text-center" style="width: 120px;">Prepared (Hari Ini)</th>
                                <th class="text-center" style="width: 150px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DeliveryItems != null && Model.DeliveryItems.Any())
                            {
                                var prepCounts = ViewBag.PrepCounts as Dictionary<string, int>;
                                
                                foreach (var item in Model.DeliveryItems)
                                {
                                    var itemCodeKey = (item.Item?.ItemCode ?? "").Trim().ToUpper();
                                    var preparedQty = 0;
                                    
                                    if (prepCounts != null && prepCounts.ContainsKey(itemCodeKey))
                                    {
                                        preparedQty = prepCounts[itemCodeKey];
                                    }
                                    
                                    var percent = item.Quantity > 0 ? (double)preparedQty / (double)item.Quantity * 100 : 0;
                                    var isReady = preparedQty >= item.Quantity;
                                    
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Item?.ItemCode</div>
                                            <div class="small text-muted">@item.Item?.ItemName</div>
                                        </td>
                                        <td class="text-center fw-bold">
                                            @item.Quantity.ToString("0.##") @item.Unit
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(isReady ? "bg-success" : "bg-warning text-dark") fs-6">
                                                @preparedQty
                                            </span>
                                            @if (item.Unit != null)
                                            {
                                                <small class="text-muted">@item.Unit</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isReady)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> READY</span>
                                            }
                                            else
                                            {
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar bg-warning text-dark" role="progressbar" 
                                                         style="width: @(Math.Min(percent, 100))%;" 
                                                         aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                                        @Math.Round(percent)%
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        <i class="bi bi-exclamation-circle"></i> Belum ada item dalam schedule ini.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Timeline Masuk Dock</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <small class="text-muted">Enter Dock (Target):</small>
                            <div class="fs-4">
                                @if (Model.EnterDockTime.HasValue)
                                {
                                    @Model.EnterDockTime.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <small class="text-muted"><strong><i class="bi bi-patch-check text-success"></i> Enter Dock Aktual:</strong></small>
                            <div class="fs-3 text-success">
                                @if (Model.ActualEnterDockTime.HasValue)
                                {
                                    @Model.ActualEnterDockTime.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.EnterDockTime.HasValue && Model.ActualEnterDockTime.HasValue)
                {
                    var delay = Model.ActualEnterDockTime.Value - Model.EnterDockTime.Value;
                    var isLate = delay.TotalMinutes > 0;

                    <hr />
                    <div class="alert @(isLate ? "alert-danger" : "alert-success") mb-0">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <strong><i class="bi bi-stopwatch"></i> Kinerja Masuk Dock:</strong>
                                <div class="fs-5">
                                    @if (isLate)
                                    {
                                        <span class="text-danger">Terlambat +@((int)delay.TotalMinutes) menit</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">On Time / Lebih Cepat</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <small class="text-muted">Target:</small> @Model.EnterDockTime.Value.ToString("HH:mm")<br />
                                <small class="text-muted">Aktual:</small> @Model.ActualEnterDockTime.Value.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-journal-text"></i> Catatan</h6>
                </div>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre-wrap;">@Model.Notes</pre>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <!-- Actions -->
        <div class="card border-primary mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-gear"></i> Aksi</h6>
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-action="Index"
                   asp-route-selectedDate="@(Model.EnterDockTime?.ToString("yyyy-MM-dd") ?? Model.ScheduledDate.ToString("yyyy-MM-dd"))"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Kembali ke Daftar
                </a>
            </div>
        </div>

        <!-- Audit -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> Audit Trail</h6>
            </div>
            <div class="card-body">
                <small class="text-muted">Dibuat:</small>
                <div class="mb-2">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>

                @if (Model.UpdatedDate.HasValue)
                {
                    <small class="text-muted">Terakhir Update:</small>
                    <div class="mb-2">@Model.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.UpdatedBy))
                {
                    <small class="text-muted">Oleh:</small>
                    <div>@Model.UpdatedBy</div>
                }
            </div>
        </div>
    </div>
</div>


