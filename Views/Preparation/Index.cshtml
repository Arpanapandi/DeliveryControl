@model IEnumerable<DeliveryControl.Models.ViewModels.DriverTripViewModel>

@{
    ViewData["Title"] = "Portal Preparation - Overview Detail";
    var selectedDate = ViewData["SelectedDate"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dayName = ViewData["DayName"]?.ToString() ?? "";
}

<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-header-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
        padding: 1rem 0;
    }

    .prep-card {
        background: var(--cyber-card-bg);
        border: 2px solid var(--cyber-border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    }

    .prep-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0 20px rgba(250, 204, 21, 0.2);
    }

    .prep-card.border-warning { border-color: var(--cyber-yellow) !important; }
    .prep-card.border-info { border-color: #06b6d4 !important; }
    .prep-card.border-success { border-color: #10b981 !important; }

    .prep-card-header {
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .header-scheduled { background: var(--cyber-yellow); color: #000; }
    .header-preparing { background: #06b6d4; color: white; }
    .header-prepared { background: #10b981; color: white; }

    .prep-card-body {
        padding: 24px;
        flex-grow: 1;
        color: white;
    }

    .customer-name {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-transform: uppercase;
    }

    .delivery-banner {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 20px;
    }

    .cycle-label {
        font-size: 0.85rem;
        color: var(--cyber-text-muted);
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .cycle-value {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 15px;
    }

    .detail-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 15px;
    }

    .detail-label {
        color: var(--cyber-text-muted);
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .detail-value {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .icon-spacing {
        width: 24px;
        display: inline-block;
        text-align: center;
        margin-right: 8px;
        color: var(--cyber-yellow);
    }

    .prep-card-footer {
        padding: 20px;
        background: rgba(0,0,0,0.25);
        border-top: 1px solid var(--cyber-border);
    }

    .badge-status {
        background: white;
        color: #1e293b;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 800;
    }

    .card-items-list {
        margin-top: 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 15px;
    }

    .card-item-progress {
        margin-bottom: 12px;
    }

    .item-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        margin-bottom: 4px;
    }

    .item-vin {
        color: var(--cyber-yellow);
        font-weight: 600;
    }

    .item-progress-val {
        font-weight: 700;
    }

    .progress-mini {
        height: 8px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
    }

    .filter-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .cyber-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid var(--cyber-border) !important;
        color: white !important;
    }

    @@keyframes glow-pulse {
        0% { box-shadow: 0 0 5px var(--cyber-yellow); border-color: var(--cyber-yellow); }
        50% { box-shadow: 0 0 25px var(--cyber-yellow); border-color: #fff; transform: scale(1.02); }
        100% { box-shadow: 0 0 5px var(--cyber-yellow); border-color: var(--cyber-yellow); }
    }

    .glow-active {
        animation: glow-pulse 1.5s infinite;
        z-index: 100;
        border-color: var(--cyber-yellow) !important;
    }
</style>

<div class="container-fluid py-4">
    <!-- ... header content ... -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-1"><i class="bi bi-box-seam me-2 text-warning"></i> Portal Preparation</h2>
        </div>
        <div class="text-end">
            <h5 class="text-yellow mb-0">@dayName</h5>
            <small class="text-white-50">@DateTime.Now.ToString("HH:mm:ss")</small>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar shadow-sm">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-white-50 small fw-bold">PILIH TANGGAL</label>
                <input type="date" name="selectedDate" value="@selectedDate" class="form-control cyber-input" onchange="this.form.submit()" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-white-50 small fw-bold">CUSTOMER</label>
                <select name="customerId" class="form-select cyber-input" onchange="this.form.submit()">
                    <option value="">Semua Customer</option>
                    @if (ViewBag.Customers != null)
                    {
                        foreach (var c in ViewBag.Customers)
                        {
                            bool isSel = ViewData["SelectedCustomerId"]?.ToString() == c.CustomerId.ToString();
                            <option value="@c.CustomerId" selected="@isSel">@c.CustomerName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-white-50 small fw-bold">CYCLE</label>
                <select name="cycle" class="form-select cyber-input" onchange="this.form.submit()">
                    <option value="">Semua</option>
                    @if (ViewBag.Cycles != null)
                    {
                        foreach (var cy in ViewBag.Cycles)
                    {
                            bool isSel = ViewData["SelectedCycle"]?.ToString() == cy;
                            <option value="@cy" selected="@isSel">@cy</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 offset-md-2 d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary flex-grow-1">Reset</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert bg-dark border-secondary text-info">
            <i class="bi bi-info-circle me-2"></i> Tidak ada jadwal yang ditemukan untuk kriteria ini.
        </div>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var trip in Model)
            {
                var firstSch = trip.Schedules.FirstOrDefault();
                if (firstSch == null) continue;

                var isCompleted = trip.OverallStatus == "Completed";
                var isInProgress = trip.OverallStatus == "In Progress";
                var isScheduled = trip.OverallStatus == "Scheduled";
                
                // Determine CSS classes based on Group Status
                var headerClass = "header-scheduled";
                var borderClass = "border-warning";

                if (isInProgress) 
                { 
                    headerClass = "header-preparing"; 
                    borderClass = "border-info";
                }
                else if (isCompleted) 
                { 
                    headerClass = "header-prepared"; 
                    borderClass = "border-success";
                }

                <div class="prep-card @borderClass" 
                     id="card-@trip.RepresentativeScheduleId" 
                     data-schedule-number="@firstSch.ScheduleNumber">
                    
                    <div class="prep-card-header @headerClass">
                        <div class="d-flex flex-wrap gap-1 align-items-center">
                            @foreach(var m in trip.Schedules) {
                                <span class="badge bg-light text-dark opacity-75" style="font-size: 0.8rem; border: 1px solid rgba(0,0,0,0.1);">@m.ScheduleNumber</span>
                            }
                        </div>
                        <span class="badge-status ms-2">@trip.OverallStatus.ToUpper()</span>
                    </div>
                    
                    <div class="prep-card-body">
                        <div class="customer-name mb-1">
                            <i class="bi bi-building"></i> @trip.CustomerName
                        </div>

                        <!-- DELIVERY BANNER -->
                        @if (trip.PickupTime.HasValue)
                        {
                            var pickupDate = trip.PickupTime.Value.Date;
                            var isToday = pickupDate == DateTime.Today;
                            var isTomorrow = pickupDate == DateTime.Today.AddDays(1);
                            var dateLabel = isToday ? "HARI INI" : (isTomorrow ? "BESOK" : pickupDate.ToString("dd/MM/yyyy"));
                            var badgeColor = isToday ? "bg-success" : (isTomorrow ? "bg-info" : "bg-secondary");
                            
                            <div class="delivery-banner">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-white-50">
                                        <i class="bi bi-calendar-check me-1"></i> <strong>Tanggal Delivery:</strong>
                                    </small>
                                    <span class="badge @badgeColor">
                                        @dateLabel - @trip.PickupTime.Value.ToString("HH:mm")
                                    </span>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <div class="cycle-label">Cycle:</div>
                            <div class="cycle-value">@trip.Cycle</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Route:</div>
                            <div class="detail-value text-info fw-bold">@trip.Route</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Area:</div>
                            <div class="detail-value"><i class="bi bi-geo-alt-fill icon-spacing"></i>@trip.Area</div>
                        </div>
                        
                        <hr class="border-secondary opacity-25">

                        <div class="row">
                            <div class="col-6">
                                <div class="detail-row mb-0">
                                    <div class="detail-label"><i class="bi bi-box-arrow-in-right icon-spacing"></i>Enter Dock:</div>
                                    <div class="detail-value">@(trip.Schedules.Any(s => s.ActualEnterDockTime.HasValue) ? trip.Schedules.First(s => s.ActualEnterDockTime.HasValue).ActualEnterDockTime?.ToString("HH:mm") : (trip.Schedules.FirstOrDefault()?.EnterDockTime?.ToString("HH:mm") ?? "-"))</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="detail-row mb-0">
                                    <div class="detail-label"><i class="bi bi-truck icon-spacing"></i>Pickup Time:</div>
                                    <div class="detail-value">@(trip.PickupTime?.ToString("HH:mm") ?? "-")</div>
                                </div>
                            </div>
                        </div>

                        <!-- ITEMS & PROGRESS SECTION (Aggregate from ALL schedules in group) -->
                        <div class="card-items-list">
                            @foreach (var item in trip.Schedules.SelectMany(s => s.DeliveryItems))
                            {
                                var percent = (item.Quantity > 0) ? ((double)(item.ActualQuantity ?? 0) / (double)item.Quantity * 100) : 0;
                                <div class="card-item-progress" data-vin="@(item.Item?.VIN ?? "")">
                                    <div class="item-info">
                                        <div class="d-flex flex-column">
                                            @if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber) && !string.IsNullOrEmpty(item.Item?.VIN))
                                            {
                                                <span class="item-vin" style="font-size: 0.9rem;">@item.Item.CustomerPartNumber/@item.Item.VIN</span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber))
                                            {
                                                <span class="item-vin" style="font-size: 0.9rem;">@item.Item.CustomerPartNumber</span>
                                            }
                                            else
                                            {
                                                <span class="item-vin">@(item.Item?.VIN ?? "-")</span>
                                            }
                                        </div>
                                        <span class="item-progress-val @(percent >= 100 ? "text-success" : "text-info")">
                                            @((item.ActualQuantity ?? 0).ToString("G29")) / @item.Quantity.ToString("G29")
                                        </span>
                                    </div>
                                    <div class="progress progress-mini">
                                        <div class="progress-bar @(percent >= 100 ? "bg-success" : "bg-info")" 
                                             role="progressbar" style="width: @percent%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="prep-card-footer">
                        @if (!trip.Schedules.All(s => s.ActualEnterDockTime.HasValue))
                        {
                            <div class="text-center text-white-50">
                                <small><i class="bi bi-upc-scan me-1"></i> SCAN SEMUA ITEM UNTUK SELESAI</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center">
                                <span class="badge bg-success w-100 py-3" style="font-size: 0.9rem; border-radius: 8px;">
                                    <i class="bi bi-check-circle-fill me-2"></i> MASUK DOCK: @(trip.Schedules.First(s => s.ActualEnterDockTime.HasValue).ActualEnterDockTime?.ToString("HH:mm") ?? "-")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // SignalR Connection
        var connection = new signalR.HubConnectionBuilder().withUrl("/deliveryHub").build();

        connection.on("DeliveryUpdated", function (data) {
            console.log("Update received:", data);
            
            var action = data.action || data.Action;
            var scheduleNum = data.scheduleNumber || data.ScheduleNumber;

            if (action === "preparation" && scheduleNum) {
                var selector = `.prep-card[data-schedule-number='${scheduleNum}']`;
                var card = document.querySelector(selector);
                
                if (card) {
                    // 1. Update UI Elements directly (No Reload)
                    updateCardUI(card, data);

                    // 2. Move to Top
                    var container = document.querySelector('.gallery-grid');
                    if (container) container.prepend(card);
                    
                    // 3. Glow Effect
                    card.classList.remove('glow-active');
                    void card.offsetWidth;
                    card.classList.add('glow-active');
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    
                    setTimeout(() => card.classList.remove('glow-active'), 10000);

                } else {
                    // Card not found (maybe new?), reload filtering might be needed but try not to disrupt
                    // location.reload(); 
                }
            } else if (action === "enterDock") {
                 // specific logic for enter dock (maybe reload or update badge)
                 location.reload();
            }
        });

        function updateCardUI(card, data) {
            // Update Header Color & Text
            var header = card.querySelector('.prep-card-header');
            if (header) {
                var status = data.status || data.Status;
                var prepStatus = data.preparationStatus || data.PreparationStatus;
                
                header.classList.remove('header-scheduled', 'header-preparing', 'header-prepared');
                
                if ((status === "Preparing" || status === "In Progress" || prepStatus === "Preparing" || prepStatus === "In Progress") && status !== "Completed" && prepStatus !== "Prepared") {
                    header.classList.add('header-preparing');
                    var badge = header.querySelector('.badge-status');
                    if(badge) badge.innerText = "PREPARING";
                } else if (status === "Completed" || prepStatus === "Prepared") {
                    header.classList.add('header-prepared');
                    var badge = header.querySelector('.badge-status');
                    if(badge) badge.innerText = "COMPLETED";
                } else {
                    header.classList.add('header-scheduled');
                }
            }

            // Update Item Progress Bars
            if (data.items || data.Items) {
                var items = data.items || data.Items;
                items.forEach(item => {
                    var vin = item.vin || item.VIN;
                    var actual = item.actual || item.Actual;
                    var target = item.target || item.Target;
                    var percent = item.percent || item.Percent;
                    
                    // Find the progress row for this VIN inside the card
                    var row = card.querySelector(`.card-item-progress[data-vin='${vin}']`);
                    if (row) {
                        // Update text
                        var textEl = row.querySelector('.item-progress-val');
                        if (textEl) {
                            textEl.innerText = `${actual} / ${target}`;
                            if (percent >= 100) textEl.className = 'item-progress-val text-success';
                            else textEl.className = 'item-progress-val text-info';
                        }
                        
                        // Update Bar
                        var bar = row.querySelector('.progress-bar');
                        if (bar) {
                            bar.style.width = `${percent}%`;
                            if (percent >= 100) {
                                bar.className = 'progress-bar bg-success';
                            } else {
                                bar.className = 'progress-bar bg-info';
                            }
                        }
                    }
                });
            }
        }

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        // Remove auto-reload to keep state stable
        // setTimeout(function() { location.reload(); }, 60000);
    </script>
}
