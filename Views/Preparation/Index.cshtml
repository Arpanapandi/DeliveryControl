@model IEnumerable<DeliveryControl.Models.DeliverySchedule>

@{
    ViewData["Title"] = "Portal Preparation - Overview Detail";
    var selectedDate = ViewData["SelectedDate"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dayName = ViewData["DayName"]?.ToString() ?? "";
}

<style>
    :root {
        --cyber-yellow: #facc15;
        --cyber-bg: #0f172a;
        --cyber-card-bg: #1e293b;
        --cyber-border: #334155;
        --cyber-text-muted: #94a3b8;
    }

    body {
        background-color: var(--cyber-bg);
        color: white;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); /* Better fit for tablet */
        gap: 1.5rem;
        padding: 1rem 0;
    }

    .prep-card {
        background: var(--cyber-card-bg);
        border: 2px solid var(--cyber-border);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    }

    .prep-card:hover {
        transform: translateY(-5px);
        border-color: var(--cyber-yellow);
        box-shadow: 0 0 20px rgba(250, 204, 21, 0.2);
    }

    .prep-card-header {
        padding: 12px 15px; /* More padding */
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 800;
        font-size: 1rem; /* Larger font */
    }

    .header-scheduled { background: var(--cyber-yellow); color: #000; }
    .header-preparing { background: #06b6d4; color: white; } /* Cyan-500 equivalent */
    .header-prepared { background: #198754; color: white; }

    .prep-card-body {
        padding: 20px; /* More padding */
        flex-grow: 1;
        color: white;
    }

    .customer-name {
        font-size: 1.4rem; /* Larger name */
        font-weight: 700;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-transform: uppercase;
    }

    .detail-row {
        display: flex;
        margin-bottom: 8px; /* More spacing */
        font-size: 1rem; /* Base 16px equivalent */
    }

    .detail-label {
        color: var(--cyber-text-muted);
        width: 150px; /* Wider label */
        flex-shrink: 0;
    }

    .detail-value {
        font-weight: 600;
    }

    .icon-spacing {
        width: 24px;
        display: inline-block;
        text-align: center;
        margin-right: 8px;
    }

    .prep-card-footer {
        padding: 15px;
        background: rgba(0,0,0,0.2);
        border-top: 1px solid var(--cyber-border);
    }

    .btn-dock {
        background: var(--cyber-yellow);
        border: none;
        color: black;
        font-weight: 700;
        width: 100%;
        padding: 14px; /* Larger button */
        border-radius: 8px;
        text-transform: uppercase;
        font-size: 1rem; /* Larger font */
        display: block;
        text-align: center;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-dock:hover {
        background: #eab308;
        color: #000;
    }

    .quick-status {
        font-size: 0.85rem;
        color: var(--cyber-yellow);
        text-align: center;
        margin-top: 10px;
        font-weight: 600;
        cursor: pointer;
        background: transparent;
        border: none;
        width: 100%;
    }

    .badge-status {
        background: white;
        color: #1e293b;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .card-items-list {
        margin-top: 15px;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 10px;
    }

    .card-item-progress {
        margin-bottom: 10px;
    }

    .item-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 2px;
    }

    .item-vin {
        color: var(--cyber-yellow);
        font-weight: 600;
    }

    .item-progress-val {
        font-weight: 700;
    }

    .progress-mini {
        height: 6px;
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
    }

    .filter-bar {
        background: var(--cyber-card-bg);
        border: 1px solid var(--cyber-border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .cyber-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid var(--cyber-border) !important;
        color: white !important;
    }

    .btn-cyber-outline {
        border: 1px solid var(--cyber-yellow);
        color: var(--cyber-yellow);
        transition: 0.3s;
    }

    .btn-cyber-outline:hover {
        background: var(--cyber-yellow);
        color: black;
    }

    @@keyframes glow-pulse {
        0% { box-shadow: 0 0 5px var(--cyber-yellow); border-color: var(--cyber-yellow); }
        50% { box-shadow: 0 0 25px var(--cyber-yellow); border-color: #fff; transform: scale(1.02); }
        100% { box-shadow: 0 0 5px var(--cyber-yellow); border-color: var(--cyber-yellow); }
    }

    .glow-active {
        animation: glow-pulse 1.5s infinite;
        z-index: 100;
        border-color: var(--cyber-yellow) !important;
    }
</style>

<div class="container-fluid py-4">
    <!-- ... header content ... -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-1"><i class="bi bi-box-seam me-2 text-warning"></i> Portal Preparation</h2>
            <p class="text-secondary mb-0">Rangkuman detail item dan konfirmasi masuk dock.</p>
        </div>
        <div class="text-end">
            <h5 class="text-yellow mb-0">@dayName</h5>
            <small class="text-white-50">@DateTime.Now.ToString("HH:mm:ss")</small>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar shadow-sm">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-white-50 small fw-bold">PILIH TANGGAL</label>
                <input type="date" name="selectedDate" value="@selectedDate" class="form-control cyber-input" onchange="this.form.submit()" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-white-50 small fw-bold">CUSTOMER</label>
                <select name="customerId" class="form-select cyber-input" onchange="this.form.submit()">
                    <option value="">Semua Customer</option>
                    @if (ViewBag.Customers != null)
                    {
                        foreach (var c in ViewBag.Customers)
                        {
                            bool isSel = ViewData["SelectedCustomerId"]?.ToString() == c.CustomerId.ToString();
                            <option value="@c.CustomerId" selected="@isSel">@c.CustomerName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-white-50 small fw-bold">CYCLE</label>
                <select name="cycle" class="form-select cyber-input" onchange="this.form.submit()">
                    <option value="">Semua</option>
                    @if (ViewBag.Cycles != null)
                    {
                        foreach (var cy in ViewBag.Cycles)
                    {
                            bool isSel = ViewData["SelectedCycle"]?.ToString() == cy;
                            <option value="@cy" selected="@isSel">@cy</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 offset-md-2 d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary flex-grow-1">Reset</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert bg-dark border-secondary text-info">
            <i class="bi bi-info-circle me-2"></i> Tidak ada jadwal yang ditemukan untuk kriteria ini.
        </div>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var schedule in Model.OrderBy(s => ((s.Status == "Preparing" || s.Status == "In Progress" || s.PreparationStatus == "Preparing" || s.PreparationStatus == "In Progress") && s.PreparationStatus != "Prepared" && s.Status != "Completed") ? 0 : 
                                                         (s.Status == "Completed" || s.PreparationStatus == "Prepared") ? 2 : 1)
                                            .ThenBy(s => s.ScheduledDate).ThenBy(s => s.ScheduleNumber))
            {
                var hasEnteredDock = schedule.ActualEnterDockTime.HasValue;
                
                var headerClass = "header-scheduled";
                if (schedule.PreparationStatus == "Preparing" || schedule.PreparationStatus == "In Progress" || schedule.Status == "Preparing" || schedule.Status == "In Progress") { headerClass = "header-preparing"; }
                if (schedule.PreparationStatus == "Prepared" || schedule.Status == "Completed") { headerClass = "header-prepared"; }

                <div class="prep-card @(schedule.Status == "Preparing" || schedule.Status == "In Progress" ? "highlight-card" : "")" 
                     id="card-@schedule.ScheduleId" 
                     data-schedule-number="@schedule.ScheduleNumber">
                    <div class="prep-card-header @headerClass">
                        <span>@schedule.ScheduleNumber</span>
                        <span class="badge-status">@schedule.Status?.ToUpper()</span>
                    </div>
                    <div class="prep-card-body">
                        <div class="customer-name">
                            <i class="bi bi-building"></i> @(schedule.Customer?.CustomerName ?? "Unknown")
                        </div>
                        
                        <div class="detail-row">
                            <div class="detail-label">Cycle:</div>
                            <div class="detail-value">@schedule.Cycle</div>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">Route:</div>
                            <div class="detail-value text-info">@schedule.Route</div>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label"><span class="icon-spacing"><i class="bi bi-geo-alt-fill"></i></span>Area:</div>
                            <div class="detail-value">@schedule.Area</div>
                        </div>
                        
                        <div class="mt-3 pt-2 border-top border-secondary border-opacity-25">
                            <div class="detail-row">
                                <div class="detail-label"><span class="icon-spacing"><i class="bi bi-box-arrow-in-right"></i></span>Enter Dock Time:</div>
                                <div class="detail-value">@(schedule.EnterDockTime?.ToString("HH:mm") ?? "-")</div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label"><span class="icon-spacing"><i class="bi bi-truck"></i></span>Pickup Time:</div>
                                <div class="detail-value">@(schedule.PickupTime?.ToString("HH:mm") ?? "-")</div>
                            </div>
                        </div>

                        <!-- ITEMS & PROGRESS SECTION -->
                        <div class="card-items-list">
                            @foreach (var item in schedule.DeliveryItems)
                            {
                                var percent = (item.Quantity > 0) ? ((double)(item.ActualQuantity ?? 0) / (double)item.Quantity * 100) : 0;
                                <div class="card-item-progress" data-vin="@(item.Item?.VIN ?? "")">
                                    <div class="item-info">
                                        <div class="d-flex flex-column">
                                            @if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber) && !string.IsNullOrEmpty(item.Item?.VIN))
                                            {
                                                <span class="item-vin" style="font-size: 0.9rem;">@item.Item.CustomerPartNumber/@item.Item.VIN</span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.Item?.CustomerPartNumber))
                                            {
                                                <span class="item-vin" style="font-size: 0.9rem;">@item.Item.CustomerPartNumber</span>
                                            }
                                            else
                                            {
                                                <span class="item-vin">@(item.Item?.VIN ?? "-")</span>
                                            }
                                        </div>
                                        <span class="item-progress-val @(percent >= 100 ? "text-success" : "text-info")">
                                            @((item.ActualQuantity ?? 0).ToString("G29")) / @item.Quantity.ToString("G29")
                                        </span>
                                    </div>
                                    <div class="progress progress-mini">
                                        <div class="progress-bar @(percent >= 100 ? "bg-success" : "bg-info")" 
                                             role="progressbar" style="width: @percent%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="prep-card-footer">
                        @if (!hasEnteredDock)
                        {
                            <div class="text-center py-2 text-white-50">
                                <small><i class="bi bi-upc-scan me-1"></i> SCAN SEMUA ITEM UNTUK SELESAI</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2">
                                <span class="badge bg-success w-100 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> MASUK DOCK: @(schedule.ActualEnterDockTime?.ToString("HH:mm") ?? "-")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // SignalR Connection
        var connection = new signalR.HubConnectionBuilder().withUrl("/deliveryHub").build();

        connection.on("DeliveryUpdated", function (data) {
            console.log("Update received:", data);
            
            var action = data.action || data.Action;
            var scheduleNum = data.scheduleNumber || data.ScheduleNumber;

            if (action === "preparation" && scheduleNum) {
                var selector = `.prep-card[data-schedule-number='${scheduleNum}']`;
                var card = document.querySelector(selector);
                
                if (card) {
                    // 1. Update UI Elements directly (No Reload)
                    updateCardUI(card, data);

                    // 2. Move to Top
                    var container = document.querySelector('.gallery-grid');
                    if (container) container.prepend(card);
                    
                    // 3. Glow Effect
                    card.classList.remove('glow-active');
                    void card.offsetWidth;
                    card.classList.add('glow-active');
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    
                    setTimeout(() => card.classList.remove('glow-active'), 10000);

                } else {
                    // Card not found (maybe new?), reload filtering might be needed but try not to disrupt
                    // location.reload(); 
                }
            } else if (action === "enterDock") {
                 // specific logic for enter dock (maybe reload or update badge)
                 location.reload();
            }
        });

        function updateCardUI(card, data) {
            // Update Header Color & Text
            var header = card.querySelector('.prep-card-header');
            if (header) {
                var status = data.status || data.Status;
                var prepStatus = data.preparationStatus || data.PreparationStatus;
                
                header.classList.remove('header-scheduled', 'header-preparing', 'header-prepared');
                
                if ((status === "Preparing" || status === "In Progress" || prepStatus === "Preparing" || prepStatus === "In Progress") && status !== "Completed" && prepStatus !== "Prepared") {
                    header.classList.add('header-preparing');
                    var badge = header.querySelector('.badge-status');
                    if(badge) badge.innerText = "PREPARING";
                } else if (status === "Completed" || prepStatus === "Prepared") {
                    header.classList.add('header-prepared');
                    var badge = header.querySelector('.badge-status');
                    if(badge) badge.innerText = "COMPLETED";
                } else {
                    header.classList.add('header-scheduled');
                }
            }

            // Update Item Progress Bars
            if (data.items || data.Items) {
                var items = data.items || data.Items;
                items.forEach(item => {
                    var vin = item.vin || item.VIN;
                    var actual = item.actual || item.Actual;
                    var target = item.target || item.Target;
                    var percent = item.percent || item.Percent;
                    
                    // Find the progress row for this VIN inside the card
                    var row = card.querySelector(`.card-item-progress[data-vin='${vin}']`);
                    if (row) {
                        // Update text
                        var textEl = row.querySelector('.item-progress-val');
                        if (textEl) {
                            textEl.innerText = `${actual} / ${target}`;
                            if (percent >= 100) textEl.className = 'item-progress-val text-success';
                            else textEl.className = 'item-progress-val text-info';
                        }
                        
                        // Update Bar
                        var bar = row.querySelector('.progress-bar');
                        if (bar) {
                            bar.style.width = `${percent}%`;
                            if (percent >= 100) {
                                bar.className = 'progress-bar bg-success';
                            } else {
                                bar.className = 'progress-bar bg-info';
                            }
                        }
                    }
                });
            }
        }

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        // Remove auto-reload to keep state stable
        // setTimeout(function() { location.reload(); }, 60000);
    </script>
}
