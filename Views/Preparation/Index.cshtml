@model IEnumerable<DeliveryControl.Models.DeliverySchedule>

@{
    ViewData["Title"] = "Portal Preparation - Konfirmasi Masuk Dock";
    var selectedDate = ViewData["SelectedDate"]?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dayName = ViewData["DayName"]?.ToString() ?? "";
    var selectedStatus = ViewData["SelectedStatus"]?.ToString() ?? "";
}

@* Hidden form for anti-forgery token *@
<form id="hiddenTokenForm" style="display:none;">
</form>

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-box-seam"></i> Portal Preparation - Konfirmasi Masuk Dock</h2>
        <p class="text-muted">Konfirmasi waktu masuk dock untuk persiapan loading - Filter berdasarkan tanggal Enter Dock</p>
    </div>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body">
        <form id="filterForm" asp-controller="Preparation" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="selectedDate"><i class="bi bi-calendar"></i> Pilih Tanggal</label>
                <input type="date" 
                       class="form-control" 
                       name="selectedDate" 
                       id="selectedDate"
                       value="@selectedDate"
                       onchange="this.form.submit()" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="customerId"><i class="bi bi-building"></i> Nama Customer</label>
                <select class="form-select" name="customerId" id="customerId" onchange="this.form.submit()">
                    <option value="">Semua Customer</option>
                    @if (ViewBag.Customers != null)
                    {
                        @foreach (var customer in ViewBag.Customers)
                        {
                            var isSelected = ViewData["SelectedCustomerId"]?.ToString() == customer.CustomerId.ToString();
                            @if (isSelected)
                            {
                                <option value="@customer.CustomerId" selected>@customer.CustomerName</option>
                            }
                            else
                            {
                                <option value="@customer.CustomerId">@customer.CustomerName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="cycleFilter"><i class="bi bi-arrow-repeat"></i> Cycle</label>
                <select class="form-select" name="cycle" id="cycleFilter" onchange="this.form.submit()">
                    @{
                        var selectedCycle = ViewData["SelectedCycle"]?.ToString() ?? "";
                        var cycles = ViewBag.Cycles as List<string> ?? new List<string>();
                    }
                    <option value="">Semua Cycle</option>
                    @foreach (var cy in cycles)
                    {
                        var isSelectedCycle = string.Equals(selectedCycle, cy, StringComparison.OrdinalIgnoreCase);
                        if (isSelectedCycle)
                        {
                            <option value="@cy" selected>@cy</option>
                        }
                        else
                        {
                            <option value="@cy">@cy</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-funnel"></i> Status</label>
                @{
                    var normStatus = selectedStatus?.Trim();

                    bool isScheduled = string.Equals(normStatus, "Scheduled", StringComparison.OrdinalIgnoreCase);
                    bool isInProgress = string.Equals(normStatus, "In Progress", StringComparison.OrdinalIgnoreCase);
                    bool isCompleted = string.Equals(normStatus, "Completed", StringComparison.OrdinalIgnoreCase);

                    var scheduledClass = (isScheduled ? "btn-warning text-dark" : "btn-outline-warning text-warning") + " btn btn-sm flex-fill fw-semibold";
                    var inProgressClass = (isInProgress ? "btn-info text-dark" : "btn-outline-info text-info") + " btn btn-sm flex-fill fw-semibold";
                    var completedClass = (isCompleted ? "btn-success" : "btn-outline-success text-success") + " btn btn-sm flex-fill fw-semibold";
                }
                <div class="d-flex flex-wrap gap-2 w-100">
                    <button type="submit"
                            name="status"
                            value="Scheduled"
                            class="@scheduledClass">
                        Scheduled
                    </button>
                    <button type="submit"
                            name="status"
                            value="In Progress"
                            class="@inProgressClass">
                        In&nbsp;Progress
                    </button>
                    <button type="submit"
                            name="status"
                            value="Completed"
                            class="@completedClass">
                        Completed
                    </button>
                </div>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-controller="Preparation" asp-action="Index" class="btn btn-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

@{
    var needAction = ViewBag.NeedActionSchedules as List<DeliveryControl.Models.DeliverySchedule> ?? new List<DeliveryControl.Models.DeliverySchedule>();
    var completed = ViewBag.CompletedSchedules as List<DeliveryControl.Models.DeliverySchedule> ?? new List<DeliveryControl.Models.DeliverySchedule>();
}

<!-- Schedule List -->
@if (!needAction.Any() && !completed.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Tidak ada jadwal delivery untuk tanggal ini.
    </div>
}
else
{
    <!-- SECTION: BUTUH AKSI PREPARATION (BELUM MASUK DOCK) -->
    <div class="mb-3">
        <h4 class="mb-3">
            <i class="bi bi-exclamation-circle text-warning"></i> BUTUH AKSI PREPARATION (BELUM MASUK DOCK)
        </h4>

        @if (!needAction.Any())
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i> Tidak ada jadwal yang butuh aksi preparation.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var schedule in needAction)
                {
                    var hasEnteredDock = schedule.ActualEnterDockTime.HasValue;
                    var displayStatus = schedule.PreparationStatus ?? schedule.Status;
                    var statusBadge = displayStatus switch
                    {
                        "Scheduled" => "bg-warning",
                        "In Progress" => "bg-info",
                        "Completed" => "bg-success",
                        "Cancelled" => "bg-danger",
                        "Delayed" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 @(hasEnteredDock ? "border-success" : "border-warning")">
                            <div class="card-header @statusBadge text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@schedule.ScheduleNumber</strong>
                                    <span class="badge bg-white text-dark">@displayStatus</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-building"></i> @(schedule.Customer?.CustomerName ?? "-")
                                </h5>
                                
                                <!-- INFO TANGGAL DELIVERY/PICKUP -->
                                @if (schedule.PickupTime.HasValue)
                                {
                                    var pickupDate = schedule.PickupTime.Value.Date;
                                    var isToday = pickupDate == DateTime.Today;
                                    var isTomorrow = pickupDate == DateTime.Today.AddDays(1);
                                    var dateLabel = isToday ? "HARI INI" : (isTomorrow ? "BESOK" : pickupDate.ToString("dd/MM/yyyy"));
                                    var badgeColor = isToday ? "bg-success" : (isTomorrow ? "bg-info" : "bg-secondary");
                                    
                                    <div class="alert alert-primary py-2 mb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="mb-0">
                                                <i class="bi bi-calendar-check"></i> <strong>Tanggal Delivery:</strong>
                                            </small>
                                            <span class="badge @badgeColor">
                                                @dateLabel - @schedule.PickupTime.Value.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </div>
                                }
                                
                                <hr />
                                
                                <div class="mb-2">
                                    <small class="text-muted">Cycle:</small>
                                    <div class="fw-bold" style="font-size: 1.4rem;">
                                        @{
                                            var cycle = !string.IsNullOrWhiteSpace(schedule.Cycle)
                                                ? schedule.Cycle
                                                : (schedule.Customer?.Cycle ?? "-");
                                        }
                                        @cycle
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(schedule.Route))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted">Route:</small>
                                        <div>@schedule.Route</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(schedule.Area))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted">Area:</small>
                                        <div><i class="bi bi-geo-alt"></i> @schedule.Area</div>
                                    </div>
                                }

                                <hr />

                                <!-- Enter Dock Time -->
                                @if (schedule.EnterDockTime.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-clock"></i> Enter Dock Time (Target):</small>
                                        <div><strong>@schedule.EnterDockTime.Value.ToString("HH:mm")</strong></div>
                                    </div>
                                }

                                <!-- Pickup Time -->
                                @if (schedule.PickupTime.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-clock"></i> Pickup Time (Target):</small>
                                        <div><strong>@schedule.PickupTime.Value.ToString("HH:mm")</strong></div>
                                    </div>
                                }

                                <!-- ETD -->
                                @if (schedule.ETD.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted"><i class="bi bi-arrow-right-circle"></i> ETD (Target):</small>
                                        <div><strong>@schedule.ETD.Value.ToString("HH:mm")</strong></div>
                                    </div>
                                }

                                <hr />

                                <!-- Actual Enter Dock -->
                                @if (hasEnteredDock)
                                {
                                    var isLate = false;
                                    var delayMinutes = 0;
                                    if (schedule.EnterDockTime.HasValue)
                                    {
                                        var delay = schedule.ActualEnterDockTime!.Value - schedule.EnterDockTime.Value;
                                        if (delay.TotalMinutes > 0)
                                        {
                                            isLate = true;
                                            delayMinutes = (int)delay.TotalMinutes;
                                        }
                                    }

                                    <div class="alert @(isLate ? "alert-danger" : "alert-success") py-2 mb-2">
                                        <small><i class="bi bi-check-circle"></i> <strong>Masuk Dock:</strong></small>
                                        <div><strong>@schedule.ActualEnterDockTime!.Value.ToString("HH:mm")</strong></div>
                                        @if (isLate)
                                        {
                                            <small class="text-danger">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Terlambat +@delayMinutes m
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-success">
                                                <i class="bi bi-check-circle-fill"></i> On Time
                                            </small>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(schedule.DriverName))
                                {
                                    <div class="mt-2">
                                        <small class="text-muted"><i class="bi bi-person"></i> Driver:</small>
                                        <div><strong>@schedule.DriverName</strong></div>
                                    </div>
                                }
                            </div>
                            <div class="card-footer">
                                @if (!hasEnteredDock)
                                {
                                    <!-- Belum konfirmasi masuk dock -->
                                    <div class="d-grid gap-2">
                                        <a asp-action="EnterDock" asp-route-id="@schedule.ScheduleId" class="btn btn-warning">
                                            <i class="bi bi-box-arrow-in-right"></i> Konfirmasi Masuk Dock
                                        </a>
                                        <form asp-action="QuickEnterDock" asp-route-id="@schedule.ScheduleId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning btn-sm w-100" 
                                                    onclick="return confirm('Konfirmasi masuk dock SEKARANG?')">
                                                <i class="bi bi-lightning-fill"></i> Quick - Masuk Dock Sekarang
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <!-- Sudah masuk dock -->
                                    <div class="d-grid">
                                        <a asp-action="Details" asp-route-id="@schedule.ScheduleId" class="btn btn-success">
                                            <i class="bi bi-check-circle-fill"></i> Sudah Masuk Dock - Lihat Detail
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <hr class="my-4" />

    <!-- SECTION: SUDAH MASUK DOCK / TIDAK PERLU AKSI -->
    <div class="mb-3">
        <h4 class="mb-3">
            <i class="bi bi-check2-circle text-success"></i> SUDAH MASUK DOCK / TIDAK PERLU AKSI
        </h4>

        @if (!completed.Any())
        {
            <div class="alert alert-secondary">
                <i class="bi bi-info-circle"></i> Belum ada jadwal yang sudah masuk dock.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var schedule in completed)
        {
            var hasEnteredDock = schedule.ActualEnterDockTime.HasValue;
            var displayStatus = schedule.PreparationStatus ?? schedule.Status;
            var statusBadge = displayStatus switch
            {
                "Scheduled" => "bg-warning",
                "In Progress" => "bg-info",
                "Completed" => "bg-success",
                "Cancelled" => "bg-danger",
                "Delayed" => "bg-danger",
                _ => "bg-secondary"
            };
            
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card h-100 @(hasEnteredDock ? "border-success" : "border-warning")">
                    <div class="card-header @statusBadge text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@schedule.ScheduleNumber</strong>
                            <span class="badge bg-white text-dark">@displayStatus</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-building"></i> @(schedule.Customer?.CustomerName ?? "-")
                        </h5>
                        
                        <!-- INFO TANGGAL DELIVERY/PICKUP -->
                        @if (schedule.PickupTime.HasValue)
                        {
                            var pickupDate = schedule.PickupTime.Value.Date;
                            var isToday = pickupDate == DateTime.Today;
                            var isTomorrow = pickupDate == DateTime.Today.AddDays(1);
                            var dateLabel = isToday ? "HARI INI" : (isTomorrow ? "BESOK" : pickupDate.ToString("dd/MM/yyyy"));
                            var badgeColor = isToday ? "bg-success" : (isTomorrow ? "bg-info" : "bg-secondary");
                            
                            <div class="alert alert-primary py-2 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="mb-0">
                                        <i class="bi bi-calendar-check"></i> <strong>Tanggal Delivery:</strong>
                                    </small>
                                    <span class="badge @badgeColor">
                                        @dateLabel - @schedule.PickupTime.Value.ToString("HH:mm")
                                    </span>
                                </div>
                            </div>
                        }
                        
                        <hr />
                        
                        <div class="mb-2">
                            <small class="text-muted">Cycle:</small>
                            <div class="fw-bold" style="font-size: 1.4rem;">
                                @{
                                    var cycle = !string.IsNullOrWhiteSpace(schedule.Cycle)
                                        ? schedule.Cycle
                                        : (schedule.Customer?.Cycle ?? "-");
                                }
                                @cycle
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(schedule.Route))
                        {
                            <div class="mb-2">
                                <small class="text-muted">Route:</small>
                                <div>@schedule.Route</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(schedule.Area))
                        {
                            <div class="mb-2">
                                <small class="text-muted">Area:</small>
                                <div><i class="bi bi-geo-alt"></i> @schedule.Area</div>
                            </div>
                        }

                        <hr />

                        <!-- Enter Dock Time -->
                        @if (schedule.EnterDockTime.HasValue)
                        {
                            <div class="mb-2">
                                <small class="text-muted"><i class="bi bi-clock"></i> Enter Dock Time (Target):</small>
                                <div><strong>@schedule.EnterDockTime.Value.ToString("HH:mm")</strong></div>
                            </div>
                        }

                        <!-- Pickup Time -->
                        @if (schedule.PickupTime.HasValue)
                        {
                            <div class="mb-2">
                                <small class="text-muted"><i class="bi bi-clock"></i> Pickup Time (Target):</small>
                                <div><strong>@schedule.PickupTime.Value.ToString("HH:mm")</strong></div>
                            </div>
                        }

                        <!-- ETD -->
                        @if (schedule.ETD.HasValue)
                        {
                            <div class="mb-2">
                                <small class="text-muted"><i class="bi bi-arrow-right-circle"></i> ETD (Target):</small>
                                <div><strong>@schedule.ETD.Value.ToString("HH:mm")</strong></div>
                            </div>
                        }

                        <hr />

                        <!-- Actual Enter Dock -->
                        @if (hasEnteredDock)
                        {
                            var isLate = false;
                            var delayMinutes = 0;
                            if (schedule.EnterDockTime.HasValue)
                            {
                                var delay = schedule.ActualEnterDockTime!.Value - schedule.EnterDockTime.Value;
                                if (delay.TotalMinutes > 0)
                                {
                                    isLate = true;
                                    delayMinutes = (int)delay.TotalMinutes;
                                }
                            }

                            <div class="alert @(isLate ? "alert-danger" : "alert-success") py-2 mb-2">
                                <small><i class="bi bi-check-circle"></i> <strong>Masuk Dock:</strong></small>
                                <div><strong>@schedule.ActualEnterDockTime!.Value.ToString("HH:mm")</strong></div>
                                @if (isLate)
                                {
                                    <small class="text-danger">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Terlambat +@delayMinutes m
                                    </small>
                                }
                                else
                                {
                                    <small class="text-success">
                                        <i class="bi bi-check-circle-fill"></i> On Time
                                    </small>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(schedule.DriverName))
                        {
                            <div class="mt-2">
                                <small class="text-muted"><i class="bi bi-person"></i> Driver:</small>
                                <div><strong>@schedule.DriverName</strong></div>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        @if (!hasEnteredDock)
                        {
                            <!-- Belum konfirmasi masuk dock -->
                            <div class="d-grid gap-2">
                                <a asp-action="EnterDock" asp-route-id="@schedule.ScheduleId" class="btn btn-warning">
                                    <i class="bi bi-box-arrow-in-right"></i> Konfirmasi Masuk Dock
                                </a>
                                <form asp-action="QuickEnterDock" asp-route-id="@schedule.ScheduleId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning btn-sm w-100" 
                                            onclick="return confirm('Konfirmasi masuk dock SEKARANG?')">
                                        <i class="bi bi-lightning-fill"></i> Quick - Masuk Dock Sekarang
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <!-- Sudah masuk dock -->
                            <div class="d-grid">
                                <a asp-action="Details" asp-route-id="@schedule.ScheduleId" class="btn btn-success">
                                    <i class="bi bi-check-circle-fill"></i> Sudah Masuk Dock - Lihat Detail
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
                }
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // Pastikan form submit dengan benar dan mempertahankan nilai
        document.addEventListener('DOMContentLoaded', function() {
            var statusSelect = document.getElementById('statusSelect');
            var filterForm = document.getElementById('filterForm');
            
            if (statusSelect && filterForm) {
                // Pastikan onchange bekerja dengan benar
                statusSelect.addEventListener('change', function() {
                    // Pastikan nilai yang dipilih tersimpan
                    var selectedValue = this.value;
                    console.log('Status selected:', selectedValue);
                    
                    // Submit form
                    filterForm.submit();
                });
            }
        });

        // Auto refresh setiap 60 detik
        setTimeout(function() {
            location.reload();
        }, 60000);
        
        // Highlight waktu real-time
        setInterval(function() {
            var now = new Date();
            var timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            document.title = timeStr + ' - Portal Preparation';
        }, 1000);
    </script>
}

