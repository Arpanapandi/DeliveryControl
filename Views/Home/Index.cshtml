<!-- Statistics Cards -->
@{
    var totalToday = (int?)ViewBag.TodaySchedules ?? 0;
    var completed = (int?)ViewBag.CompletedCount ?? 0;
    var inProgress = (int?)ViewBag.InProgressCount ?? 0;
    var delayPickup = (int?)ViewBag.DelayPickupCount ?? 0;
    var notArrived = (int?)ViewBag.NotArrivedCount ?? 0;

    // Jumlah order yang seharusnya sudah delivered berdasarkan ETD sampai jam sekarang
    var now = DateTime.Now;
    var shouldBeDelivered = (int?)ViewBag.ShouldBeDeliveredCount 
        ?? (Model?.Count(x => x.ETD.HasValue && x.ETD.Value <= now) ?? 0);
    var completedDisplay = shouldBeDelivered > 0
        ? $"{completed} / {shouldBeDelivered}"
        : completed.ToString();

    double SafePercent(int part, int total)
    {
        if (total <= 0 || part <= 0) return 0;
        var p = (part * 100.0) / total;
        if (p > 100) p = 100;
        return p;
    }

    var completedPct = SafePercent(completed, totalToday);
    var inProgressPct = SafePercent(inProgress, totalToday);
    var delayPickupPct = SafePercent(delayPickup, totalToday);
    var notArrivedPct = SafePercent(notArrived, totalToday);
}
