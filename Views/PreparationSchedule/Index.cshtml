@section Scripts {

    <script>
        $(document).ready(function () {
            // Status Indicator Element
            const statusBadge = $('#connectionStatus');
            
            function updateStatus(status, color, icon) {
                if(statusBadge.length) {
                    statusBadge.removeClass('bg-secondary bg-success bg-danger bg-warning text-dark')
                              .addClass(color)
                              .html(`<i class="bi ${icon} me-1"></i> ${status}`);
                }
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deliveryHub")
                .withAutomaticReconnect([0, 2000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            connection.on("deliveryUpdated", function (data) {
                console.log("Prep update received", data);
                if (window.showUpdateNotification) {
                    window.showUpdateNotification('Jadwal preparation diperbarui.', 'prep', 4000);
                }
                setTimeout(() => window.location.reload(), 2500);
            });

            connection.onreconnecting(error => {
                updateStatus("Reconnecting...", "bg-warning text-dark", "bi-wifi-off");
            });

            connection.onreconnected(connectionId => {
                updateStatus("Live", "bg-success", "bi-wifi");
            });

            connection.onclose(error => {
                updateStatus("Offline", "bg-danger", "bi-slash-circle");
                setTimeout(start, 5000);
            });

            async function start() {
                try {
                    await connection.start();
                    console.log("Prep SignalR Connected");
                    updateStatus("Live", "bg-success", "bi-wifi");
                } catch (err) {
                    console.error("SignalR Connection Error: ", err);
                    updateStatus("Error", "bg-danger", "bi-exclamation-triangle");
                    setTimeout(start, 5000);
                }
            };

            start();

            // ============================================
            // REAL-TIME SEARCH FILTERING
            // ============================================
            $('#searchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                
                $('table tbody tr').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });

                $('.cyber-mobile-card').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            // ============================================
            // CUSTOMER DROPDOWN SEARCH (IN MODAL)
            // ============================================
            $('#customerSearch').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#customerId option').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
                
                // If search result is only 1, auto-select it or just let user click
            });

            // ============================================
            // MODAL DAFTAR PENDING PREPARATION
            // ============================================
            // Handler "connected" dari DeliveryHub (mencegah SignalR warning)
            connection.on("connected", function (connectionId) {
                console.log("DeliveryHub connected:", connectionId);
            });
        });

        // openPendingModal() harus di luar $(document).ready agar bisa dipanggil dari onclick HTML
        var _pendingModal = null;
        var _pendingData = [];
        var _pendingPage = 1;
        var _pendingPageSize = 20;

        function renderPendingPage(page) {
            _pendingPage = page;
            var tbody = document.getElementById('pendingPrepBody');
            var pageInfo = document.getElementById('pendingPageInfo');
            var pageBtns = document.getElementById('pendingPageBtns');
            var pagination = document.getElementById('pendingPagination');

            var totalPages = Math.ceil(_pendingData.length / _pendingPageSize);
            var start = (page - 1) * _pendingPageSize;
            var end = Math.min(start + _pendingPageSize, _pendingData.length);
            var pageData = _pendingData.slice(start, end);

            tbody.innerHTML = pageData.map(function(r, i) {
                return '<tr>' +
                    '<td class="px-3 py-2 text-muted" style="font-size:0.78rem;">' + (start + i + 1) + '</td>' +
                    '<td class="px-3 py-2 text-nowrap" style="font-size:0.82rem;">' + r.createdDate + '</td>' +
                    '<td class="px-3 py-2"><span class="badge bg-primary" style="font-size:0.8rem;">' + r.tag + '</span></td>' +
                    '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.label + '</td>' +
                    '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.kanban + '</td>' +
                    '<td class="px-3 py-2" style="font-size:0.82rem;">' + r.createdBy + '</td>' +
                    '</tr>';
            }).join('');

            // Show/hide pagination
            if (_pendingData.length > _pendingPageSize) {
                pagination.style.display = 'flex';
                pageInfo.textContent = 'Menampilkan ' + (start + 1) + '–' + end + ' dari ' + _pendingData.length + ' data';

                var btns = '';
                // Prev
                btns += '<button onclick="renderPendingPage(' + (page - 1) + ')" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"' + (page <= 1 ? ' disabled' : '') + '><i class="bi bi-chevron-left"></i></button>';
                // Page numbers (show max 5 around current)
                var pStart = Math.max(1, page - 2);
                var pEnd = Math.min(totalPages, pStart + 4);
                pStart = Math.max(1, pEnd - 4);
                for (var p = pStart; p <= pEnd; p++) {
                    var active = (p === page) ? 'btn-warning text-dark' : 'btn-outline-warning';
                    btns += '<button onclick="renderPendingPage(' + p + ')" class="btn btn-sm ' + active + ' py-0 px-2" style="font-size:0.75rem;">' + p + '</button>';
                }
                // Next
                btns += '<button onclick="renderPendingPage(' + (page + 1) + ')" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75rem;"' + (page >= totalPages ? ' disabled' : '') + '><i class="bi bi-chevron-right"></i></button>';
                pageBtns.innerHTML = btns;
            } else {
                pagination.style.display = 'none';
            }
        }

        function openPendingModal() {
            var modalEl = document.getElementById('pendingPrepModal');
            if (!modalEl) return;
            if (!_pendingModal) {
                _pendingModal = new bootstrap.Modal(modalEl);
            }
            // Reset state
            var tbody = document.getElementById('pendingPrepBody');
            var countBadge = document.getElementById('pendingModalCount');
            var pagination = document.getElementById('pendingPagination');
            pagination.style.display = 'none';
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">' +
                '<div class="spinner-border spinner-border-sm me-2"></div>Memuat data...</td></tr>';

            _pendingModal.show();

            fetch('/PreparationWorkflow/GetPendingPreparations')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    _pendingData = data;
                    countBadge.textContent = data.length;
                    if (!data.length) {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">' +
                            '<i class="bi bi-inbox me-2"></i>Tidak ada data pending.</td></tr>';
                        return;
                    }
                    renderPendingPage(1);
                })
                .catch(function() {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-danger text-center py-3">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>Gagal memuat data.</td></tr>';
                });
        }
    </script>
}

