<script>
(function () {
    var _clearMode = 'date'; // 'date' atau 'all'
    var _clearModalInstance = null;

    function getModal() {
        if (!_clearModalInstance)
            _clearModalInstance = new bootstrap.Modal(document.getElementById('clearScheduleModal'));
        return _clearModalInstance;
    }

    window.showClearScheduleModal = function (currentFilterDate) {
        // Reset state
        _clearMode = 'date';
        document.getElementById('clearScheduleConfirmInput').value = '';
        document.getElementById('btnDoClearSchedule').disabled = true;
        document.getElementById('btnDoClearSchedule').style.opacity = '0.5';

        // Set tanggal default = filter date yang sedang aktif
        var dateInput = document.getElementById('clearDateInput');
        dateInput.value = currentFilterDate || new Date().toISOString().split('T')[0];
        updateDateInfo();
        updateModeUI();
        getModal().show();
        setTimeout(function () { document.getElementById('clearScheduleConfirmInput').focus(); }, 400);
    };

    window.setClearMode = function (mode) {
        _clearMode = mode;
        document.getElementById('clearScheduleConfirmInput').value = '';
        document.getElementById('btnDoClearSchedule').disabled = true;
        document.getElementById('btnDoClearSchedule').style.opacity = '0.5';
        updateModeUI();
    };

    function updateModeUI() {
        var isDate = _clearMode === 'date';
        // Toggle date section visibility
        document.getElementById('clearDateSection').style.display = isDate ? 'block' : 'none';

        // Button Per Tanggal - active style
        var btnDate = document.getElementById('btnModeDate');
        btnDate.style.background    = isDate ? '#1e3a8a' : '#1e3a5f';
        btnDate.style.borderColor   = isDate ? '#60a5fa' : '#3b82f6';
        btnDate.style.color         = isDate ? '#fff'    : '#93c5fd';

        // Button Semua Data - active style
        var btnAll = document.getElementById('btnModeAll');
        btnAll.style.background   = !isDate ? '#450a0a' : '#1c1010';
        btnAll.style.borderColor  = !isDate ? '#f44336' : '#4b2020';
        btnAll.style.color        = !isDate ? '#fff'    : '#fca5a5';
    }

    function updateDateInfo() {
        var val = document.getElementById('clearDateInput').value;
        var info = document.getElementById('clearDateInfo');
        if (val) {
            var d = new Date(val + 'T00:00:00');
            var opts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            info.textContent = '📅 ' + d.toLocaleDateString('id-ID', opts);
        } else {
            info.textContent = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var input   = document.getElementById('clearScheduleConfirmInput');
        var btn     = document.getElementById('btnDoClearSchedule');
        var dateInp = document.getElementById('clearDateInput');

        if (!input || !btn) return;

        dateInp.addEventListener('change', updateDateInfo);

        input.addEventListener('input', function () {
            var ok = this.value.trim().toUpperCase() === 'HAPUS';
            btn.disabled = !ok;
            btn.style.opacity = ok ? '1' : '0.5';
        });
        input.addEventListener('focus', function () { this.style.border = '1px solid #f44336'; });
        input.addEventListener('blur',  function () { this.style.border = '1px solid #2a3a5a'; });

        btn.addEventListener('click', function () {
            var self = this;
            self.disabled = true;
            self.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Menghapus...';

            var token = '';
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) token = tokenInput.value;

            var body = { mode: _clearMode };
            if (_clearMode === 'date') {
                body.date = document.getElementById('clearDateInput').value;
            }

            fetch('/PreparationSchedule/ClearPreparationData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(body)
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                getModal().hide();
                if (res.success) {
                    if (window.showUpdateNotification)
                        window.showUpdateNotification(res.message || 'Data berhasil dihapus.', 'success', 5000);
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    if (window.showUpdateNotification)
                        window.showUpdateNotification(res.message || 'Gagal menghapus data.', 'danger', 6000);
                    self.disabled = false;
                    self.style.opacity = '1';
                    self.innerHTML = '<i class="bi bi-trash3-fill me-1"></i> Hapus Sekarang';
                }
            })
            .catch(function () {
                getModal().hide();
                if (window.showUpdateNotification)
                    window.showUpdateNotification('Terjadi kesalahan koneksi.', 'danger', 6000);
                self.disabled = false;
                self.style.opacity = '1';
                self.innerHTML = '<i class="bi bi-trash3-fill me-1"></i> Hapus Sekarang';
            });
        });
    });
})();
</script>

<!-- Smart Import JavaScript -->
<script>
(function() {
    var _smartData = null; // holds preview response

    // === Drop Zone ===
    var dropZone = document.getElementById('smartDropZone');
    var fileInput = document.getElementById('smartFile');

    if (dropZone && fileInput) {
        dropZone.addEventListener('click', function() { fileInput.click(); });
        dropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '#ffc107';
            dropZone.style.background = 'rgba(255,193,7,0.05)';
        });
        dropZone.addEventListener('dragleave', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
        });
        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.style.borderColor = '';
            dropZone.style.background = '';
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                smartImportUpload(e.dataTransfer.files[0]);
            }
        });
        fileInput.addEventListener('change', function() {
            if (this.files.length > 0) smartImportUpload(this.files[0]);
        });
    }

    // === Upload & Preview ===
    window.smartImportUpload = function(file) {
        var maxSize = 10 * 1024 * 1024;
        if (file.size > maxSize) {
            alert('File terlalu besar! Maksimal 10MB.');
            return;
        }
        var allowed = ['.pdf','.xlsx','.xls','.csv','.txt'];
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        if (allowed.indexOf(ext) < 0) {
            alert('Format tidak didukung! Gunakan PDF, Excel, CSV, atau TXT.');
            return;
        }

        // Show progress
        document.getElementById('smartStep1').querySelector('#smartDropZone').classList.add('d-none');
        document.getElementById('smartProgress').classList.remove('d-none');
        document.getElementById('smartProgressText').textContent = 'Menganalisa ' + file.name + '...';

        var formData = new FormData();
        formData.append('file', file);

        fetch('/PreparationSchedule/SmartImportPreview', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.success) {
                alert('Error: ' + (data.errorMessage || 'Gagal memproses file.'));
                smartImportReset();
                return;
            }
            _smartData = data;
            showSmartPreview(data);
        })
        .catch(function(err) {
            alert('Error koneksi: ' + err.message);
            smartImportReset();
        });
    };

    function showSmartPreview(data) {
        // Hide step 1, show step 2
        document.getElementById('smartStep1').classList.add('d-none');
        document.getElementById('smartStep2').classList.remove('d-none');

        // Detection info
        var custEl = document.getElementById('smartDetectedCustomer');
        if (data.customerId) {
            custEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>' + (data.detectedCustomerCode || data.detectedCustomer);
            custEl.className = 'fw-bold text-success small';
        } else {
            custEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>' + (data.detectedCustomer || 'UNKNOWN');
            custEl.className = 'fw-bold text-warning small';
        }

        document.getElementById('smartDetectedManifest').textContent = data.detectedManifest || '(tidak terdeteksi)';

        // Tampilkan route/cycle yang terdeteksi dari file
        var parserInfo = (data.fileFormat || '').toUpperCase() + ' / ' + (data.parserUsed || 'GENERIC');
        if (data.detectedRoute) parserInfo += '  |  Route: <b class="text-info">' + escapeHtml(data.detectedRoute) + '</b>';
        if (data.detectedCycle) parserInfo += '  Cycle: <b class="text-info">' + escapeHtml(data.detectedCycle) + '</b>';
        document.getElementById('smartParserInfo').innerHTML = parserInfo;

        // Simpan detected route/cycle untuk highlight dock
        window._smartDetectedRoute = (data.detectedRoute || '').trim().toUpperCase();
        window._smartDetectedCycle = (data.detectedCycle || '').trim().toUpperCase();

        // Warnings
        var warnDiv = document.getElementById('smartWarnings');
        if (data.warnings && data.warnings.length > 0) {
            var warnHtml = '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-3 p-2 small">';
            for (var i = 0; i < data.warnings.length; i++) {
                warnHtml += '<i class="bi bi-exclamation-triangle me-1"></i>' + data.warnings[i] + '<br>';
            }
            warnHtml += '</div>';
            warnDiv.innerHTML = warnHtml;
            warnDiv.classList.remove('d-none');
        } else {
            warnDiv.classList.add('d-none');
        }

        // Dock grid — single scrollable list
        var dockGrid = document.getElementById('smartDockGrid');
        var hiddenDockId = document.getElementById('smartSelectedDockId');
        dockGrid.innerHTML = '';
        hiddenDockId.value = '';
        window._smartDockItems = []; // store for search filtering

        // Build dock list from matchedDocks (priority) or customerList
        var dockList = (data.matchedDocks && data.matchedDocks.length > 0) ? data.matchedDocks : (data.customerList || []);
        var preselectedId = data.customerId || null;

        for (var i = 0; i < dockList.length; i++) {
            (function(d, idx) {
                var row = document.createElement('div');
                row.className = 'smart-dock-row d-flex align-items-center px-2 py-1 border-bottom border-secondary';
                row.style.cssText = 'cursor:pointer; font-size:0.78rem; transition:background .15s;';
                row.setAttribute('data-dock-id', d.customerId);
                row.setAttribute('data-search', ((d.dockName||'') + ' ' + (d.customerCode||'') + ' ' + (d.route||'')).toLowerCase());

                // Cek apakah dock ini cocok dengan route yang terdeteksi dari file
                var detectedRoute = window._smartDetectedRoute || '';
                var dRoute = (d.route || '').trim().toUpperCase();
                var dDocking = (d.docking || '').trim().toUpperCase();
                var dName = (d.dockName || '').trim().toUpperCase();
                var isRouteMatch = detectedRoute && (
                    dRoute.indexOf(detectedRoute) > -1 ||
                    dDocking.indexOf(detectedRoute) > -1 ||
                    dName.indexOf(detectedRoute) > -1
                );

                var icon = isRouteMatch
                    ? '<i class="bi bi-geo-alt-fill text-warning me-1" style="font-size:0.7rem"></i>'
                    : '<i class="bi bi-geo-alt text-info me-1" style="font-size:0.7rem"></i>';

                var info = '<b>' + escapeHtml(d.dockName || d.customerName || '') + '</b>';
                info += ' <span class="text-muted">— ' + escapeHtml(d.customerCode || '') + '</span>';
                if (d.route) {
                    var rClass = isRouteMatch ? 'text-warning fw-bold' : 'text-secondary';
                    info += ' <span class="' + rClass + ' ms-1" style="font-size:0.7rem">R:' + escapeHtml(d.route) + '</span>';
                }
                if (d.cycle) info += ' <span class="text-secondary" style="font-size:0.7rem">C:' + escapeHtml(d.cycle) + '</span>';
                if (d.docking) info += ' <span class="text-secondary" style="font-size:0.7rem">D:' + escapeHtml(d.docking) + '</span>';

                // Badge "✓ Route Match" jika cocok
                if (isRouteMatch) {
                    info += ' <span class="badge bg-warning text-dark ms-1" style="font-size:0.6rem">Route Match</span>';
                }

                row.innerHTML = icon + '<span class="flex-grow-1">' + info + '</span>';

                // Pre-select
                if (preselectedId && d.customerId == preselectedId) {
                    row.style.background = '#1a5276';
                    hiddenDockId.value = d.customerId;
                }

                row.addEventListener('mouseenter', function() { if (hiddenDockId.value != d.customerId) this.style.background = '#1c2e3f'; });
                row.addEventListener('mouseleave', function() { if (hiddenDockId.value != d.customerId) this.style.background = ''; });
                row.addEventListener('click', function() {
                    dockGrid.querySelectorAll('.smart-dock-row').forEach(function(r) { r.style.background = ''; });
                    this.style.background = '#1a5276';
                    hiddenDockId.value = d.customerId;
                });

                dockGrid.appendChild(row);
                window._smartDockItems.push(row);
            })(dockList[i], i);
        }

        if (dockList.length === 0) {
            dockGrid.innerHTML = '<div class="text-muted text-center py-2 small">Tidak ada dock tersedia</div>';
        }

        // Dock search filter
        var dockSearch = document.getElementById('smartDockSearch');
        if (dockSearch) {
            dockSearch.value = '';
            dockSearch.oninput = function() {
                var q = this.value.toLowerCase();
                window._smartDockItems.forEach(function(row) {
                    row.style.display = row.getAttribute('data-search').indexOf(q) > -1 ? '' : 'none';
                });
            };
        }

        // Manifest override
        document.getElementById('smartManifestOverride').value = data.detectedManifest || '';

        // Items table
        var tbody = document.getElementById('smartItemsBody');
        tbody.innerHTML = '';
        var totalQty = 0;
        var items = data.items || [];
        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            totalQty += item.qty;
            var tr = document.createElement('tr');
            // Part No cell: show part no + VIN below (if resolved)
            var vinHtml = item.vin
                ? '<div class="text-success" style="font-size:0.68rem;line-height:1.2">/ ' + escapeHtml(item.vin) + '</div>'
                : '<div class="text-secondary" style="font-size:0.68rem;line-height:1.2">VIN not mapped</div>';
            // Simpan vin di data-attribute agar bisa dibaca saat Confirm tanpa parsing DOM
            tr.setAttribute('data-vin', item.vin || '');
            tr.innerHTML =
                '<td><input type="checkbox" class="form-check-input smart-item-check" data-idx="' + i + '" checked></td>' +
                '<td class="text-muted small">' + (i + 1) + '</td>' +
                '<td><input type="text" class="form-control form-control-sm bg-dark text-white border-0 smart-manifest" value="' + escapeHtml(item.manifesting || '') + '" style="width:130px;font-size:0.75rem"></td>' +
                '<td><code class="text-info" style="font-size:0.78rem">' + escapeHtml(item.partNo) + '</code>' + vinHtml + '</td>' +
                '<td class="small text-muted">' + escapeHtml(item.partName || '') + '</td>' +
                '<td class="text-center"><input type="number" class="form-control form-control-sm bg-dark text-white border-0 text-center smart-qty" value="' + item.qty + '" min="1" style="width:70px;font-size:0.78rem"></td>' +
                '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger border-0 py-0" onclick="this.closest(\'tr\').remove();updateSmartCounts();"><i class="bi bi-x-lg" style="font-size:0.7rem"></i></button></td>';
            tbody.appendChild(tr);
        }

        // Warn if some Part Nos have no VIN mapping
        var unmapped = items.filter(function(i) { return !i.vin; });
        if (unmapped.length > 0) {
            var warnDiv = document.getElementById('smartWarnings');
            var existing = warnDiv.innerHTML;
            warnDiv.innerHTML = existing +
                '<div class="alert alert-warning bg-opacity-10 border-warning text-warning rounded-2 p-2 small mt-1">' +
                '<i class="bi bi-exclamation-triangle me-1"></i>' +
                '<b>' + unmapped.length + ' Part No</b> belum terpetakan ke VIN internal. ' +
                'Import tetap bisa dilanjutkan, tapi tambahkan mapping di <a href="/ItemMappings" target="_blank" class="text-warning">Item Mappings</a> agar sistem bisa mencocokkan part saat proses picking.' +
                '</div>';
            warnDiv.classList.remove('d-none');
        }

        updateSmartCounts();
    }

    window.updateSmartCounts = function() {
        var rows = document.querySelectorAll('#smartItemsBody tr');
        var count = 0, total = 0;
        rows.forEach(function(tr) {
            var chk = tr.querySelector('.smart-item-check');
            if (chk && chk.checked) {
                count++;
                var qtyInput = tr.querySelector('.smart-qty');
                total += parseInt(qtyInput.value) || 0;
            }
        });
        document.getElementById('smartItemCount').textContent = count;
        document.getElementById('smartTotalQty').textContent = total;
    };

    // Select all checkbox
    var selectAll = document.getElementById('smartSelectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            var checked = this.checked;
            document.querySelectorAll('.smart-item-check').forEach(function(cb) { cb.checked = checked; });
            updateSmartCounts();
        });
    }

    // Delegate change on checkboxes and qty inputs
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('smart-item-check') || e.target.classList.contains('smart-qty'))
            updateSmartCounts();
    });

    // === Reset ===
    window.smartImportReset = function() {
        _smartData = null;
        document.getElementById('smartStep1').classList.remove('d-none');
        document.getElementById('smartStep1').querySelector('#smartDropZone').classList.remove('d-none');
        document.getElementById('smartProgress').classList.add('d-none');
        document.getElementById('smartStep2').classList.add('d-none');
        document.getElementById('smartStep3').classList.add('d-none');
        document.getElementById('smartFile').value = '';
        document.getElementById('smartDockGrid').innerHTML = '';
        document.getElementById('smartSelectedDockId').value = '';
        var dockSearch = document.getElementById('smartDockSearch');
        if (dockSearch) dockSearch.value = '';
        window._smartDockItems = [];
    };

    // === Confirm & Import ===
    window.smartImportConfirm = function() {
        var custId = parseInt(document.getElementById('smartSelectedDockId').value) || null;
        if (!custId) {
            alert('Pilih Dock terlebih dahulu!');
            return;
        }

        var manifestOverride = document.getElementById('smartManifestOverride').value.trim();
        var rows = document.querySelectorAll('#smartItemsBody tr');
        var items = [];
        rows.forEach(function(tr) {
            var chk = tr.querySelector('.smart-item-check');
            if (!chk || !chk.checked) return;
            var partNo = tr.querySelector('code').textContent;
            // Ambil VIN yang sudah di-resolve saat preview (tersimpan di data-vin attribute)
            var vin = tr.getAttribute('data-vin') || '';
            var manifest = tr.querySelector('.smart-manifest').value.trim() || manifestOverride || '';
            var qty = parseInt(tr.querySelector('.smart-qty').value) || 0;
            if (partNo && qty > 0) {
                items.push({ manifesting: manifest, partNo: partNo, vin: vin, qty: qty });
            }
        });

        if (items.length === 0) {
            alert('Tidak ada item yang dipilih!');
            return;
        }

        // Get selected dock name for confirm message
        var selectedRow = document.querySelector('.smart-dock-row[data-dock-id="' + custId + '"]');
        var dockLabel = selectedRow ? selectedRow.textContent.trim() : 'ID:' + custId;
        console.log('[SmartImport] Confirm: customerId=' + custId + ', dock=' + dockLabel + ', items=' + items.length);
        if (!confirm('Import ' + items.length + ' items ke jadwal preparation hari ini?\n\nDock: ' + dockLabel + '\nCustomer ID: ' + custId)) return;

        // Show step 3 loading
        document.getElementById('smartStep2').classList.add('d-none');
        document.getElementById('smartStep3').classList.remove('d-none');
        document.getElementById('smartResultIcon').innerHTML = '<div class="spinner-border text-warning" style="width:3rem;height:3rem"></div>';
        document.getElementById('smartResultTitle').textContent = 'Menyimpan data...';
        document.getElementById('smartResultMessage').textContent = '';

        fetch('/PreparationSchedule/SmartImportConfirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customerId: custId, items: items })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.success) {
                document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
                document.getElementById('smartResultTitle').textContent = 'Import Berhasil!';
                document.getElementById('smartResultTitle').className = 'fw-bold text-success';
            } else {
                document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
                document.getElementById('smartResultTitle').textContent = 'Import Gagal';
                document.getElementById('smartResultTitle').className = 'fw-bold text-danger';
            }
            document.getElementById('smartResultMessage').textContent = res.message || '';
        })
        .catch(function(err) {
            document.getElementById('smartResultIcon').innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
            document.getElementById('smartResultTitle').textContent = 'Error';
            document.getElementById('smartResultTitle').className = 'fw-bold text-danger';
            document.getElementById('smartResultMessage').textContent = err.message;
        });
    };

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    // Reset on modal close
    var smartModal = document.getElementById('smartImportModal');
    if (smartModal) {
        smartModal.addEventListener('hidden.bs.modal', function() {
            smartImportReset();
        });
    }
})();
</script>
