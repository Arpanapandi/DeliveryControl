@model DeliveryControl.Models.DeliverySchedule

@{
    ViewData["Title"] = "Process Schedule";
}

<div class="container py-4 text-center">
    <div class="cyber-card p-5">
        <h2 class="text-primary mb-3">Processing Schedule: @Model.ScheduleNumber</h2>
        <p class="text-white">Fitur detail scanning dan validasi sedang dalam pengembangan.</p>
        <a asp-action="Index" class="btn btn-outline-light mt-3">Kembali ke List</a>
    </div>
</div>
