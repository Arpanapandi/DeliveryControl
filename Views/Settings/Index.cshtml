@model DeliveryControl.Models.ViewModels.AutoSchedulerSettingViewModel

@{
    ViewData["Title"] = "Pengaturan Sistem";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-gear"></i> Pengaturan Sistem</h2>
        <p class="text-muted">Atur jam cutoff untuk Auto Generate Schedule.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="post" class="row g-3">
            <div class="col-md-4">
                <label asp-for="CutoffTime" class="form-label"></label>
                <input asp-for="CutoffTime" class="form-control" placeholder="18:00" />
                <span asp-validation-for="CutoffTime" class="text-danger"></span>
                <small class="text-muted d-block mt-1">
                    Sebelum jam ini: sistem auto-generate untuk tanggal hari ini.<br />
                    Setelah jam ini: sistem auto-generate untuk tanggal besok (H+1).
                </small>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Simpan Pengaturan
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


