<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DataDumper\**" />
    <Content Remove="DataDumper\**" />
    <EmbeddedResource Remove="DataDumper\**" />
    <None Remove="DataDumper\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ApplyMigrationTool\**" />
    <Content Remove="ApplyMigrationTool\**" />
    <EmbeddedResource Remove="ApplyMigrationTool\**" />
    <None Remove="ApplyMigrationTool\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DeliveryControl\**" />
    <Content Remove="DeliveryControl\**" />
    <EmbeddedResource Remove="DeliveryControl\**" />
    <None Remove="DeliveryControl\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Delivery\**" />
    <Content Remove="Delivery\**" />
    <EmbeddedResource Remove="Delivery\**" />
    <None Remove="Delivery\**" />
  </ItemGroup>

  <!-- Exclude semua folder publish output yang mungkin ada di dalam project -->
  <ItemGroup>
    <Compile Remove="publish\**" />
    <Content Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

</Project>
